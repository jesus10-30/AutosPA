@inherits LayoutComponentBase
@inject NavigationManager Navegacion

<style>
    .fc-shell {
        display: flex;
        min-height: 100vh;
        background: #f7f9fc;
    }

    .fc-col {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .fc-content {
        flex: 1;
    }

    /* ---------- Barra superior ---------- */
    .fc-top {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 32px;
        color: #ffffff;
        background: #0f2a4a;
        border-bottom: 1px solid rgba(255, 255, 255, .12);
    }

    .fc-top-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .fc-top-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: #ffffff;
        color: #14406f;
        font-size: 15px;
        font-weight: 800;
    }

    .fc-top-name {
        font-size: 20px;
        font-weight: 700;
        line-height: 1.1;
    }

    .fc-top-sub {
        font-size: 11px;
        color: rgba(255, 255, 255, .7);
    }

    .fc-top-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .fc-top-login {
        color: rgba(255, 255, 255, .85);
        font-size: 14px;
        text-decoration: none;
    }

        .fc-top-login:hover {
            color: #ffffff;
            text-decoration: underline;
        }

    .fc-top-reg {
        padding: 9px 18px;
        border-radius: 9px;
        background: #1f8a5b;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s;
    }

        .fc-top-reg:hover {
            background: #27a56d;
            color: #ffffff;
        }

    .fc-top-user {
        display: flex;
        align-items: center;
        gap: 10px;
        text-align: right;
    }

    .fc-top-user-name {
        font-size: 13px;
        font-weight: 600;
    }

    .fc-top-user-role {
        font-size: 11px;
        color: rgba(255, 255, 255, .7);
    }

    .fc-top-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #ffffff;
        color: #14406f;
        font-size: 12px;
        font-weight: 700;
    }

    /* ---------- Footer ---------- */
    .fc-foot {
        background: #0f2a4a;
        color: rgba(255, 255, 255, .8);
        padding: 48px 32px 20px;
        margin-top: 64px;
    }

    .fc-foot-grid {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.5fr repeat(4, 1fr);
        gap: 32px;
    }

    .fc-foot h4 {
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        margin: 0 0 12px;
    }

    .fc-foot p,
    .fc-foot a,
    .fc-foot li {
        font-size: 13px;
        line-height: 1.7;
        color: rgba(255, 255, 255, .72);
        text-decoration: none;
    }

        .fc-foot a:hover {
            color: #ffffff;
            text-decoration: underline;
        }

    .fc-foot ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .fc-foot-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .fc-foot-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: #ffffff;
        color: #14406f;
        font-size: 12px;
        font-weight: 800;
    }

    .fc-social {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

        .fc-social a {
            padding: 5px 12px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, .25);
            font-size: 12px;
        }

    .fc-foot-bottom {
        max-width: 1100px;
        margin: 32px auto 0;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, .12);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        font-size: 12px;
        color: rgba(255, 255, 255, .55);
    }

    @@media (max-width: 1000px) {
        .fc-foot-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 800px) {
        .fc-shell {
            flex-direction: column;
        }

        .fc-top {
            padding: 12px 16px;
        }

        .fc-top-sub,
        .fc-top-login {
            display: none;
        }

        .fc-foot {
            padding: 32px 16px 16px;
        }

        .fc-foot-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ===== Cuenta / Perfil ===== */
    .account-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: #f6f8fb;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
    }

    .account-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #e6eef8;
        color: #1f5fa8;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .account-info {
        flex: 1;
    }

        .account-info h2 {
            margin: 0;
            font-size: 1.1rem;
        }

        .account-info p {
            margin: 0;
            color: #667085;
            font-size: 0.85rem;
        }

    .account-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .account-card {
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
    }

        .account-card h4 {
            margin: 0 0 0.75rem;
            font-size: 0.95rem;
        }

    .account-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #f0f2f5;
        font-size: 0.85rem;
        color: #344054;
    }

        .account-row:last-child {
            border-bottom: none;
        }

    .account-link {
        color: #1f5fa8;
        text-decoration: none;
    }

    .account-actions {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .account-danger {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid #f4c7c3;
        background: #fdf2f1;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
    }

        .account-danger h4 {
            margin: 0;
            color: #b42318;
            font-size: 0.95rem;
        }

        .account-danger p {
            margin: 0;
            color: #667085;
            font-size: 0.8rem;
        }

    /* ===== Notificaciones ===== */
    .notif-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .notif-header h2 {
            margin: 0;
            font-size: 1.15rem;
        }

        .notif-header a {
            color: #1f5fa8;
            font-size: 0.85rem;
            text-decoration: none;
        }

    .notif-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .notif-tab {
        border: 1px solid #e4e7ec;
        background: #ffffff;
        color: #667085;
        font-size: 0.8rem;
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        cursor: pointer;
    }

        .notif-tab.active {
            background: #e6eef8;
            border-color: #e6eef8;
            color: #1f5fa8;
        }

    .notif-item {
        display: flex;
        gap: 0.9rem;
        background: #f6f8fb;
        border-left: 3px solid #1f5fa8;
        border-radius: 10px;
        padding: 0.9rem 1.1rem;
        margin-bottom: 0.7rem;
    }

        .notif-item.muted {
            opacity: 0.6;
            border-left-color: #cbd5e1;
        }

        .notif-item .icon {
            color: #1f5fa8;
            font-size: 1.3rem;
        }

        .notif-item .title {
            margin: 0;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .notif-item .desc {
            margin: 0;
            font-size: 0.8rem;
            color: #667085;
        }

        .notif-item .time {
            margin-left: auto;
            font-size: 0.75rem;
            color: #98a2b3;
            white-space: nowrap;
        }

    /* ===== Mis vehículos ===== */
    .vehicles-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .vehicles-header h2 {
            margin: 0;
            font-size: 1.15rem;
        }

    .vehicle-card {
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-bottom: 0.9rem;
    }

    .vehicle-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .vehicle-left {
        display: flex;
        gap: 0.8rem;
    }

    .vehicle-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #e6eef8;
        color: #1f5fa8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .vehicle-name {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .vehicle-sub {
        margin: 0;
        font-size: 0.8rem;
        color: #667085;
    }

    .badge-ok {
        background: #e1f5ee;
        color: #085041;
        font-size: 0.75rem;
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
    }

    .badge-warn {
        background: #faeeda;
        color: #633806;
        font-size: 0.75rem;
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
    }

    .vehicle-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.8rem;
        padding-top: 0.7rem;
        border-top: 1px solid #f0f2f5;
        font-size: 0.8rem;
        color: #667085;
    }
</style>

<div class="fc-shell">
    <NavMenu />

    <div class="fc-col">
        <header class="fc-top">
            <div class="fc-top-brand">
                <span class="fc-top-mark">FC</span>
                <div>
                    <div class="fc-top-name">FlexiCar</div>
                    <div class="fc-top-sub">Taller mecánico · Guatemala</div>
                </div>
            </div>

            <div class="fc-top-right">
                @if (EsSeccionAgente)
                {
                    <div class="fc-top-user">
                        <div>
                            <div class="fc-top-user-name">Carlos Ruiz</div>
                            <div class="fc-top-user-role">Agente</div>
                        </div>
                        <div class="fc-top-avatar">CR</div>
                    </div>
                }
                else if (!estaRegistrado)
                {
                    <a class="fc-top-login" href="login">Iniciar sesión</a>
                    <a class="fc-top-reg" href="registro">Regístrate</a>
                }
                else
                {
                    <div class="fc-top-user">
                        <div>
                            <div class="fc-top-user-name">@nombreUsuario</div>
                            <div class="fc-top-user-role">@rolUsuario</div>
                        </div>
                        <div class="fc-top-avatar">@iniciales</div>
                    </div>
                }
            </div>
        </header>

        <main class="fc-content">
            @Body
        </main>

        @if (!EsSeccionAgente)
        {
            <footer class="fc-foot">
                <div class="fc-foot-grid">
                    <div>
                        <div class="fc-foot-brand"><span class="fc-foot-mark">FC</span>FlexiCar</div>
                        <p>Mantenimiento, diagnóstico y reparación de vehículos, con citas programadas y seguimiento en línea.</p>
                        <div class="fc-social">
                            <a href="#">Facebook</a>
                            <a href="#">Instagram</a>
                            <a href="#">WhatsApp</a>
                        </div>
                    </div>

                    <div>
                        <h4>Sobre nosotros</h4>
                        <ul>
                            <li><a href="#">Quiénes somos</a></li>
                            <li><a href="#">Garantías</a></li>
                            <li><a href="#">Nuestros talleres</a></li>
                        </ul>
                    </div>

                    <div>
                        <h4>Contáctanos</h4>
                        <ul>
                            <li>Tel: 0000-0000</li>
                            <li>contacto@@flexicar.com</li>
                            <li>Redes sociales</li>
                        </ul>
                    </div>

                    <div>
                        <h4>Encuéntranos</h4>
                        <ul>
                            <li>Dirección del taller</li>
                            <li>Ciudad, Guatemala</li>
                            <li><a href="#">Ver en el mapa</a></li>
                        </ul>
                    </div>

                    <div>
                        <h4>Atención y pagos</h4>
                        <ul>
                            <li>Lun–Vie: 7:30 – 17:30</li>
                            <li>Sáb: 8:00 – 13:00</li>
                            <li>Efectivo, tarjeta y transferencia</li>
                        </ul>
                    </div>
                </div>

                <div class="fc-foot-bottom">
                    <span>© 2026 FlexiCar. Proyecto académico — UMG.</span>
                    <span>Guatemala</span>
                </div>
            </footer>
        }
    </div>
</div>

@code {
    // Cambia a true para ver el usuario logueado en lugar de "Regístrate"
    private bool estaRegistrado = false;

    private string nombreUsuario = "Est. Jiménez";
    private string rolUsuario = "Cliente";
    private string iniciales = "EJ";

    private bool EsSeccionAgente => Navegacion.Uri.ToLower().Contains("agente");
}