@inherits LayoutComponentBase

<style>
    /* ---------- Estructura: panel de marca + formulario ---------- */
    .au-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: minmax(340px, 5fr) 6fr;
        background: #f7f9fc;
    }

    .au-brand {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 32px;
        padding: 44px 52px;
        color: #ffffff;
        background: linear-gradient(160deg, #0f2a4a 0%, #14406f 55%, #1a6b6b 125%);
        overflow: hidden;
    }

        .au-brand::before,
        .au-brand::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, .05);
            pointer-events: none;
        }

        .au-brand::before {
            width: 420px;
            height: 420px;
            top: -140px;
            right: -160px;
        }

        .au-brand::after {
            width: 300px;
            height: 300px;
            bottom: -120px;
            left: -100px;
        }

        .au-brand > * {
            position: relative;
            z-index: 1;
        }

    .au-logo {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 20px;
        font-weight: 700;
        color: #ffffff;
        text-decoration: none;
    }

    .au-logo-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: #ffffff;
        color: #14406f;
        font-size: 15px;
        font-weight: 800;
    }

    .au-brand h2 {
        margin: 0 0 14px;
        font-size: clamp(26px, 3vw, 36px);
        line-height: 1.2;
        font-weight: 700;
        color: #ffffff;
    }

    .au-brand p {
        margin: 0;
        max-width: 420px;
        font-size: 15px;
        line-height: 1.65;
        color: rgba(255, 255, 255, .8);
    }

    .au-points {
        list-style: none;
        margin: 28px 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

        .au-points li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 14px;
            line-height: 1.5;
            color: rgba(255, 255, 255, .9);
        }

        .au-points svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
            margin-top: 1px;
            fill: none;
            stroke: #6ee7b7;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .au-car {
        display: block;
        width: 100%;
        max-width: 320px;
        margin-top: 8px;
        opacity: .92;
    }

    .au-foot {
        font-size: 12px;
        color: rgba(255, 255, 255, .6);
    }

    .au-main {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 28px;
    }

    .au-card {
        width: 100%;
        max-width: 420px;
    }

        .au-card.wide {
            max-width: 520px;
        }

    .au-back {
        display: inline-block;
        margin-bottom: 22px;
        font-size: 13px;
        font-weight: 600;
        color: #6b7a90;
        text-decoration: none;
    }

        .au-back:hover {
            color: #14406f;
        }

    .au-head h1 {
        margin: 0 0 8px;
        font-size: 30px;
        font-weight: 700;
        color: #0f2a4a;
    }

    .au-head p {
        margin: 0 0 24px;
        font-size: 14px;
        line-height: 1.6;
        color: #6b7a90;
    }

    /* ---------- Formulario ---------- */
    .au-field {
        margin-bottom: 16px;
    }

    .au-label {
        display: block;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #344054;
    }

        .au-label small {
            font-weight: 400;
            color: #8492a6;
        }

    .au-input-wrap {
        position: relative;
    }

    .au-input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #d0d9e6;
        border-radius: 10px;
        background: #ffffff;
        font-family: inherit;
        font-size: 14px;
        color: #0f172a;
        transition: border-color .15s, box-shadow .15s;
    }

        .au-input:focus {
            outline: none;
            border-color: #1f5fa8;
            box-shadow: 0 0 0 3px rgba(31, 95, 168, .15);
        }

        .au-input.invalid {
            border-color: #d92d20;
            box-shadow: 0 0 0 3px rgba(217, 45, 32, .08);
        }

        .au-input.has-eye {
            padding-right: 48px;
        }

    .au-eye {
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        padding: 8px;
        border: 0;
        background: none;
        color: #6b7a90;
        cursor: pointer;
    }

        .au-eye svg {
            display: block;
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .au-err {
        display: block;
        margin-top: 6px;
        font-size: 12px;
        color: #b42318;
    }

    .au-grid2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 14px;
    }

    .au-phone {
        display: flex;
    }

        .au-phone span {
            display: flex;
            align-items: center;
            padding: 0 12px;
            border: 1px solid #d0d9e6;
            border-right: 0;
            border-radius: 10px 0 0 10px;
            background: #f2f6fb;
            font-size: 14px;
            color: #475467;
        }

        .au-phone .au-input {
            border-radius: 0 10px 10px 0;
        }

    .au-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin: 4px 0 20px;
    }

    .au-check {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 13px;
        line-height: 1.5;
        color: #475467;
        cursor: pointer;
    }

        .au-check input {
            width: 17px;
            height: 17px;
            margin-top: 2px;
            accent-color: #14406f;
            flex-shrink: 0;
        }

    .au-link {
        padding: 0;
        border: 0;
        background: none;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #1a56a0;
        text-decoration: none;
        cursor: pointer;
    }

        .au-link:hover {
            text-decoration: underline;
        }

    .au-btn {
        display: block;
        width: 100%;
        padding: 13px 18px;
        border: 1px solid transparent;
        border-radius: 10px;
        background: linear-gradient(90deg, #14406f, #1f5fa8);
        font-family: inherit;
        font-size: 15px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        color: #ffffff;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

        .au-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(20, 64, 111, .28);
        }

        .au-btn:disabled {
            opacity: .65;
            cursor: wait;
        }

    .au-btn-plain {
        background: #ffffff;
        border-color: #c4d2e4;
        color: #14406f;
    }

        .au-btn-plain:hover:not(:disabled) {
            box-shadow: 0 6px 16px rgba(0, 0, 0, .1);
        }

    .au-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0;
        font-size: 12px;
        color: #8492a6;
    }

        .au-divider::before, .au-divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e1e7f0;
        }

    .au-alert {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #fdecea;
        color: #b42318;
        font-size: 13px;
    }

    .au-note {
        margin-top: 14px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #f2f6fb;
        font-size: 12px;
        line-height: 1.55;
        color: #4a5a70;
    }

    .au-legal {
        margin-top: 22px;
        font-size: 12px;
        line-height: 1.6;
        text-align: center;
        color: #8492a6;
    }

    .au-spin {
        display: inline-block;
        width: 14px;
        height: 14px;
        margin-right: 8px;
        border: 2px solid rgba(255, 255, 255, .4);
        border-top-color: #ffffff;
        border-radius: 50%;
        vertical-align: -2px;
        animation: au-rot .7s linear infinite;
    }

    @@keyframes au-rot {
        to {
            transform: rotate(360deg);
        }
    }

    /* Selector Cliente / Agente */
    .au-roles {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        padding: 5px;
        margin-bottom: 22px;
        border-radius: 12px;
        background: #eaf0f8;
    }

    .au-role {
        padding: 10px;
        border: 0;
        border-radius: 9px;
        background: transparent;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #6b7a90;
        cursor: pointer;
    }

        .au-role.active {
            background: #ffffff;
            color: #14406f;
            box-shadow: 0 2px 8px rgba(15, 42, 74, .12);
        }

    /* Ventana */
    .au-modal-bg {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(10, 30, 60, .55);
    }

    .au-modal {
        width: 100%;
        max-width: 420px;
        padding: 28px;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
    }

        .au-modal h3 {
            margin: 0 0 6px;
            font-size: 20px;
            color: #0f2a4a;
        }

        .au-modal > p {
            margin: 0 0 16px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b7a90;
        }

    .au-modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
    }

    @@media (max-width: 900px) {
        .au-shell {
            grid-template-columns: 1fr;
        }

        .au-brand {
            padding: 22px 22px 24px;
            gap: 14px;
        }

            .au-brand p, .au-points, .au-car, .au-foot {
                display: none;
            }

            .au-brand h2 {
                margin-bottom: 0;
                font-size: 22px;
            }

        .au-main {
            align-items: flex-start;
            padding: 28px 18px 40px;
        }
    }

    @@media (max-width: 520px) {
        .au-grid2 {
            grid-template-columns: 1fr;
        }
    }
</style>

@Body
