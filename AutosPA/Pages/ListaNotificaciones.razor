@page "/notificaciones"
@using System.Globalization
@using AutosPALibrary.DTOs
@using System.Net.Http.Json
@using AutosPA.Services
@inject HttpClient Http
@inject NotificacionesBadgeService BadgeService

<PageTitle>FlexiCar — Notificaciones</PageTitle>

<style>
    .nt-page {
        max-width: 860px;
        margin: 0 auto;
        padding: 40px 28px 0;
    }

    .nt-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

    .nt-eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #1f8a5b;
        margin-bottom: 8px;
    }

    .nt-head h1 {
        margin: 0 0 6px;
        font-size: clamp(30px, 4vw, 40px);
        font-weight: 700;
        color: #0f2a4a;
    }

    .nt-head p {
        margin: 0;
        font-size: 15px;
        color: #6b7a90;
    }

    .nt-markall {
        padding: 0;
        border: 0;
        background: none;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        color: #1a56a0;
        cursor: pointer;
    }

        .nt-markall:hover:not(:disabled) {
            text-decoration: underline;
        }

        .nt-markall:disabled {
            color: #aab4c3;
            cursor: default;
        }

    .nt-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 18px;
    }

    .nt-tab {
        padding: 8px 16px;
        border: 1px solid #dbe3ee;
        border-radius: 999px;
        background: #ffffff;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #4a5a70;
        cursor: pointer;
        transition: background .15s, color .15s;
    }

        .nt-tab:hover {
            background: #eef3fa;
        }

        .nt-tab.active {
            background: #14406f;
            border-color: #14406f;
            color: #ffffff;
        }

        .nt-tab span {
            margin-left: 6px;
            opacity: .8;
        }

    /* Tarjeta de aviso */
    .nt-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 12px;
        padding: 16px 18px;
        border: 1px solid #e6ebf2;
        border-left-width: 4px;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(15, 42, 74, .05);
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

        .nt-item:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(15, 42, 74, .1);
        }

        .nt-item.unread {
            background: #f4f8fd;
        }

        .nt-item.cita {
            border-left-color: #1a56a0;
        }

        .nt-item.servicio {
            border-left-color: #1f8a5b;
        }

        .nt-item.recordatorio {
            border-left-color: #d98e04;
        }

        .nt-item.promocion {
            border-left-color: #9aa7ba;
        }

    .nt-ico {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 11px;
    }

        .nt-ico svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .cita .nt-ico {
        background: #e6effa;
        color: #1a56a0;
    }

    .servicio .nt-ico {
        background: #e3f5ec;
        color: #146c43;
    }

    .recordatorio .nt-ico {
        background: #fdf1dc;
        color: #9a6200;
    }

    .promocion .nt-ico {
        background: #eceff4;
        color: #5b6778;
    }

    .nt-body {
        flex: 1;
        min-width: 0;
    }

        .nt-body h4 {
            margin: 0 0 4px;
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
        }

    .nt-item.unread .nt-body h4 {
        font-weight: 700;
    }

    .nt-body p {
        margin: 0;
        font-size: 13px;
        line-height: 1.55;
        color: #5b6778;
    }

    .nt-item.read .nt-body p {
        color: #8492a6;
    }

    .nt-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
        flex-shrink: 0;
        font-size: 12px;
        color: #8492a6;
    }

    .nt-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #1f8a5b;
    }

    .nt-del {
        padding: 0 4px;
        border: 0;
        background: none;
        font-size: 18px;
        line-height: 1;
        color: #b7c0cf;
        cursor: pointer;
    }

        .nt-del:hover {
            color: #b42318;
        }

    .nt-empty {
        padding: 40px 20px;
        border: 1px dashed #c4d2e4;
        border-radius: 16px;
        text-align: center;
        font-size: 14px;
        color: #6b7a90;
    }

    @@media (max-width: 600px) {
        .nt-page {
            padding: 28px 14px 0;
        }
    }
</style>

<div class="nt-page">

    <header class="nt-head">
        <div>
            <div class="nt-eyebrow">Centro de avisos</div>
            <h1>Notificaciones</h1>
            <p>Confirmaciones de cita, servicios finalizados, recordatorios y promociones.</p>
        </div>
        <button type="button" class="nt-markall" disabled="@(NoLeidas == 0)" @onclick="MarcarTodas">Marcar todas como leídas</button>
    </header>

    <div class="nt-tabs">
        <button type="button" class="nt-tab @(filtro == "todas" ? "active" : "")" @onclick='() => filtro = "todas"'>Todas<span>@notificaciones.Count</span></button>
        <button type="button" class="nt-tab @(filtro == "noleidas" ? "active" : "")" @onclick='() => filtro = "noleidas"'>No leídas<span>@NoLeidas</span></button>
        <button type="button" class="nt-tab @(filtro == "citas" ? "active" : "")" @onclick='() => filtro = "citas"'>Citas</button>
        <button type="button" class="nt-tab @(filtro == "servicios" ? "active" : "")" @onclick='() => filtro = "servicios"'>Servicios</button>
        <button type="button" class="nt-tab @(filtro == "promociones" ? "active" : "")" @onclick='() => filtro = "promociones"'>Promociones</button>
    </div>
    
    @if (!string.IsNullOrEmpty(ErrorAccion))
{
    <p class="text-danger text-center">@ErrorAccion</p>
}

@if (Cargando)
{
    <p class="text-center">Cargando notificaciones...</p>
}
else if (!string.IsNullOrEmpty(ErrorCarga))
{
    <p class="text-center">@ErrorCarga</p>
}
else if (!Filtradas.Any())
{
    <p class="text-center">No hay notificaciones para mostrar.</p>
}


    @foreach (var n in Filtradas)
    {
        <article class="nt-item @n.Tipo @(n.Leida ? "read" : "unread")" @onclick="() => Leer(n)">
            <div class="nt-ico">
                <svg viewBox="0 0 24 24">
                    @switch (n.Tipo)
                    {
                        case "cita":
                            <rect x="3" y="5" width="18" height="16" rx="2" />
                            <path d="M16 3v4M8 3v4M3 11h18" />
                            break;
                        case "servicio":
                            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z" />
                            break;
                        case "recordatorio":
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3 3" />
                            break;
                        default:
                            <path d="M20 12l-8 8-9-9V3h8z" />
                            <circle cx="7.5" cy="7.5" r="1.3" />
                            break;
                    }
                </svg>
            </div>

            <div class="nt-body">
                <h4>@n.Titulo</h4>
                <p>@n.Mensaje</p>
            </div>

            <div class="nt-meta">
                <span>@n.Hace</span>
                @if (!n.Leida)
                {
                    <span class="nt-dot" title="No leída"></span>
                }
                <button type="button" class="nt-del" title="Eliminar" @onclick="() => Eliminar(n)" @onclick:stopPropagation="true">×</button>
            </div>
        </article>
    }

    @if (!Filtradas.Any())
    {
        <div class="nt-empty">No tienes notificaciones en esta sección.</div>
    }
</div>



@code {
    private class Notif
    {
        public long Id { get; set; }
        public string Tipo { get; set; } = "servicio";
        public string Titulo { get; set; } = "";
        public string Mensaje { get; set; } = "";
        public DateTime FechaCreacion { get; set; } = DateTime.Now;
        public string Hace => ObtenerTiempoRelativo(FechaCreacion);
        public bool Leida { get; set; }
    }

    private static string ObtenerTiempoRelativo(DateTime fecha)
    {
        var diferencia = DateTime.UtcNow - fecha.ToUniversalTime();

        if (diferencia.TotalMinutes < 1)
            return "Ahora mismo";

        if (diferencia.TotalMinutes < 60)
            return $"Hace {(int)diferencia.TotalMinutes} min";

        if (diferencia.TotalHours < 24)
            return $"Hace {(int)diferencia.TotalHours} h";

        if (diferencia.TotalDays < 2)
            return "Ayer";

        if (diferencia.TotalDays < 7)
            return $"Hace {(int)diferencia.TotalDays} días";

        return fecha.ToLocalTime().ToString(
            "dd/MM/yyyy",
            CultureInfo.GetCultureInfo("es-GT"));
    }

    private List<Notif> notificaciones = new();

    private string filtro = "todas";
    private bool Cargando = true;
    private bool ProcesandoAccion = false;
    private string? ErrorCarga;
    private string? ErrorAccion;

    private int NoLeidas => notificaciones.Count(n => !n.Leida);

    private IEnumerable<Notif> Filtradas => filtro switch
    {
        "noleidas" => notificaciones.Where(n => !n.Leida),
        "citas" => notificaciones.Where(
            n => n.Tipo == "cita" || n.Tipo == "recordatorio"),
        "servicios" => notificaciones.Where(n => n.Tipo == "servicio"),
        "promociones" => notificaciones.Where(n => n.Tipo == "promocion"),
        _ => notificaciones
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarNotificaciones();
    }

    private async Task CargarNotificaciones()
    {
        Cargando = true;
        ErrorCarga = null;

        try
        {
            var datos = await Http.GetFromJsonAsync<List<NotificacionDTO>>(
                "api/Notificaciones");

            notificaciones = (datos ?? new List<NotificacionDTO>())
                .Select(n => new Notif
                {
                    Id = n.Id,
                    Tipo = n.Tipo,
                    Titulo = n.Titulo,
                    Mensaje = n.Mensaje,
                    FechaCreacion = n.CreatedAt,
                    Leida = n.Leida
                })
                .ToList();
        }
        catch (HttpRequestException ex)
        {
            ErrorCarga =
                ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "Debes iniciar sesión para consultar tus notificaciones."
                    : "No se pudieron cargar las notificaciones. Verifica que el backend esté funcionando.";
        }
        catch (System.Text.Json.JsonException)
        {
            ErrorCarga =
                "La respuesta del servidor no tiene el formato esperado.";
        }
        finally
{
    Cargando = false;
    BadgeService.Actualizar(NoLeidas);
}
    }

    private async Task Leer(Notif n)
    {
        if (n.Leida || ProcesandoAccion)
            return;

        ProcesandoAccion = true;
        ErrorAccion = null;

        try
        {
            var respuesta = await Http.PutAsync(
                $"api/Notificaciones/{n.Id}/leer", null);

            if (!respuesta.IsSuccessStatusCode)
            {
                ErrorAccion = "No se pudo marcar la notificación como leída.";
                return;
            }

            await CargarNotificaciones();
        }
        catch (HttpRequestException)
        {
            ErrorAccion = "No se pudo conectar con el servidor.";
        }
        finally
        {
            ProcesandoAccion = false;
        }
    }

    private async Task MarcarTodas()
    {
        if (NoLeidas == 0 || ProcesandoAccion)
            return;

        ProcesandoAccion = true;
        ErrorAccion = null;

        try
        {
            var respuesta = await Http.PutAsync(
                "api/Notificaciones/leer-todas", null);

            if (!respuesta.IsSuccessStatusCode)
            {
                ErrorAccion = "No se pudieron marcar todas como leídas.";
                return;
            }

            await CargarNotificaciones();
        }
        catch (HttpRequestException)
        {
            ErrorAccion = "No se pudo conectar con el servidor.";
        }
        finally
        {
            ProcesandoAccion = false;
        }
    }

    private async Task Eliminar(Notif n)
    {
        if (ProcesandoAccion)
            return;

        ProcesandoAccion = true;
        ErrorAccion = null;

        try
        {
            var respuesta = await Http.DeleteAsync(
                $"api/Notificaciones/{n.Id}");

            if (!respuesta.IsSuccessStatusCode)
            {
                ErrorAccion = "No se pudo eliminar la notificación.";
                return;
            }

            await CargarNotificaciones();
        }
        catch (HttpRequestException)
        {
            ErrorAccion = "No se pudo conectar con el servidor.";
        }
        finally
        {
            ProcesandoAccion = false;
        }
    }
}

