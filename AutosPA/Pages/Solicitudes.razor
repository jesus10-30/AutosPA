@page "/agente/solicitudes"
@using System.Globalization
@using System.Net
@using System.Text.Json
@using AutosPALibrary.DTOs
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>FlexiCar — Solicitudes</PageTitle>

<style>
    .sl-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 36px 28px 0;
    }

    .sl-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .sl-eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #1f8a5b;
        margin-bottom: 8px;
    }

    .sl-head h1 {
        margin: 0 0 6px;
        font-size: clamp(30px, 4vw, 40px);
        font-weight: 700;
        color: #0f2a4a;
    }

    .sl-head p {
        margin: 0;
        max-width: 560px;
        font-size: 15px;
        line-height: 1.6;
        color: #6b7a90;
    }

    .sl-count {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 20px;
        border-radius: 14px;
        background: #fff7e6;
        border: 1px solid #f3dca8;
        color: #7a5200;
        font-size: 13px;
    }

        .sl-count b {
            font-size: 26px;
            line-height: 1;
            color: #b86e00;
        }

        .sl-count.zero {
            background: #e3f5ec;
            border-color: #bfe5d1;
            color: #146c43;
        }

            .sl-count.zero b {
                color: #146c43;
            }

    /* Filtros */
    .sl-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .sl-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .sl-tab {
        padding: 8px 16px;
        border: 1px solid #dbe3ee;
        border-radius: 999px;
        background: #ffffff;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #4a5a70;
        cursor: pointer;
    }

        .sl-tab:hover {
            background: #eef3fa;
        }

        .sl-tab.active {
            background: #14406f;
            border-color: #14406f;
            color: #ffffff;
        }

        .sl-tab span {
            margin-left: 6px;
            opacity: .8;
        }

    .sl-search {
        width: 270px;
        padding: 10px 14px;
        border: 1px solid #dbe3ee;
        border-radius: 10px;
        background: #ffffff;
        font-family: inherit;
        font-size: 13px;
        color: #0f172a;
    }

        .sl-search:focus {
            outline: 2px solid #1f5fa8;
        }

    /* Tarjeta */
    .sl-card {
        display: grid;
        grid-template-columns: 78px 1fr auto;
        gap: 20px;
        align-items: center;
        margin-bottom: 16px;
        padding: 20px 22px;
        background: #ffffff;
        border: 1px solid #e6ebf2;
        border-left-width: 4px;
        border-radius: 18px;
        box-shadow: 0 2px 10px rgba(15, 42, 74, .05);
    }

        .sl-card.pend {
            border-left-color: #e0a100;
        }

        .sl-card.acep {
            border-left-color: #1f8a5b;
        }

        .sl-card.rech {
            border-left-color: #b42318;
            background: #fcfcfd;
        }

    .sl-date {
        padding: 10px 0;
        border-radius: 14px;
        background: linear-gradient(180deg, #eef4fb, #e3edf8);
        text-align: center;
    }

        .sl-date small {
            display: block;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #6b7a90;
        }

        .sl-date b {
            display: block;
            font-size: 28px;
            line-height: 1.1;
            color: #14406f;
        }

        .sl-date span {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: #6b7a90;
        }

    .sl-top {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

        .sl-top h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            color: #0f2a4a;
        }

    .sl-status {
        padding: 3px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }

        .sl-status.pend {
            background: #fdf1dc;
            color: #9a6200;
        }

        .sl-status.acep {
            background: #e3f5ec;
            color: #146c43;
        }

        .sl-status.rech {
            background: #fdecea;
            color: #b42318;
        }

    .sl-when {
        margin-left: auto;
        font-size: 13px;
        font-weight: 600;
        color: #14406f;
    }

    .sl-client {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .sl-av {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 50%;
        background: linear-gradient(135deg, #14406f, #1f8a5b);
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
    }

    .sl-client b {
        display: block;
        font-size: 14px;
        color: #0f172a;
    }

    .sl-client small {
        font-size: 12px;
        color: #6b7a90;
    }

    .sl-ago {
        margin-left: auto;
        font-size: 12px;
        color: #8492a6;
        white-space: nowrap;
    }

    .sl-facts {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .sl-fact {
        padding: 5px 12px;
        border-radius: 8px;
        background: #f2f6fb;
        font-size: 12px;
        color: #4a5a70;
    }

        .sl-fact b {
            color: #0f2a4a;
        }

    .sl-doc {
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
    }

        .sl-doc.verde {
            background: #e3f5ec;
            color: #146c43;
        }

        .sl-doc.ambar {
            background: #fdf1dc;
            color: #9a6200;
        }

        .sl-doc.rojo {
            background: #fdecea;
            color: #b42318;
        }

        .sl-doc.neutro {
            background: #eceff4;
            color: #5b6778;
        }

    .sl-note {
        margin-top: 12px;
        padding: 10px 14px;
        border-radius: 10px;
        background: #f7f9fc;
        font-size: 13px;
        font-style: italic;
        line-height: 1.5;
        color: #4a5a70;
    }

    .sl-warn {
        margin-top: 12px;
        padding: 10px 14px;
        border-radius: 10px;
        background: #fdecea;
        font-size: 12px;
        font-weight: 600;
        color: #b42318;
    }

    .sl-motivo {
        margin-top: 12px;
        font-size: 12px;
        color: #8a4a44;
    }

    /* Acciones */
    .sl-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 130px;
    }

    .sl-btn {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

        .sl-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, .15);
        }

        .sl-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    .sl-btn-green {
        background: #1f8a5b;
        color: #ffffff;
    }

    .sl-btn-danger {
        background: #ffffff;
        border-color: #e3a59d;
        color: #b42318;
    }

    .sl-btn-plain {
        background: #ffffff;
        border-color: #c4d2e4;
        color: #14406f;
    }

    .sl-btn-solid {
        background: #14406f;
        color: #ffffff;
    }

    .sl-empty {
        padding: 48px 20px;
        border: 1px dashed #c4d2e4;
        border-radius: 18px;
        text-align: center;
        font-size: 14px;
        color: #6b7a90;
        background: #ffffff;
    }

    .sl-error {
        margin-bottom: 16px;
        padding: 14px 18px;
        border: 1px solid #f0b9b4;
        border-radius: 12px;
        background: #fdecea;
        color: #9f2018;
        font-size: 13px;
    }

    .sl-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 200px;
        color: #6b7a90;
        font-size: 14px;
    }

    .sl-loading-spinner {
        width: 22px;
        height: 22px;
        border: 3px solid #e6ebf2;
        border-top-color: #1f8a5b;
        border-radius: 50%;
        animation: sl-spin .8s linear infinite;
    }

    @@keyframes sl-spin {
        to { transform: rotate(360deg); }
    }

    /* Ventana */
    .sl-modal-bg {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(10, 30, 60, .55);
    }

    .sl-modal {
        width: 100%;
        max-width: 460px;
        padding: 28px;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
    }

        .sl-modal h3 {
            margin: 0 0 6px;
            font-size: 20px;
            color: #0f2a4a;
        }

        .sl-modal > p {
            margin: 0 0 16px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b7a90;
        }

    .sl-label {
        display: block;
        margin: 12px 0 6px;
        font-size: 12px;
        font-weight: 600;
        color: #4a5a70;
    }

    .sl-input {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid #dbe3ee;
        border-radius: 10px;
        background: #f7f9fc;
        font-family: inherit;
        font-size: 14px;
        color: #0f172a;
    }

        .sl-input:focus {
            outline: 2px solid #1f5fa8;
            background: #ffffff;
        }

    textarea.sl-input {
        min-height: 80px;
        resize: vertical;
    }

    .sl-modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .sl-toast {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 300;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 20px;
        border-radius: 12px;
        background: #14406f;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
    }

        .sl-toast button {
            padding: 0;
            border: 0;
            background: none;
            font-family: inherit;
            font-size: 13px;
            font-weight: 700;
            color: #8ecbff;
            cursor: pointer;
            text-decoration: underline;
        }

    @@media (max-width: 800px) {
        .sl-page {
            padding: 28px 14px 0;
        }

        .sl-search {
            width: 100%;
        }

        .sl-card {
            grid-template-columns: 64px 1fr;
        }

        .sl-actions {
            grid-column: 1 / -1;
            flex-direction: row;
        }

            .sl-actions .sl-btn {
                flex: 1;
            }
    }
</style>

<div class="sl-page">

    <header class="sl-head">
        <div>
            <div class="sl-eyebrow">Panel del agente</div>
            <h1>Solicitudes</h1>
            <p>Revisa las citas que los clientes pidieron contigo. Al aceptar, pasan a tu agenda y su estado queda actualizado.</p>
        </div>
        <div class="sl-count @(Cuenta("Pendiente") == 0 ? "zero" : "")">
            <b>@Cuenta("Pendiente")</b>
            <span>@(Cuenta("Pendiente") == 0 ? "Todo al día" : "por responder")</span>
        </div>
    </header>

    @if (cargandoInicial)
    {
        <div class="sl-loading" role="status" aria-live="polite">
            <span class="sl-loading-spinner" aria-hidden="true"></span>
            <span>Cargando solicitudes y agenda...</span>
        </div>
    }
    else
    {
    <div class="sl-toolbar">
        <div class="sl-tabs">
            <button type="button" class="sl-tab @(filtro == "Pendiente" ? "active" : "")" @onclick='() => filtro = "Pendiente"'>Pendientes<span>@Cuenta("Pendiente")</span></button>
            <button type="button" class="sl-tab @(filtro == "Aceptada" ? "active" : "")" @onclick='() => filtro = "Aceptada"'>Aceptadas<span>@Cuenta("Aceptada")</span></button>
            <button type="button" class="sl-tab @(filtro == "Rechazada" ? "active" : "")" @onclick='() => filtro = "Rechazada"'>Rechazadas<span>@Cuenta("Rechazada")</span></button>
            <button type="button" class="sl-tab @(filtro == "Todas" ? "active" : "")" @onclick='() => filtro = "Todas"'>Todas<span>@solicitudes.Count</span></button>
        </div>
        <input class="sl-search" placeholder="Buscar cliente, placa o servicio" @bind="busqueda" @bind:event="oninput" />
    </div>

    @if (!string.IsNullOrWhiteSpace(errorSolicitudes))
    {
        <div class="sl-error">
            @errorSolicitudes
            @if (solicitudesCargadas)
            {
                <span> Los datos visibles corresponden a la última carga correcta y podrían estar desactualizados.</span>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorTrabajos))
    {
        <div class="sl-error">
            @errorTrabajos
            @if (trabajosCargados)
            {
                <span> Los trabajos visibles corresponden a la última carga correcta y podrían estar desactualizados.</span>
            }
        </div>
    }

    @foreach (var s in Filtradas.ToList())
    {
        var trabajoEnConflicto = s.Estado == "Pendiente" ? TrabajoEnConflicto(s) : null;
        var choque = trabajoEnConflicto is null
            ? null
            : $"{trabajoEnConflicto.Vehiculo} · {trabajoEnConflicto.Cliente}";
        var clase = ClaseEstado(s.Estado);

        <article class="sl-card @clase">
            <div class="sl-date">
                <small>@DiasCortos[(int)s.FechaCita.DayOfWeek]</small>
                <b>@s.FechaCita.Day</b>
                <span>@Meses[s.FechaCita.Month - 1]</span>
            </div>

            <div class="sl-main">
                <div class="sl-top">
                    <h3>@s.Servicio</h3>
                    <span class="sl-status @clase">@s.Estado</span>
                    <span class="sl-when">@Cuando(s.FechaCita) · @FormatoHora(s.HoraInicio)</span>
                </div>

                <div class="sl-client">
                    <span class="sl-av">@Iniciales(s.Cliente)</span>
                    <div>
                        <b>@s.Cliente</b>
                        <small>@s.Vehiculo · Placa @s.Placa</small>
                    </div>
                    <span class="sl-ago">@Hace(s.FechaCreacion)</span>
                </div>

                <div class="sl-facts">
                    <span class="sl-fact">Costo: <b>@Quetzales(s.Costo)</b></span>
                    <span class="sl-fact">Tiempo: <b>@Tiempo(s.TiempoEstimadoMinutos)</b></span>
                    @foreach (var d in s.Documentos)
                    {
                        <span class="sl-doc @ClaseDocumento(d)">@TextoDocumento(d)</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(s.Observaciones))
                {
                    <div class="sl-note">“@s.Observaciones”</div>
                }

                @if (choque is not null)
                {
                    <div class="sl-warn">Choque de horario: ya tienes @choque a esa hora.</div>
                }

                @if (TieneDuracionInvalida(s))
                {
                    <div class="sl-warn">No se puede validar la agenda porque la solicitud o un trabajo existente tiene una duración inválida.</div>
                }

                @if (s.Estado == "Rechazada" && !string.IsNullOrWhiteSpace(s.MotivoRechazo))
                {
                    <div class="sl-motivo">Motivo registrado: @s.MotivoRechazo</div>
                }
            </div>

            <div class="sl-actions">
                @if (s.Estado == "Pendiente")
                {
                    <button type="button" class="sl-btn sl-btn-green" disabled="@(choque is not null || TieneDuracionInvalida(s) || errorTrabajos is not null)" title="@(errorTrabajos is not null ? "No se pudo verificar la agenda; recarga antes de aceptar" : TieneDuracionInvalida(s) ? "No se puede aceptar mientras exista una duración inválida" : choque is not null ? "Resuelve el choque de horario antes de aceptar" : "")" @onclick="() => Aceptar(s)">Aceptar</button>
                    <button type="button" class="sl-btn sl-btn-danger" @onclick="() => AbrirRechazo(s, choque is not null)">Rechazar</button>
                }
                else if (s.Estado == "Aceptada")
                {
                    <a class="sl-btn sl-btn-plain" href="panel-agente">Ver en agenda</a>
                }
            </div>
        </article>
    }

    @if (!Filtradas.Any() && string.IsNullOrWhiteSpace(errorSolicitudes))
    {
        <div class="sl-empty">
            @(filtro == "Pendiente" ? "No tienes solicitudes pendientes. Vuelve más tarde para revisar nuevas solicitudes." : "No hay solicitudes en esta sección.")
        </div>
    }
    }
</div>

@if (rechazando is not null)
{
    <div class="sl-modal-bg" @onclick="() => rechazando = null">
        <div class="sl-modal" @onclick:stopPropagation="true">
            <h3>Rechazar solicitud</h3>
            <p>@rechazando.Cliente · @rechazando.Servicio · @Cuando(rechazando.FechaCita), @FormatoHora(rechazando.HoraInicio). Registra el motivo de la decisión.</p>

            <label class="sl-label">Motivo</label>
            <select class="sl-input" @bind="motivo">
                @foreach (var m in motivos)
                {
                    <option value="@m">@m</option>
                }
            </select>

            <label class="sl-label">Mensaje para el cliente (opcional)</label>
            <textarea class="sl-input" @bind="comentario" placeholder="Por ejemplo: puedo atenderte el viernes a las 9:00 a. m."></textarea>

            <div class="sl-modal-actions">
                <button type="button" class="sl-btn sl-btn-plain" @onclick="() => rechazando = null">Cancelar</button>
                <button type="button" class="sl-btn sl-btn-danger" @onclick="ConfirmarRechazo">Rechazar solicitud</button>
            </div>
        </div>
    </div>
}

@if (toast is not null)
{
    <div class="sl-toast">
        <span>@toast</span>
        @if (ultima is not null)
        {
            <button type="button" @onclick="Deshacer">Deshacer</button>
        }
    </div>
}

@code {
    private List<SolicitudAgenteDTO> solicitudes = new();
    private List<AgenteTrabajoDTO> trabajos = new();

    private List<string> motivos = new()
    {
        "Horario no disponible",
        "No cuento con el repuesto o la herramienta",
        "Servicio fuera de mi especialidad",
        "Otro"
    };

    private string filtro = "Pendiente";
    private string busqueda = "";

    private SolicitudAgenteDTO? rechazando;
    private string motivo = "Horario no disponible";
    private string comentario = "";

    private SolicitudAgenteDTO? ultima;
    private string? toast;
    private string? errorSolicitudes;
    private string? errorTrabajos;
    private int toastId;
    private bool cargandoInicial = true;
    private bool solicitudesCargadas;
    private bool trabajosCargados;

    private static DateTime Hoy => DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.WhenAll(CargarSolicitudes(), CargarTrabajos());
        }
        finally
        {
            cargandoInicial = false;
        }
    }

    private async Task<bool> CargarSolicitudes()
    {
        errorSolicitudes = null;

        try
        {
            solicitudes = await Http.GetFromJsonAsync<List<SolicitudAgenteDTO>>(
                "api/Agente/solicitudes") ?? new();
            solicitudesCargadas = true;
            return true;
        }
        catch (HttpRequestException ex)
        {
            errorSolicitudes = MensajeErrorHttp(ex.StatusCode,
                "No se pudieron cargar las solicitudes. Verifica que el backend esté disponible.");
        }
        catch (JsonException)
        {
            errorSolicitudes = "El backend devolvió datos de solicitudes con un formato no válido.";
        }
        catch (TaskCanceledException)
        {
            errorSolicitudes = "La carga de solicitudes tardó demasiado. Intenta recargar la página.";
        }
        catch (Exception)
        {
            errorSolicitudes = "Ocurrió un error inesperado al cargar las solicitudes.";
        }

        return false;
    }

    // Los trabajos reales sirven para detectar choques de horario
    private async Task<bool> CargarTrabajos()
    {
        // Solicita todos los trabajos ocupados para detectar solapamientos que
        // puedan extenderse desde otra fecha o estar fuera de una ventana fija.
        var desde = DateOnly.MinValue.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var hasta = DateOnly.MaxValue.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        errorTrabajos = null;

        try
        {
            trabajos = await Http.GetFromJsonAsync<List<AgenteTrabajoDTO>>(
                $"api/Agente/trabajos?desde={desde}&hasta={hasta}") ?? new();
            trabajosCargados = true;
            return true;
        }
        catch (HttpRequestException ex)
        {
            errorTrabajos = MensajeErrorHttp(ex.StatusCode,
                "No se pudieron cargar los trabajos para comprobar conflictos de horario.");
        }
        catch (JsonException)
        {
            errorTrabajos = "El backend devolvió trabajos con un formato no válido.";
        }
        catch (TaskCanceledException)
        {
            errorTrabajos = "La carga de trabajos tardó demasiado. Intenta recargar la página.";
        }
        catch (Exception)
        {
            errorTrabajos = "Ocurrió un error inesperado al cargar los trabajos.";
        }

        return false;
    }

    // ---------- Calculados ----------
    private int Cuenta(string estado) => solicitudes.Count(x => x.Estado == estado);

    private IEnumerable<SolicitudAgenteDTO> Filtradas =>
        solicitudes
            .Where(x => filtro == "Todas" || x.Estado == filtro)
            .Where(x => string.IsNullOrWhiteSpace(busqueda)
                        || $"{x.Cliente} {x.Vehiculo} {x.Placa} {x.Servicio}".Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.FechaCita)
            .ThenBy(x => x.HoraInicio);

    // Devuelve con qué trabajo choca el horario solicitado (o null si está libre)
    private AgenteTrabajoDTO? TrabajoEnConflicto(SolicitudAgenteDTO s)
    {
        return trabajos.FirstOrDefault(t => SeSolapan(
            s.FechaCita,
            s.HoraInicio,
            s.TiempoEstimadoMinutos,
            t.FechaCita,
            t.HoraInicio,
            t.TiempoEstimadoMinutos));
    }

    private bool TieneDuracionInvalida(SolicitudAgenteDTO solicitud) =>
        solicitud.TiempoEstimadoMinutos <= 0 ||
        trabajos.Any(trabajo => trabajo.TiempoEstimadoMinutos <= 0);

    private static bool SeSolapan(
        DateOnly fechaA,
        TimeOnly horaA,
        int duracionAMinutos,
        DateOnly fechaB,
        TimeOnly horaB,
        int duracionBMinutos)
    {
        // La duración inválida se bloquea por separado; no debe etiquetarse
        // como un solapamiento real.
        if (duracionAMinutos <= 0 || duracionBMinutos <= 0)
            return false;

        var inicioA = (long)fechaA.DayNumber * TimeSpan.TicksPerDay + horaA.Ticks;
        var finA = inicioA + (long)duracionAMinutos * TimeSpan.TicksPerMinute;
        var inicioB = (long)fechaB.DayNumber * TimeSpan.TicksPerDay + horaB.Ticks;
        var finB = inicioB + (long)duracionBMinutos * TimeSpan.TicksPerMinute;

        return inicioA < finB && inicioB < finA;
    }

    // ---------- Acciones ----------
    private async Task Aceptar(SolicitudAgenteDTO s)
    {
        if (errorTrabajos is not null || !trabajosCargados)
        {
            await Aviso("No se pudo verificar la agenda. Recarga los trabajos antes de aceptar.");
            return;
        }

        if (TieneDuracionInvalida(s))
        {
            await Aviso("No se puede aceptar porque la solicitud o un trabajo existente tiene una duración inválida.");
            return;
        }

        if (TrabajoEnConflicto(s) is not null) return;

        try
        {
            using var respuesta = await Http.PutAsync(
                $"api/Agente/solicitudes/{s.IdCita}/aceptar", null);

            if (!respuesta.IsSuccessStatusCode)
            {
                await Aviso(await MensajeErrorRespuestaAsync(respuesta,
                    "No se pudo aceptar la solicitud."));
                return;
            }

            ultima = s;

            var solicitudesActualizadas = await CargarSolicitudes();
            var agendaActualizada = await ActualizarTrabajosDespuesDeAccion();

            var mensaje = $"Aceptaste la cita de {s.Cliente}.";
            var detalles = new List<string>();
            if (!solicitudesActualizadas)
                detalles.Add("No se pudo actualizar la lista de solicitudes.");
            if (agendaActualizada)
                detalles.Add("Ya aparece en tu agenda.");
            else
                detalles.Add("No se pudo actualizar la agenda.");
            await Aviso($"{mensaje} {string.Join(" ", detalles)}");
        }
        catch (HttpRequestException ex)
        {
            ultima = null;
            await Aviso(MensajeErrorHttp(ex.StatusCode, "No se pudo conectar con el backend para aceptar la solicitud."));
        }
        catch (TaskCanceledException)
        {
            ultima = null;
            await Aviso("La solicitud tardó demasiado y no se pudo confirmar el resultado. Recarga los datos.");
        }
    }

    private void AbrirRechazo(SolicitudAgenteDTO s, bool porChoque)
    {
        rechazando = s;
        motivo = porChoque ? "Horario no disponible" : motivos[0];
        comentario = "";
    }

    private async Task ConfirmarRechazo()
    {
        if (rechazando is null) return;

        var s = rechazando;
        var motivoFinal = string.IsNullOrWhiteSpace(comentario) ? motivo : $"{motivo}. {comentario.Trim()}";

        try
        {
            using var respuesta = await Http.PutAsJsonAsync(
                $"api/Agente/solicitudes/{s.IdCita}/rechazar",
                new RechazarSolicitudDTO { Motivo = motivoFinal });

            if (!respuesta.IsSuccessStatusCode)
            {
                await Aviso(await MensajeErrorRespuestaAsync(respuesta,
                    "No se pudo rechazar la solicitud."));
                return;
            }

            rechazando = null;
            ultima = s;
            var solicitudesActualizadas = await CargarSolicitudes();
            var mensaje = $"Rechazaste la cita de {s.Cliente}. El motivo quedó registrado.";
            if (!solicitudesActualizadas)
                mensaje += " No se pudo actualizar la lista de solicitudes.";
            await Aviso(mensaje);
        }
        catch (HttpRequestException ex)
        {
            ultima = null;
            await Aviso(MensajeErrorHttp(ex.StatusCode, "No se pudo conectar con el backend para rechazar la solicitud."));
        }
        catch (TaskCanceledException)
        {
            ultima = null;
            await Aviso("La solicitud tardó demasiado y no se pudo confirmar el resultado. Recarga los datos.");
        }
    }

    private async Task Deshacer()
    {
        if (ultima is null) return;

        var s = ultima;
        try
        {
            using var respuesta = await Http.PutAsync(
                $"api/Agente/solicitudes/{s.IdCita}/deshacer", null);

            if (!respuesta.IsSuccessStatusCode)
            {
                await Aviso(await MensajeErrorRespuestaAsync(respuesta,
                    "No se pudo deshacer la acción."));
                return;
            }

            var solicitudesActualizadas = await CargarSolicitudes();
            ultima = null;
            toast = null;
            var agendaActualizada = await ActualizarTrabajosDespuesDeAccion();
            if (!solicitudesActualizadas)
                return;
            if (!agendaActualizada)
                await Aviso("La acción se deshizo, pero no se pudo actualizar la agenda.");
        }
        catch (HttpRequestException ex)
        {
            await Aviso(MensajeErrorHttp(ex.StatusCode, "No se pudo conectar con el backend para deshacer la acción."));
        }
        catch (TaskCanceledException)
        {
            await Aviso("La solicitud tardó demasiado y no se pudo confirmar el resultado. Recarga los datos.");
        }
    }

    private async Task<bool> ActualizarTrabajosDespuesDeAccion()
    {
        return await CargarTrabajos();
    }

    private async Task Aviso(string mensaje)
    {
        var id = ++toastId;
        toast = mensaje;
        StateHasChanged();
        await Task.Delay(6000);
        if (id == toastId)
        {
            toast = null;
            ultima = null;
        }
    }

    // ---------- Formatos ----------
    private static readonly string[] DiasCortos = { "Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" };
    private static readonly string[] Meses = { "ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic" };

    private static string FormatoHora(TimeOnly hora)
    {
        var h = hora.Hour;
        var h12 = h % 12 == 0 ? 12 : h % 12;
        return $"{h12}:{hora.Minute:00} {(h > 11 ? "p. m." : "a. m.")}";
    }

    private static string Cuando(DateOnly f)
    {
        var n = f.DayNumber - DateOnly.FromDateTime(Hoy).DayNumber;
        if (n == 0) return "Hoy";
        if (n == 1) return "Mañana";
        if (n > 1) return $"En {n} días";
        return "Fecha pasada";
    }

    private static string Hace(DateTime? fechaCreacion)
    {
        if (fechaCreacion is null)
            return "Fecha no disponible";

        var creada = fechaCreacion.Value.Kind switch
        {
            DateTimeKind.Utc => fechaCreacion.Value.ToLocalTime(),
            DateTimeKind.Unspecified => DateTime.SpecifyKind(fechaCreacion.Value, DateTimeKind.Utc).ToLocalTime(),
            _ => fechaCreacion.Value
        };

        var minutos = Math.Max(0, (int)(DateTime.Now - creada).TotalMinutes);
        return Hace(minutos);
    }

    private static string Hace(int minutos)
    {
        if (minutos >= 1440) return $"Hace {minutos / 1440} d";
        if (minutos >= 60) return $"Hace {minutos / 60} h";
        return $"Hace {minutos} min";
    }

    private static string Quetzales(decimal monto) =>
        "Q" + monto.ToString("N2", CultureInfo.InvariantCulture);

    private static string Tiempo(int minutos) => $"{minutos} min";

    private static string TextoDocumento(DocumentoSolicitudDTO documento)
    {
        if (!documento.EstadoActivo)
        {
            var estado = string.IsNullOrWhiteSpace(documento.Estado)
                ? "estado no disponible"
                : documento.Estado;
            var vencimiento = documento.FechaVencimiento is not null &&
                documento.FechaVencimiento.Value < DateOnly.FromDateTime(Hoy)
                    ? " · vencido"
                    : "";
            return $"{documento.Tipo}: {estado}{vencimiento}";
        }

        if (documento.FechaVencimiento is null)
            return $"{documento.Tipo} registrado";

        var dias = documento.FechaVencimiento.Value.DayNumber - DateOnly.FromDateTime(Hoy).DayNumber;
        if (dias < 0)
            return $"{documento.Tipo} vencido";
        if (dias <= 30)
            return $"{documento.Tipo} vence en {dias} d";

        return $"{documento.Tipo} vigente";
    }

    private static string ClaseDocumento(DocumentoSolicitudDTO documento)
    {
        if (!documento.EstadoActivo)
            return "rojo";

        if (documento.FechaVencimiento is null)
            return "neutro";

        var dias = documento.FechaVencimiento.Value.DayNumber - DateOnly.FromDateTime(Hoy).DayNumber;
        if (dias < 0)
            return "rojo";
        if (dias <= 30)
            return "ambar";

        return "verde";
    }

    private static string MensajeErrorHttp(HttpStatusCode? estado, string fallback) => estado switch
    {
        HttpStatusCode.Unauthorized => "Tu sesión venció. Inicia sesión nuevamente.",
        HttpStatusCode.Forbidden => "Tu cuenta no tiene autorización para gestionar estas solicitudes.",
        HttpStatusCode.NotFound => "La solicitud ya no existe o dejó de estar disponible.",
        HttpStatusCode.BadRequest => "Los datos enviados no son válidos.",
        HttpStatusCode.Conflict => "La solicitud cambió o tiene un conflicto de horario. Recarga los datos e inténtalo de nuevo.",
        _ => fallback
    };

    private static async Task<string> MensajeErrorRespuestaAsync(
        HttpResponseMessage respuesta,
        string fallback)
    {
        var cuerpo = await respuesta.Content.ReadAsStringAsync();
        if (!string.IsNullOrWhiteSpace(cuerpo))
        {
            try
            {
                using var documento = JsonDocument.Parse(cuerpo);
                if (documento.RootElement.ValueKind == JsonValueKind.String)
                    return documento.RootElement.GetString() ?? fallback;

                if (documento.RootElement.ValueKind == JsonValueKind.Object)
                {
                    foreach (var propiedad in new[] { "detail", "message", "title" })
                    {
                        if (documento.RootElement.TryGetProperty(propiedad, out var valor) &&
                            valor.ValueKind == JsonValueKind.String)
                            return valor.GetString() ?? fallback;
                    }
                }
            }
            catch (JsonException)
            {
                if (!cuerpo.TrimStart().StartsWith('<'))
                    return cuerpo;
            }
        }

        return MensajeErrorHttp(respuesta.StatusCode, fallback);
    }

    private static string Iniciales(string nombre) =>
        string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));

    private static string ClaseEstado(string estado) => estado switch
    {
        "Aceptada" => "acep",
        "Rechazada" => "rech",
        _ => "pend"
    };
