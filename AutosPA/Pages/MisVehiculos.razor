@page "/mis-vehiculos"
@using System.Globalization
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@using Microsoft.JSInterop

<PageTitle>FlexiCar — Mis vehículos</PageTitle>

<style>
    .mv-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 28px 0;
    }

    .mv-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 26px;
    }

    .mv-eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #1f8a5b;
        margin-bottom: 8px;
    }

    .mv-head h1 {
        margin: 0 0 6px;
        font-size: clamp(30px, 4vw, 42px);
        font-weight: 700;
        color: #0f2a4a;
    }

    .mv-head p {
        margin: 0;
        max-width: 560px;
        font-size: 15px;
        line-height: 1.6;
        color: #6b7a90;
    }

    .mv-btn {
        display: inline-block;
        padding: 11px 20px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

        .mv-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(20, 64, 111, .22);
        }

        .mv-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .mv-btn-primary {
        background: linear-gradient(90deg, #14406f, #1f5fa8);
        color: #ffffff;
        padding: 12px 22px;
        font-size: 14px;
    }

    .mv-btn-solid {
        background: #14406f;
        color: #ffffff;
    }

    .mv-btn-outline {
        background: #ffffff;
        border-color: #14406f;
        color: #14406f;
    }

    .mv-btn-plain {
        background: #ffffff;
        border-color: #c4d2e4;
        color: #14406f;
    }

    .mv-btn-danger {
        background: #b42318;
        color: #ffffff;
    }

    /* Resumen */
    .mv-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 26px;
    }

    .mv-stat {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        background: #ffffff;
        border: 1px solid #e6ebf2;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(15, 42, 74, .05);
    }

    .mv-stat-ico {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #e6effa;
        color: #1a56a0;
    }

        .mv-stat-ico svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .mv-stat-ico.green {
            background: #e3f5ec;
            color: #146c43;
        }

        .mv-stat-ico.amber {
            background: #fdf1dc;
            color: #9a6200;
        }

    .mv-stat b {
        display: block;
        font-size: 24px;
        line-height: 1.1;
        color: #0f2a4a;
    }

    .mv-stat small {
        font-size: 12px;
        color: #6b7a90;
    }

    /* Filtros */
    .mv-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .mv-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .mv-chip {
        padding: 8px 16px;
        border: 1px solid #dbe3ee;
        border-radius: 999px;
        background: #ffffff;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #4a5a70;
        cursor: pointer;
    }

        .mv-chip:hover {
            background: #eef3fa;
        }

        .mv-chip.active {
            background: #14406f;
            border-color: #14406f;
            color: #ffffff;
        }

    .mv-search {
        width: 260px;
        padding: 10px 14px;
        border: 1px solid #dbe3ee;
        border-radius: 10px;
        background: #ffffff;
        font-family: inherit;
        font-size: 13px;
        color: #0f172a;
    }

        .mv-search:focus {
            outline: 2px solid #1f5fa8;
        }

    /* Tarjetas */
    .mv-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 22px;
    }

    .mv-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e6ebf2;
        border-radius: 20px;
        box-shadow: 0 2px 10px rgba(15, 42, 74, .06);
        transition: transform .15s, box-shadow .15s;
    }

        .mv-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 30px rgba(15, 42, 74, .13);
        }

    .mv-art {
        position: relative;
        padding: 18px 40px 6px;
        background: linear-gradient(180deg, #eef4fb, #ffffff);
    }

        .mv-art svg {
            display: block;
            width: 100%;
            max-height: 120px;
        }

    .mv-badge {
        position: absolute;
        top: 14px;
        right: 14px;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }

        .mv-badge.ok {
            background: #e3f5ec;
            color: #146c43;
        }

        .mv-badge.taller {
            background: #e1ecfa;
            color: #1a56a0;
        }

        .mv-badge.warn {
            background: #fdf1dc;
            color: #9a6200;
        }

    .mv-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 6px 22px 22px;
    }

        .mv-body h3 {
            margin: 0 0 4px;
            font-size: 18px;
            font-weight: 700;
            color: #0f2a4a;
        }

            .mv-body h3 small {
                font-size: 13px;
                font-weight: 500;
                color: #8492a6;
                margin-left: 4px;
            }

    .mv-sub {
        margin: 0 0 12px;
        font-size: 13px;
        color: #6b7a90;
    }

    .mv-driver {
        margin-bottom: 12px;
        font-size: 13px;
        color: #6b7a90;
    }

        .mv-driver b {
            color: #0f2a4a;
            font-weight: 600;
        }

    .mv-docs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 14px;
    }

    .mv-doc {
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
    }

        .mv-doc.verde {
            background: #e3f5ec;
            color: #146c43;
        }

        .mv-doc.ambar {
            background: #fdf1dc;
            color: #9a6200;
        }

        .mv-doc.rojo {
            background: #fdecea;
            color: #b42318;
        }

        .mv-doc.neutro {
            background: #eceff4;
            color: #5b6778;
        }

    .mv-line {
        flex: 1;
        margin-bottom: 16px;
        padding: 10px 12px;
        border-radius: 10px;
        background: #f2f6fb;
        font-size: 12px;
        line-height: 1.5;
        color: #4a5a70;
    }

    .mv-actions {
        display: flex;
        gap: 10px;
    }

        .mv-actions .mv-btn {
            flex: 1;
        }

    .mv-empty {
        padding: 44px 20px;
        border: 1px dashed #c4d2e4;
        border-radius: 18px;
        text-align: center;
        font-size: 14px;
        color: #6b7a90;
    }

    /* Ventanas */
    .mv-modal-bg {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(10, 30, 60, .55);
    }

    .mv-modal {
        width: 100%;
        max-width: 480px;
        max-height: 92vh;
        overflow-y: auto;
        padding: 28px;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
    }

        .mv-modal.wide {
            max-width: 680px;
        }

    .mv-modal-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
    }

    .mv-modal h3 {
        margin: 0 0 4px;
        font-size: 20px;
        color: #0f2a4a;
    }

    .mv-modal-sub {
        font-size: 13px;
        color: #6b7a90;
    }

    .mv-close {
        border: 0;
        background: none;
        font-size: 26px;
        line-height: 1;
        color: #9aa7ba;
        cursor: pointer;
    }

        .mv-close:hover {
            color: #0f2a4a;
        }

    .mv-sec {
        padding: 18px 0 4px;
        border-top: 1px solid #eef1f6;
        margin-top: 16px;
    }

        .mv-sec h4 {
            margin: 0 0 12px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #1a56a0;
        }

    .mv-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

        .mv-info div {
            padding: 10px 12px;
            border-radius: 10px;
            background: #f2f6fb;
        }

        .mv-info small {
            display: block;
            font-size: 11px;
            color: #6b7a90;
        }

        .mv-info b {
            font-size: 13px;
            color: #0f2a4a;
        }

    .mv-label {
        display: block;
        margin: 12px 0 6px;
        font-size: 12px;
        font-weight: 600;
        color: #4a5a70;
    }

    .mv-input {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid #dbe3ee;
        border-radius: 10px;
        background: #f7f9fc;
        font-family: inherit;
        font-size: 14px;
        color: #0f172a;
    }

        .mv-input:focus {
            outline: 2px solid #1f5fa8;
            background: #ffffff;
        }

    .mv-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 14px;
    }

    .mv-form-title {
        margin: 18px 0 2px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #1a56a0;
    }

    .mv-error {
        margin-top: 14px;
        padding: 10px 14px;
        border-radius: 10px;
        background: #fdecea;
        color: #b42318;
        font-size: 13px;
    }

    .mv-modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 22px;
    }

        .mv-modal-actions .left {
            margin-right: auto;
        }

    /* Documentos */
    .mv-docrow {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
        padding: 10px 12px;
        border: 1px solid #e6ebf2;
        border-radius: 12px;
    }

        .mv-docrow .info {
            flex: 1;
            min-width: 0;
        }

        .mv-docrow b {
            display: block;
            font-size: 13px;
            color: #0f2a4a;
        }

        .mv-docrow small {
            font-size: 11px;
            color: #8492a6;
        }

        .mv-docrow button {
            border: 0;
            background: none;
            font-size: 12px;
            font-weight: 600;
            color: #b42318;
            cursor: pointer;
        }

    .mv-upload {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 10px;
        align-items: end;
        margin-top: 12px;
        padding: 14px;
        border: 1.5px dashed #b7c7dc;
        border-radius: 14px;
        background: #fbfcfe;
    }

        .mv-upload .mv-label {
            margin-top: 0;
        }

    .mv-file {
        display: none;
    }

    .mv-upload label.mv-btn {
        margin: 0;
    }

    .mv-hint {
        margin-top: 8px;
        font-size: 11px;
        color: #8492a6;
    }

        .mv-hint.warn {
            color: #9a6200;
        }

    /* Historial */
    .mv-time {
        position: relative;
        margin: 0;
        padding: 0 0 0 22px;
        list-style: none;
    }

        .mv-time::before {
            content: "";
            position: absolute;
            left: 5px;
            top: 6px;
            bottom: 6px;
            width: 2px;
            background: #dbe3ee;
        }

        .mv-time li {
            position: relative;
            margin-bottom: 14px;
        }

            .mv-time li::before {
                content: "";
                position: absolute;
                left: -22px;
                top: 4px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #1f8a5b;
                border: 2px solid #ffffff;
                box-shadow: 0 0 0 1px #1f8a5b;
            }

        .mv-time b {
            display: block;
            font-size: 13px;
            color: #0f2a4a;
        }

        .mv-time small {
            font-size: 12px;
            color: #6b7a90;
        }

    .mv-toast {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 300;
        padding: 14px 20px;
        border-radius: 12px;
        background: #14406f;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
    }

    @@media (max-width: 900px) {
        .mv-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .mv-page {
            padding: 28px 14px 0;
        }

        .mv-search {
            width: 100%;
        }

        .mv-info {
            grid-template-columns: 1fr 1fr;
        }

        .mv-form-grid {
            grid-template-columns: 1fr;
        }

        .mv-upload {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="mv-page">

    <header class="mv-head">
        <div>
            <div class="mv-eyebrow">Tu garaje</div>
            <h1>Mis vehículos</h1>
            <p>Registra tus vehículos y sus conductores, mantén tus documentos al día y revisa el estado y el historial de cada uno.</p>
        </div>
        <button type="button" class="mv-btn mv-btn-primary" @onclick="AbrirNuevo">+ Agregar vehículo</button>
    </header>

    <!-- Resumen -->
    <div class="mv-stats">
        <div class="mv-stat">
            <div class="mv-stat-ico"><svg viewBox="0 0 24 24"><path d="M3 15l2-6a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 6v4h-3v-2H6v2H3z" /><circle cx="7.5" cy="14" r="1" /><circle cx="16.5" cy="14" r="1" /></svg></div>
            <div><b>@vehiculos.Count</b><small>Vehículos</small></div>
        </div>
        <div class="mv-stat">
            <div class="mv-stat-ico green"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
            <div><b>@vehiculos.Count(v => EstadoVeh(v).Clase == "ok")</b><small>Al día</small></div>
        </div>
        <div class="mv-stat">
            <div class="mv-stat-ico"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z" /></svg></div>
            <div><b>@vehiculos.Count(v => v.EnTaller)</b><small>En taller</small></div>
        </div>
        <div class="mv-stat">
            <div class="mv-stat-ico amber"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5M9 13h7M9 17h5" /></svg></div>
            <div><b>@DocsPorAtender</b><small>Documentos por atender</small></div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="mv-toolbar">
        <div class="mv-chips">
            <button type="button" class="mv-chip @(filtro == "todos" ? "active" : "")" @onclick='() => filtro = "todos"'>Todos</button>
            <button type="button" class="mv-chip @(filtro == "ok" ? "active" : "")" @onclick='() => filtro = "ok"'>Al día</button>
            <button type="button" class="mv-chip @(filtro == "taller" ? "active" : "")" @onclick='() => filtro = "taller"'>En taller</button>
            <button type="button" class="mv-chip @(filtro == "warn" ? "active" : "")" @onclick='() => filtro = "warn"'>Requiere atención</button>
        </div>
        <input class="mv-search" placeholder="Buscar por placa, marca o modelo" @bind="busqueda" @bind:event="oninput" />
    </div>

    <!-- Tarjetas -->
    <div class="mv-grid">
        @foreach (var v in Filtrados)
        {
            var est = EstadoVeh(v);
            <article class="mv-card">
                <div class="mv-art">
                    <svg viewBox="0 0 220 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <ellipse cx="110" cy="92" rx="90" ry="6" fill="#e5edf5" />
                        <path d="M25 78 L34 52 Q40 40 55 40 L150 40 Q165 40 172 52 L184 78 Z" fill="@Hex(v.Color)" />
                        <path d="M55 42 L70 22 Q75 16 84 16 L128 16 Q137 16 142 22 L157 42 Z" fill="@Hex(v.Color)" />
                        <path d="M55 42 L70 22 Q75 16 84 16 L128 16 Q137 16 142 22 L157 42 Z" fill="#000000" opacity=".2" />
                        <rect x="72" y="22" width="24" height="18" rx="2" fill="#e6eef8" />
                        <rect x="100" y="22" width="24" height="18" rx="2" fill="#e6eef8" />
                        <circle cx="62" cy="80" r="14" fill="#101a24" />
                        <circle cx="62" cy="80" r="6" fill="#cfd9e0" />
                        <circle cx="150" cy="80" r="14" fill="#101a24" />
                        <circle cx="150" cy="80" r="6" fill="#cfd9e0" />
                    </svg>
                    <span class="mv-badge @est.Clase">@est.Texto</span>
                </div>

                <div class="mv-body">
                    <h3>@v.Marca @v.Modelo<small>@v.Anio</small></h3>
                    <p class="mv-sub">Placa @v.Placa · @v.Tipo · @Km(v)</p>
                    <div class="mv-driver">Conductor: <b>@v.Conductor</b></div>

                    <div class="mv-docs">
                        @foreach (var tipo in new[] { "Seguro", "Inspección" })
                        {
                            var doc = DocDe(v, tipo);
                            var ed = doc is null ? ("Sin cargar", "neutro") : EstadoDoc(doc);
                            <span class="mv-doc @ed.Item2">@tipo · @ed.Item1</span>
                        }
                    </div>

                    <div class="mv-line">
                        @if (v.EnTaller)
                        {
                            <text><b>En taller:</b> @v.EstadoTaller</text>
                        }
                        else if (v.ProximaCita is not null)
                        {
                            <text><b>Próxima cita:</b> @v.ProximaCita</text>
                        }
                        else
                        {
                            <text>Sin citas próximas.</text>
                        }
                    </div>

                    <div class="mv-actions">
                        <button type="button" class="mv-btn mv-btn-outline" @onclick="() => VerEstado(v)">Ver estado</button>
                        <a class="mv-btn mv-btn-solid" href="citas/nueva">Agendar cita</a>
                    </div>
                </div>
            </article>
        }
    </div>

    @if (!Filtrados.Any())
    {
        <div class="mv-empty">
            @(vehiculos.Any() ? "Ningún vehículo coincide con tu búsqueda." : "Aún no has registrado vehículos. Agrega el primero para poder agendar citas.")
        </div>
    }
</div>

<!-- ================= VENTANAS ================= -->
@if (modal == "nuevo")
{
    <div class="mv-modal-bg" @onclick="CerrarModal">
        <div class="mv-modal" @onclick:stopPropagation="true">
            <div class="mv-modal-head">
                <div>
                    <h3>Registrar vehículo</h3>
                    <div class="mv-modal-sub">Datos del vehículo y de su conductor. Los documentos los adjuntas después.</div>
                </div>
                <button type="button" class="mv-close" @onclick="CerrarModal">×</button>
            </div>

            <div class="mv-form-title" style="margin-top:0;">Vehículo</div>
            <div class="mv-form-grid">
            <div>
                <label class="mv-label">Marca *</label>
                <select class="mv-input" @bind="nvIdMarca">
                     <option value="0">Selecciona una marca</option>
                     @foreach (var marca in marcas)
        {
            <option value="@marca.IdMarca">@marca.Nombre</option>
        }
    </select>
</div>

<div>
    <label class="mv-label">Modelo *</label>
    <input class="mv-input" @bind="nvModelo" placeholder="Corolla" />
</div>

<div>
    <label class="mv-label">Año</label>
    <input class="mv-input" @bind="nvAnio" placeholder="2020" />
</div>

<div>
    <label class="mv-label">Placa *</label>
    <input class="mv-input" @bind="nvPlaca" placeholder="P 000 ABC" />
</div>

<div>
    <label class="mv-label">Tipo</label>
    <select class="mv-input" @bind="nvIdTipoVehiculo">
        <option value="0">Selecciona un tipo</option>
        @foreach (var tipo in tiposVehiculo)
        {
            <option value="@tipo.IdTipoVehiculo">@tipo.Nombre</option>
        }
    </select>
</div>
                                </div>
                <div>
                    <label class="mv-label">Color</label>
                    <select class="mv-input" @bind="nvColor">
                        @foreach (var c in ColoresHex.Keys)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="mv-label">Kilometraje</label>
                    <input type="number" class="mv-input" @bind="nvKm" min="0" />
                </div>
            </div>

            <div class="mv-form-title">Conductor</div>
            <div class="mv-form-grid">
                <div><label class="mv-label">Nombre</label><input class="mv-input" @bind="nvConductor" placeholder="Nombre completo" /></div>
                <div><label class="mv-label">No. de licencia</label><input class="mv-input" @bind="nvLicencia" placeholder="L-000000" /></div>
            </div>

            @if (errorNuevo is not null)
            {
                <div class="mv-error">@errorNuevo</div>
            }

            <div class="mv-modal-actions">
                <button type="button" class="mv-btn mv-btn-plain" @onclick="CerrarModal">Cancelar</button>
                <button type="button" class="mv-btn mv-btn-solid" @onclick="GuardarVehiculo">Guardar vehículo</button>
            </div>
        </div>
}
else if (modal == "detalle" && sel is not null)
{
    var est = EstadoVeh(sel);
    <div class="mv-modal-bg" @onclick="CerrarModal">
        <div class="mv-modal wide" @onclick:stopPropagation="true">
            <div class="mv-modal-head">
                <div>
                    <h3>@sel.Marca @sel.Modelo @sel.Anio</h3>
                    <div class="mv-modal-sub">Placa @sel.Placa · <span class="mv-badge @est.Clase" style="position:static; display:inline-block;">@est.Texto</span></div>
                </div>
                <button type="button" class="mv-close" @onclick="CerrarModal">×</button>
            </div>

            <div class="mv-info">
                <div><small>Tipo</small><b>@sel.Tipo</b></div>
                <div><small>Color</small><b>@sel.Color</b></div>
                <div><small>Kilometraje</small><b>@Km(sel)</b></div>
                <div><small>Conductor</small><b>@sel.Conductor</b></div>
                <div><small>Licencia</small><b>@sel.Licencia</b></div>
                <div><small>Estado actual</small><b>@(sel.EnTaller? sel.EstadoTaller: "Disponible")</b></div>
            </div>


    <div class="mv-sec">
    <h4>Historial de servicios</h4>

    @if (sel.Historial.Any())
    {
        <ul class="mv-time">
            @foreach (var h in sel.Historial.OrderByDescending(x => x.Fecha))
            {
                <li>
                    <b>@h.Nombre</b>
                    <small>
                        @FechaCorta(h.Fecha) ·
                        Agente: @h.Agente ·
                        @h.Costo
                    </small>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="mv-hint">
            Este vehículo todavía no tiene servicios registrados.
        </div>
    }
</div>

            <div class="mv-modal-actions">
                <button type="button" class="mv-btn mv-btn-plain left" style="color:#b42318; border-color:#e3a59d;" @onclick='() => modal = "eliminar"'>Eliminar vehículo</button>
                <button type="button" class="mv-btn mv-btn-plain" @onclick="CerrarModal">Cerrar</button>
                <a class="mv-btn mv-btn-solid" href="citas/nueva">Agendar cita</a>
            </div>
        </div>
    </div>
}
else if (modal == "eliminar" && sel is not null)
{
    <div class="mv-modal-bg" @onclick="CerrarModal">
        <div class="mv-modal" @onclick:stopPropagation="true">
            <h3 style="color:#b42318;">¿Eliminar vehículo?</h3>
            <p class="mv-modal-sub" style="margin:8px 0 0; line-height:1.6;">
                Se eliminará <b>@sel.Marca @sel.Modelo (@sel.Placa)</b> junto con sus documentos e historial. Esta acción no se puede deshacer.
            </p>
            <div class="mv-modal-actions">
                <button type="button" class="mv-btn mv-btn-plain" @onclick='() => modal = "detalle"'>Cancelar</button>
                <button type="button" class="mv-btn mv-btn-danger" @onclick="EliminarVehiculo">Eliminar</button>
            </div>
        </div>
    </div>
}

@if (toast is not null)
{
    <div class="mv-toast">@toast</div>
}


@code {
    // ---------- Catálogos ----------
    private class MarcaCatalogo
    {
        public long IdMarca { get; set; }
        public string Nombre { get; set; } = "";
    }

    private class TipoVehiculoCatalogo
    {
        public long IdTipoVehiculo { get; set; }
        public string Nombre { get; set; } = "";
        public string? Descripcion { get; set; }
    }

    private class TipoDocumentoCatalogo
    {
        public long IdTipoDocumento { get; set; }
        public string Nombre { get; set; } = "";
        public string? Descripcion { get; set; }
    }

    // ---------- DTO recibido desde el backend ----------
    private class VehiculoDTO
    {
        public long IdVehiculo { get; set; }
        public string Marca { get; set; } = "";
        public string Modelo { get; set; } = "";
        public int Anio { get; set; }
        public string Placa { get; set; } = "";
        public string Tipo { get; set; } = "";
        public string? Color { get; set; }
        public int Kilometraje { get; set; }
    }

    private class DocumentoVehiculoDTO
    {
        public long IdDocumento { get; set; }
        public long IdTipoDocumento { get; set; }
        public string Tipo { get; set; } = "";
        public string Archivo { get; set; } = "";
        public DateTime? FechaVencimiento { get; set; }
        public string Estado { get; set; } = "";
    }

    private class CrearVehiculoDTO
    {
        public long IdMarca { get; set; }
        public long IdTipoVehiculo { get; set; }
        public string Modelo { get; set; } = "";
        public int Anio { get; set; }
        public string Placa { get; set; } = "";
        public string? Color { get; set; }
        public int Kilometraje { get; set; }
    }

    // ---------- Modelos de la pantalla ----------
    private class Documento
    {
        public long IdDocumento { get; set; }
        public long IdTipoDocumento { get; set; }
        public string Tipo { get; set; } = "";
        public string Archivo { get; set; } = "";
        public string Tamano { get; set; } = "";
        public DateTime? Vence { get; set; }
        public string Estado { get; set; } = "";
    }

    private record Servicio(DateTime Fecha, string Nombre, string Agente, string Costo);
    private class CitaHistorialDTO
{
    public long IdCita { get; set; }
    public long IdVehiculo { get; set; }
    public string Servicio { get; set; } = "";
    public string Estado { get; set; } = "";
    public DateOnly FechaCita { get; set; }
    public decimal Costo { get; set; }
}

    private record EstadoInfo(string Texto, string Clase);

    private class Vehiculo
    {
        public long Id { get; set; }
        public string Marca { get; set; } = "";
        public string Modelo { get; set; } = "";
        public string Anio { get; set; } = "";
        public string Placa { get; set; } = "";
        public string Tipo { get; set; } = "Sedán";
        public string Color { get; set; } = "Azul";
        public int Kilometraje { get; set; }
        public string Conductor { get; set; } = "—";
        public string Licencia { get; set; } = "—";
        public bool EnTaller { get; set; }
        public string EstadoTaller { get; set; } = "";
        public string? ProximaCita { get; set; }
        public List<Documento> Documentos { get; set; } = new();
        public List<Servicio> Historial { get; set; } = new();
    }

    // ---------- Datos y catálogos ----------
    private long idUsuario;
    private long nvIdMarca;
    private long nvIdTipoVehiculo;

    private List<Vehiculo> vehiculos = new();

    private List<string> tipos = new()
    {
        "Sedán", "Hatchback", "SUV", "Pickup", "Camión ligero", "Moto"
    };

    private List<MarcaCatalogo> marcas = new();
    private List<TipoVehiculoCatalogo> tiposVehiculo = new();
    private List<TipoDocumentoCatalogo> tiposDoc = new();

    // Datos del formulario de documentos
    private long docTipo;
    private DateTime? docVence;
    private string? errorDoc;
    private bool subiendoDocumento;

    // ---------- Inicialización ----------
    protected override async Task OnInitializedAsync()
    {
        try
        {
            marcas = await Http.GetFromJsonAsync<List<MarcaCatalogo>>(
                "api/Vehiculos/marcas") ?? new();

            tiposVehiculo = await Http.GetFromJsonAsync<List<TipoVehiculoCatalogo>>(
                "api/Vehiculos/tipos") ?? new();

            tiposDoc = await Http.GetFromJsonAsync<List<TipoDocumentoCatalogo>>(
                "api/DocumentosVehiculo/tipos") ?? new();

            if (tiposDoc.Any())
                docTipo = tiposDoc.First().IdTipoDocumento;

            var usuarioGuardado = await JS.InvokeAsync<string?>(
                "localStorage.getItem", "flexicar_usuario");

            if (string.IsNullOrWhiteSpace(usuarioGuardado))
            {
                usuarioGuardado = await JS.InvokeAsync<string?>(
                    "sessionStorage.getItem", "flexicar_usuario");
            }

            if (string.IsNullOrWhiteSpace(usuarioGuardado))
            {
                usuarioGuardado = await JS.InvokeAsync<string?>(
                    "sessionStorage.getItem", "flexicar_id_usuario");
            }

            if (string.IsNullOrWhiteSpace(usuarioGuardado))
            {
                usuarioGuardado = await JS.InvokeAsync<string?>(
                    "localStorage.getItem", "flexicar_id_usuario");
            }

            if (!long.TryParse(usuarioGuardado, out idUsuario))
            {
                toast = "No se pudo identificar al usuario. Inicia sesión nuevamente.";
                return;
            }

            await CargarVehiculos();
        }
        catch (HttpRequestException)
        {
            toast = "No se pudo conectar con el servidor.";
        }
        catch (Microsoft.JSInterop.JSException)
        {
            toast = "No se pudo leer la información de la sesión.";
        }
        catch (System.Text.Json.JsonException)
        {
            toast = "El servidor devolvió información que no se pudo interpretar.";
        }
    }

    // ---------- Consultar vehículos del usuario ----------
    private async Task CargarVehiculos()
    {
        var datos = await Http.GetFromJsonAsync<List<VehiculoDTO>>(
            $"api/Vehiculos/usuario/{idUsuario}") ?? new();

        vehiculos = datos.Select(v => new Vehiculo
        {
            Id = v.IdVehiculo,
            Marca = v.Marca,
            Modelo = v.Modelo,
            Anio = v.Anio.ToString(),
            Placa = v.Placa,
            Tipo = v.Tipo,
            Color = string.IsNullOrWhiteSpace(v.Color) ? "Azul" : v.Color,
            Kilometraje = v.Kilometraje,
            Conductor = "—",
            Licencia = "—"
        }).ToList();
    }

    // ---------- Colores ----------
    private static readonly Dictionary<string, string> ColoresHex = new()
    {
        ["Azul"] = "#1f5fa8",
        ["Blanco"] = "#dfe5ee",
        ["Negro"] = "#2b3340",
        ["Gris"] = "#6b7685",
        ["Plata"] = "#aab4c3",
        ["Rojo"] = "#c0392b",
        ["Verde"] = "#1f8a5b",
    };

    // ---------- Estado de la pantalla ----------
    private string filtro = "todos";
    private string busqueda = "";
    private string? modal;
    private Vehiculo? sel;
    private string? toast;

    private string nvModelo = "";
    private string nvAnio = "";
    private string nvPlaca = "";
    private string nvConductor = "";
    private string nvLicencia = "";
    private string nvTipo = "Sedán";
    private string nvColor = "Azul";
    private int nvKm;
    private string? errorNuevo;

    // ---------- Calculados ----------
    private IEnumerable<Vehiculo> Filtrados =>
        vehiculos
            .Where(v => filtro == "todos" || EstadoVeh(v).Clase == filtro)
            .Where(v => string.IsNullOrWhiteSpace(busqueda)
                || $"{v.Marca} {v.Modelo} {v.Placa}".Contains(
                    busqueda.Trim(), StringComparison.OrdinalIgnoreCase));

    private int DocsPorAtender =>
        vehiculos.Sum(v => v.Documentos.Count(d =>
            EstadoDoc(d).Clase is "rojo" or "ambar"));

    private EstadoInfo EstadoVeh(Vehiculo v)
    {
        if (v.EnTaller)
            return new EstadoInfo("En taller", "taller");

        if (v.Documentos.Any(d =>
            EstadoDoc(d).Clase is "rojo" or "ambar"))
            return new EstadoInfo("Requiere atención", "warn");

        return new EstadoInfo("Al día", "ok");
    }

    private static (string Texto, string Clase) EstadoDoc(Documento d)
    {
        if (d.Vence is null)
            return ("Sin vencimiento", "neutro");

        var dias = (d.Vence.Value.Date - DateTime.Today).Days;

        if (dias < 0)
            return ("Vencido", "rojo");

        if (dias <= 30)
            return ($"Vence en {dias} d", "ambar");

        return ("Vigente", "verde");
    }

    private static Documento? DocDe(Vehiculo v, string tipo) =>
        v.Documentos
            .Where(d => d.Tipo.Contains(
                tipo, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(d => d.Vence)
            .FirstOrDefault();

    private static string Hex(string color) =>
        ColoresHex.TryGetValue(color, out var h) ? h : "#1f5fa8";

    private static string Km(Vehiculo v) =>
        v.Kilometraje.ToString("N0", CultureInfo.InvariantCulture) + " km";

    private static readonly string[] Meses =
    {
        "ene", "feb", "mar", "abr", "may", "jun",
        "jul", "ago", "sep", "oct", "nov", "dic"
    };

    private static string FechaCorta(DateTime f) =>
        $"{f.Day} {Meses[f.Month - 1]} {f.Year}";

    // ---------- Acciones ----------
    private void AbrirNuevo()
    {
        nvIdMarca = 0;
        nvIdTipoVehiculo = 0;
        nvModelo = "";
        nvAnio = "";
        nvPlaca = "";
        nvConductor = "";
        nvLicencia = "";
        nvTipo = "Sedán";
        nvColor = "Azul";
        nvKm = 0;
        errorNuevo = null;
        modal = "nuevo";
    }

    private async Task VerEstado(Vehiculo v)
{
    sel = v;
    docVence = null;
    errorDoc = null;
    modal = "detalle";

    await CargarDocumentos(v);
    await CargarHistorial(v);
}

        // ---------- Historial de servicios ----------
private async Task CargarHistorial(Vehiculo v)
{
    try
    {
        var citas = await Http.GetFromJsonAsync<List<CitaHistorialDTO>>(
            $"api/Citas/cliente/{idUsuario}") ?? new();

        v.Historial = citas
            .Where(c =>
                c.IdVehiculo == v.Id &&
                string.Equals(c.Estado, "FINALIZADA",
                    StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.FechaCita)
            .Select(c => new Servicio(
                c.FechaCita.ToDateTime(TimeOnly.MinValue),
                c.Servicio,
                "—",
                $"Q {c.Costo:N2}"
            ))
            .ToList();
    }
    catch (HttpRequestException)
    {
        v.Historial = new();
        toast = "No se pudo cargar el historial de servicios.";
    }
}

    private void CerrarModal() => modal = null;

    // ---------- Registrar vehículo ----------
    private async Task GuardarVehiculo()
    {
        errorNuevo = null;

        if (nvIdMarca == 0 || nvIdTipoVehiculo == 0)
        {
            errorNuevo = "Selecciona una marca y un tipo de vehículo.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nvModelo) ||
            string.IsNullOrWhiteSpace(nvPlaca))
        {
            errorNuevo = "Modelo y placa son obligatorios.";
            return;
        }

        if (!int.TryParse(nvAnio, out int anio) || anio <= 0)
        {
            errorNuevo = "Ingresa un año válido.";
            return;
        }

        if (nvKm < 0)
        {
            errorNuevo = "El kilometraje no puede ser negativo.";
            return;
        }

        var placa = nvPlaca.Trim().ToUpperInvariant();

        if (vehiculos.Any(v =>
            v.Placa.Equals(placa, StringComparison.OrdinalIgnoreCase)))
        {
            errorNuevo = "Ya tienes un vehículo registrado con esa placa.";
            return;
        }

        var nuevoVehiculo = new CrearVehiculoDTO
        {
            IdMarca = nvIdMarca,
            IdTipoVehiculo = nvIdTipoVehiculo,
            Modelo = nvModelo.Trim(),
            Anio = anio,
            Placa = placa,
            Color = nvColor,
            Kilometraje = nvKm
        };

        try
        {
            var respuesta = await Http.PostAsJsonAsync(
                $"api/Vehiculos/usuario/{idUsuario}",
                nuevoVehiculo);

            if (!respuesta.IsSuccessStatusCode)
            {
                var mensaje = await respuesta.Content.ReadAsStringAsync();
                errorNuevo = $"No se pudo registrar el vehículo. {mensaje}";
                return;
            }

            await CargarVehiculos();

            modal = null;
            await Aviso("Vehículo registrado correctamente.");
        }
        catch (HttpRequestException)
        {
            errorNuevo = "No se pudo conectar con el servidor.";
        }
    }

    // ---------- Documentos ----------
    private async Task CargarDocumentos(Vehiculo v)
    {
        try
        {
            var documentos = await Http.GetFromJsonAsync<List<DocumentoVehiculoDTO>>(
                $"api/DocumentosVehiculo/vehiculo/{v.Id}") ?? new();

            v.Documentos = documentos.Select(d => new Documento
            {
                IdDocumento = d.IdDocumento,
                IdTipoDocumento = d.IdTipoDocumento,
                Tipo = d.Tipo,
                Archivo = d.Archivo,
                Vence = d.FechaVencimiento,
                Estado = d.Estado
            }).ToList();
        }
        catch (HttpRequestException)
        {
            errorDoc = "No se pudieron cargar los documentos.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorDoc = "No se pudo interpretar la lista de documentos.";
        }
    }

    private async Task OnDocumentos(InputFileChangeEventArgs e)
    {
        errorDoc = null;

        if (sel is null)
            return;

        if (docTipo <= 0)
        {
            errorDoc = "Selecciona un tipo de documento.";
            return;
        }

        IBrowserFile archivo = e.File;

        if (archivo.Size == 0 || archivo.Size > 5 * 1024 * 1024)
        {
            errorDoc = "El archivo debe pesar más de 0 y máximo 5 MB.";
            return;
        }

        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();

        var tipoMime = extension switch
        {
            ".pdf" => "application/pdf",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            _ => ""
        };

        if (string.IsNullOrEmpty(tipoMime))
        {
            errorDoc = "Solo se permiten archivos PDF, JPG o PNG.";
            return;
        }

        try
        {
            subiendoDocumento = true;

            using var contenido = new MultipartFormDataContent();

            contenido.Add(
                new StringContent(docTipo.ToString()),
                "idTipoDocumento");

            if (docVence.HasValue)
            {
                contenido.Add(
                    new StringContent(
                        docVence.Value.ToString("yyyy-MM-dd")),
                    "fechaVencimiento");
            }

            using var flujo = archivo.OpenReadStream(5 * 1024 * 1024);
            using var archivoContenido = new StreamContent(flujo);

            archivoContenido.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(tipoMime);

            contenido.Add(archivoContenido, "archivo", archivo.Name);

            var respuesta = await Http.PostAsync(
                $"api/DocumentosVehiculo/vehiculo/{sel.Id}",
                contenido);

            if (!respuesta.IsSuccessStatusCode)
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                errorDoc = $"No se pudo subir el documento. {detalle}";
                return;
            }

            await CargarDocumentos(sel);
            docVence = null;

            await Aviso("Documento guardado correctamente.");
        }
        catch (HttpRequestException)
        {
            errorDoc = "No se pudo conectar con el servidor.";
        }
        catch (IOException)
        {
            errorDoc = "No se pudo leer el archivo seleccionado.";
        }
        finally
        {
            subiendoDocumento = false;
        }
    }

    private async Task QuitarDoc(Documento d)
    {
        if (sel is null)
            return;

        errorDoc = null;

        try
        {
            var respuesta = await Http.DeleteAsync(
                $"api/DocumentosVehiculo/{d.IdDocumento}");

            if (!respuesta.IsSuccessStatusCode)
            {
                errorDoc = "No se pudo eliminar el documento.";
                return;
            }

            await CargarDocumentos(sel);
            await Aviso("Documento eliminado correctamente.");
        }
        catch (HttpRequestException)
        {
            errorDoc = "No se pudo conectar con el servidor.";
        }
    }

    // ---------- Eliminar vehículo ----------
    private async Task EliminarVehiculo()
    {
        if (sel is null)
            return;

        try
        {
            var respuesta = await Http.DeleteAsync(
                $"api/Vehiculos/usuario/{idUsuario}/{sel.Id}");

            if (!respuesta.IsSuccessStatusCode)
            {
                toast = "No se pudo eliminar el vehículo.";
                return;
            }

            await CargarVehiculos();
            sel = null;
            modal = null;

            await Aviso("Vehículo eliminado correctamente.");
        }
        catch (HttpRequestException)
        {
            toast = "No se pudo conectar con el servidor.";
        }
    }

    // ---------- Utilidades ----------
    private static string FormatoTamano(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024.0 / 1024.0:0.0} MB"
            : $"{Math.Max(1, bytes / 1024)} KB";

    private async Task Aviso(string mensaje)
    {
        toast = mensaje;
        StateHasChanged();

        await Task.Delay(2500);

        toast = null;
        StateHasChanged();
    }
}


