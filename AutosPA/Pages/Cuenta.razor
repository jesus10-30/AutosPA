@page "/cuenta"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>FlexiCar — Cuenta</PageTitle>

<style>
    .ac-page {
        max-width: 1040px;
        margin: 0 auto;
        padding: 40px 28px 0;
    }

    .ac-head {
        margin-bottom: 22px;
    }

    .ac-eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #1f8a5b;
        margin-bottom: 8px;
    }

    .ac-head h1 {
        margin: 0 0 6px;
        font-size: clamp(30px, 4vw, 40px);
        font-weight: 700;
        color: #0f2a4a;
    }

    .ac-head p {
        margin: 0;
        font-size: 15px;
        color: #6b7a90;
    }

    .ac-card {
        margin-bottom: 20px;
        padding: 28px;
        background: #ffffff;
        border: 1px solid #e6ebf2;
        border-radius: 20px;
        box-shadow: 0 2px 10px rgba(15, 42, 74, .05);
    }

    .ac-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
    }

        .ac-card-head h3 {
            margin: 0 0 4px;
            font-size: 19px;
            font-weight: 700;
            color: #0f2a4a;
        }

        .ac-card-head small {
            font-size: 13px;
            color: #6b7a90;
        }

    /* Perfil */
    .ac-profile {
        display: flex;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
        margin-bottom: 20px;
        padding: 30px 32px;
        border-radius: 20px;
        color: #ffffff;
        background: linear-gradient(135deg, #0f2a4a, #14406f 65%, #1f8a5b);
        box-shadow: 0 8px 24px rgba(15, 42, 74, .18);
    }

    .ac-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 88px;
        height: 88px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #ffffff;
        color: #14406f;
        font-size: 30px;
        font-weight: 800;
        box-shadow: 0 0 0 5px rgba(255, 255, 255, .2);
    }

    .ac-who {
        flex: 1;
        min-width: 220px;
    }

        .ac-who h2 {
            margin: 0 0 6px;
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
        }

        .ac-who p {
            margin: 0 0 10px;
            font-size: 15px;
            color: rgba(255, 255, 255, .85);
        }

    .ac-badge {
        display: inline-block;
        padding: 4px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .18);
        border: 1px solid rgba(255, 255, 255, .35);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .04em;
        color: #ffffff;
    }

    .ac-btn {
        display: inline-block;
        padding: 11px 22px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

        .ac-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, .15);
        }

        .ac-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .ac-btn-ghost {
        background: rgba(255, 255, 255, .12);
        border-color: rgba(255, 255, 255, .6);
        color: #ffffff;
    }

    .ac-btn-solid {
        background: #14406f;
        color: #ffffff;
    }

    .ac-btn-outline {
        background: #ffffff;
        border-color: #c4d2e4;
        color: #14406f;
    }

    .ac-btn-danger {
        background: #b42318;
        color: #ffffff;
    }

    .ac-btn-danger-outline {
        background: #ffffff;
        border-color: #e3a59d;
        color: #b42318;
    }

    /* Datos del cliente */
    .ac-fields {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .ac-field {
        padding: 18px 20px;
        border: 1px solid #eef1f6;
        border-radius: 14px;
        background: #f7f9fc;
    }

        .ac-field label {
            display: block;
            margin-bottom: 8px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #8492a6;
        }

        .ac-field b {
            display: block;
            font-size: 18px;
            font-weight: 600;
            line-height: 1.3;
            color: #0f2a4a;
            word-break: break-word;
        }

            .ac-field b.muted {
                font-weight: 500;
                color: #9aa7ba;
            }

        .ac-field .ac-input {
            font-size: 16px;
        }

    .ac-field-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ac-link {
        padding: 0;
        border: 0;
        background: none;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        color: #1a56a0;
        cursor: pointer;
    }

        .ac-link:hover {
            text-decoration: underline;
        }

    .ac-edit-bar {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #eef1f6;
    }

    /* Actividad */
    .ac-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .ac-stat {
        padding: 22px 12px;
        border-radius: 16px;
        background: linear-gradient(180deg, #eef4fb, #e6effa);
        text-align: center;
    }

        .ac-stat b {
            display: block;
            font-size: 34px;
            line-height: 1.1;
            color: #14406f;
        }

        .ac-stat small {
            font-size: 13px;
            color: #6b7a90;
        }

    /* Preferencias */
    .ac-pref {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        padding: 16px 6px;
        border: 0;
        border-bottom: 1px solid #eef1f6;
        border-radius: 10px;
        background: none;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
    }

        .ac-pref:last-child {
            border-bottom: 0;
        }

        .ac-pref:hover {
            background: #f7f9fc;
        }

    .ac-ico {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #e6effa;
    }

        .ac-ico svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: #14406f;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .ac-pref-text {
        flex: 1;
    }

        .ac-pref-text b {
            display: block;
            font-size: 15px;
            color: #0f2a4a;
        }

        .ac-pref-text small {
            font-size: 13px;
            color: #6b7a90;
        }

    .ac-chev {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: #9aa7ba;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Zona de peligro */
    .ac-danger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 22px 28px;
        border-radius: 18px;
        background: #fdf4f2;
        border: 1px solid #f3d0ca;
    }

        .ac-danger b {
            display: block;
            font-size: 15px;
            color: #b42318;
        }

        .ac-danger small {
            font-size: 13px;
            color: #6b7a90;
        }

    /* Ventanas */
    .ac-modal-bg {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(10, 30, 60, .55);
    }

    .ac-modal {
        width: 100%;
        max-width: 440px;
        padding: 30px;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
    }

        .ac-modal h3 {
            margin: 0 0 6px;
            font-size: 20px;
            color: #0f2a4a;
        }

        .ac-modal > p {
            margin: 0 0 16px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b7a90;
        }

    .ac-label {
        display: block;
        margin: 12px 0 6px;
        font-size: 12px;
        font-weight: 600;
        color: #4a5a70;
    }

    .ac-input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #dbe3ee;
        border-radius: 10px;
        background: #ffffff;
        font-family: inherit;
        font-size: 14px;
        color: #0f172a;
    }

        .ac-input:focus {
            outline: 2px solid #1f5fa8;
        }

    .ac-modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 22px;
    }

    .ac-error {
        margin-top: 12px;
        font-size: 12px;
        color: #b42318;
    }

    .ac-toast {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 300;
        padding: 14px 20px;
        border-radius: 12px;
        background: #14406f;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
    }

    .ac-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 180px;
        color: #6b7a90;
        font-size: 15px;
    }

    .ac-loading-spinner {
        width: 22px;
        height: 22px;
        border: 3px solid #e6ebf2;
        border-top-color: #1f8a5b;
        border-radius: 50%;
        animation: ac-spin .8s linear infinite;
    }

    @@keyframes ac-spin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 800px) {
        .ac-page {
            padding: 28px 14px 0;
        }

        .ac-card {
            padding: 22px;
        }

        .ac-profile {
            padding: 24px;
        }

        .ac-fields {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 520px) {
        .ac-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ac-page">

    <header class="ac-head">
        <div class="ac-eyebrow">Tu perfil</div>
        <h1>Cuenta</h1>
        <p>Administra tus datos y la seguridad de tu cuenta.</p>
    </header>

    @if (cargando)
    {
        <div class="ac-loading" role="status" aria-live="polite">
            <span class="ac-loading-spinner" aria-hidden="true"></span>
            <span>Cargando los datos de tu cuenta...</span>
        </div>
    }
    else
    {

    <!-- Perfil -->
    <section class="ac-profile">
        <div class="ac-avatar">@Iniciales</div>

        <div class="ac-who">
            <h2>@nombre</h2>
            <p>@correo</p>
            <span class="ac-badge">Cliente</span>
        </div>

        @if (!editando)
        {
            <button type="button" class="ac-btn ac-btn-ghost" @onclick="Editar">Editar perfil</button>
        }
    </section>

    <!-- Datos del cliente -->
    <section class="ac-card">
        <div class="ac-card-head">
            <div>
                <h3>Datos del cliente</h3>
                <small>Esta información se usa para tus citas y tus facturas.</small>
            </div>
        </div>

        <div class="ac-fields">
            <div class="ac-field">
                <label>Nombre completo</label>
                @if (!editando)
                {
                    <b>@nombre</b>
                }
                else
                {
                    <input class="ac-input" @bind="eNombre" placeholder="Nombre completo" />
                }
            </div>

            <div class="ac-field">
                <label>Correo electrónico</label>
                @if (!editando)
                {
                    <b>@correo</b>
                }
                else
                {
                    <input class="ac-input" @bind="eCorreo" placeholder="Correo electrónico" readonly />
                    <small>El cambio del correo de acceso estará disponible cuando se pueda sincronizar con Supabase Auth.</small>
                }
            </div>

            <div class="ac-field">
                <label>Teléfono</label>
                @if (!editando)
                {
                    <b>@telefono</b>
                }
                else
                {
                    <input class="ac-input" @bind="eTelefono" placeholder="+502 0000 0000" />
                }
            </div>

            <div class="ac-field">
                <label>NIT para facturación</label>
                <b>@(string.IsNullOrWhiteSpace(nit) ? "CF" : nit)</b>
            </div>

            <div class="ac-field">
                <label>Dirección</label>
                @if (string.IsNullOrWhiteSpace(direccionFactura))
                {
                    <b class="muted">Sin registrar</b>
                }
                else
                {
                    <b>@direccionFactura</b>
                }
            </div>

            <div class="ac-field">
                <label>Contraseña</label>
                <div class="ac-field-row">
                    <b>••••••••••</b>
                    <button type="button" class="ac-link" @onclick="@(() => AbrirModal("password"))">Cambiar</button>
                </div>
            </div>

            <div class="ac-field">
                <label>Miembro desde</label>
                <b>Enero 2025</b>
            </div>

            <div class="ac-field">
                <label>Tipo de cuenta</label>
                <b>Cliente</b>
            </div>
        </div>

        @if (editando)
        {
            <div class="ac-edit-bar">
                <button type="button" class="ac-btn ac-btn-outline" @onclick="() => editando = false">Cancelar</button>
                <button type="button" class="ac-btn ac-btn-solid"
        disabled="@guardando"
        @onclick="GuardarPerfil">
    @(guardando ? "Guardando..." : "Guardar cambios")
</button>
            </div>
        }
    </section>

    <!-- Actividad -->
    <section class="ac-card">
        <div class="ac-card-head">
            <div>
                <h3>Tu actividad</h3>
                <small>Resumen de tu historial en FlexiCar.</small>
            </div>
        </div>
        <div class="ac-stats">
    <div class="ac-stat">
        <b>@totalVehiculos</b>
        <small>Vehículos registrados</small>
    </div>
    <div class="ac-stat">
        <b>@citasProximas</b>
        <small>Citas próximas</small>
    </div>
    <div class="ac-stat">
        <b>@serviciosCompletados</b>
        <small>Servicios completados</small>
    </div>
</div>
    </section>

    <!-- Preferencias -->
    <section class="ac-card">
        <div class="ac-card-head">
            <div>
                <h3>Preferencias</h3>
            </div>
        </div>

        <button type="button" class="ac-pref" @onclick="@(() => AbrirModal("facturacion"))">
            <span class="ac-ico">
                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h4" /></svg>
            </span>
            <span class="ac-pref-text"><b>Facturación</b><small>NIT, nombre y dirección para tus facturas</small></span>
            <svg class="ac-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg>
        </button>

        <button type="button" class="ac-pref" @onclick="@(() => AbrirModal("logout"))">
            <span class="ac-ico">
                <svg viewBox="0 0 24 24"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4" /><path d="M16 8l4 4-4 4M20 12H9" /></svg>
            </span>
            <span class="ac-pref-text"><b>Cerrar sesión</b><small>Salir de tu cuenta en este dispositivo</small></span>
            <svg class="ac-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg>
        </button>
    </section>

    <!-- Eliminar cuenta -->
    <section class="ac-danger">
        <div>
            <b>Eliminar cuenta</b>
            <small>Se borrarán tus datos, vehículos y citas de forma permanente.</small>
        </div>
        <button type="button" class="ac-btn ac-btn-danger-outline" @onclick="@(() => AbrirModal("eliminar"))">Eliminar</button>
    </section>
    }
</div>

@if (modal is not null)
{
    <div class="ac-modal-bg" @onclick="CerrarModal">
        <div class="ac-modal" @onclick:stopPropagation="true">

            @if (modal == "password")
            {
                <h3>Cambiar contraseña</h3>
                <p>Usa al menos 8 caracteres.</p>
                <label class="ac-label">Contraseña actual</label>
                <input type="password" class="ac-input" @bind="pwActual" />
                <label class="ac-label">Nueva contraseña</label>
                <input type="password" class="ac-input" @bind="pwNueva" />
                <label class="ac-label">Confirmar nueva contraseña</label>
                <input type="password" class="ac-input" @bind="pwConfirma" />
                @if (errorModal is not null)
                {
                    <div class="ac-error">@errorModal</div>
                }
                <div class="ac-modal-actions">
                    <button type="button" class="ac-btn ac-btn-outline" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="ac-btn ac-btn-solid" disabled="@cambiandoPassword" @onclick="CambiarPassword">@(cambiandoPassword ? "Actualizando..." : "Guardar")</button>
                </div>
            }
            else if (modal == "facturacion")
            {
                <h3>Datos de facturación</h3>
                <p>Los usaremos en las facturas de tus servicios.</p>
                <label class="ac-label">NIT</label>
                <input class="ac-input" @bind="nit" placeholder="CF o tu NIT" />
                <label class="ac-label">Nombre para la factura</label>
                <input class="ac-input" @bind="nombreFactura" />
                <label class="ac-label">Dirección</label>
                <input class="ac-input" @bind="direccionFactura" placeholder="Zona, ciudad" />
                <div class="ac-modal-actions">
                    <button type="button" class="ac-btn ac-btn-outline" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="ac-btn ac-btn-solid" @onclick="GuardarFacturacion">Guardar</button>
                </div>
            }
            else if (modal == "logout")
            {
                <h3>¿Cerrar sesión?</h3>
                <p>Tendrás que iniciar sesión de nuevo para agendar citas y ver tus vehículos.</p>
                <div class="ac-modal-actions">
                    <button type="button" class="ac-btn ac-btn-outline" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="ac-btn ac-btn-solid" @onclick="CerrarSesion">Cerrar sesión</button>
                </div>
            }
            else if (modal == "eliminar")
            {
                <h3 style="color:#b42318;">Eliminar cuenta</h3>
                <p>Esta acción no se puede deshacer. Se borrarán tus datos, vehículos y citas. Escribe <b>ELIMINAR</b> para confirmar.</p>
                <input class="ac-input" @bind="confirmacion" @bind:event="oninput" placeholder="ELIMINAR" />
                <div class="ac-modal-actions">
                    <button type="button" class="ac-btn ac-btn-outline" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="ac-btn ac-btn-danger" disabled="@(!ConfirmacionValida)" @onclick="EliminarCuenta">Eliminar definitivamente</button>
                </div>
            }

        </div>
    </div>
}

@if (toast is not null)
{
    <div class="ac-toast">@toast</div>
}

@code {
    private string nombre = "";
    private string correo = "";
    private string telefono = "";

    private bool editando;
    private bool cargando = true;
    private bool guardando = false;
    private bool cambiandoPassword;

    private string eNombre = "";
    private string eCorreo = "";
    private string eTelefono = "";

    private string nit = "CF";
    private string nombreFactura = "";
    private string direccionFactura = "";

    private int totalVehiculos;
    private int citasProximas;
    private int serviciosCompletados;

    private string? modal;
    private string? errorModal;
    private string pwActual = "";
    private string pwNueva = "";
    private string pwConfirma = "";
    private string confirmacion = "";
    private string? toast;
    private int toastId;

    private string Iniciales =>
        string.Concat(
            nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => char.ToUpper(p[0]))
        );

    private bool ConfirmacionValida =>
        confirmacion.Trim().ToUpper() == "ELIMINAR";

    protected override async Task OnInitializedAsync()
    {
        var error = await CargarPerfil();
        if (error is not null)
            await Aviso(error);
    }

    private async Task<string?> CargarPerfil(bool mostrarIndicador = true)
    {
        try
        {
            if (mostrarIndicador)
                cargando = true;

            using var respuesta = await Http.GetAsync("api/Cliente/perfil");
            if (!respuesta.IsSuccessStatusCode)
                return await ObtenerMensajeErrorAsync(respuesta, "No se pudieron cargar los datos de tu cuenta.");

            var perfil = await respuesta.Content.ReadFromJsonAsync<
                AutosPALibrary.DTOs.PerfilClienteDTO>();

            if (perfil is null)
                return "El servidor no devolvió los datos del perfil.";

            nombre = $"{perfil.Nombres} {perfil.Apellidos}".Trim();
            correo = perfil.Email;
            telefono = perfil.Telefono ?? "";

            nombreFactura = nombre;

            totalVehiculos = perfil.TotalVehiculos;
            citasProximas = perfil.CitasProximas;
            serviciosCompletados = perfil.ServiciosCompletados;

            return null;
        }
        catch (TaskCanceledException)
        {
            return "La consulta del perfil tardó demasiado. Inténtalo de nuevo.";
        }
        catch (HttpRequestException)
        {
            return "No se pudo conectar con el servidor. Revisa tu conexión e inténtalo de nuevo.";
        }
        catch (System.Text.Json.JsonException)
        {
            return "El servidor devolvió una respuesta inválida al cargar el perfil.";
        }
        catch (Exception)
        {
            return "Ocurrió un problema al cargar tu perfil.";
        }
        finally
        {
            if (mostrarIndicador)
                cargando = false;
        }
    }

    private void Editar()
    {
        eNombre = nombre;
        eCorreo = correo;
        eTelefono = telefono;
        editando = true;
    }

    private async Task GuardarPerfil()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            if (string.IsNullOrWhiteSpace(eNombre) ||
                string.IsNullOrWhiteSpace(eCorreo))
            {
                await Aviso("El nombre y el correo son obligatorios.");
                return;
            }

            var partesNombre = eNombre.Trim()
                .Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);

            if (partesNombre.Length < 2)
            {
                await Aviso("Ingresa tus nombres y apellidos.");
                return;
            }

            if (!System.Text.RegularExpressions.Regex.IsMatch(
                eCorreo.Trim(),
                @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
            {
                await Aviso("Ingresa un correo electrónico válido.");
                return;
            }

            var datos = new AutosPALibrary.DTOs.ActualizarPerfilClienteDTO
            {
                Nombres = partesNombre[0],
                Apellidos = partesNombre[1],
                Email = eCorreo.Trim(),
                Telefono = eTelefono
            };

            using var respuesta = await Http.PutAsJsonAsync(
                "api/Cliente/perfil",
                datos
            );

            if (respuesta.IsSuccessStatusCode)
            {
                editando = false;

                var errorRecarga = await CargarPerfil(mostrarIndicador: false);
                if (errorRecarga is null)
                    await Aviso("Perfil actualizado correctamente.");
                else
                    await Aviso($"Los cambios se guardaron, pero no se pudieron confirmar al recargar el perfil. {errorRecarga}");
            }
            else
            {
                await Aviso(await ObtenerMensajeErrorAsync(respuesta, "No se pudieron guardar los cambios."));
            }
        }
        catch (TaskCanceledException)
        {
            await Aviso("La solicitud tardó demasiado. Inténtalo de nuevo.");
        }
        catch (HttpRequestException)
        {
            await Aviso("No se pudo conectar con el servidor. Revisa tu conexión e inténtalo de nuevo.");
        }
        catch (Exception)
        {
            await Aviso("Ocurrió un problema al guardar los cambios.");
        }
        finally
        {
            guardando = false;
        }
    }

    private static async Task<string> ObtenerMensajeErrorAsync(
        HttpResponseMessage respuesta,
        string mensajePredeterminado)
    {
        var cuerpo = await respuesta.Content.ReadAsStringAsync();
        var mensajeServidor = ExtraerMensajeServidor(cuerpo);

        return (int)respuesta.StatusCode switch
        {
            400 => mensajeServidor ?? "Revisa los datos ingresados e inténtalo de nuevo.",
            401 => "Tu sesión no es válida o venció. Inicia sesión nuevamente.",
            403 => "No tienes autorización para acceder a este perfil.",
            404 => "No se encontró el perfil de tu cuenta.",
            409 => mensajeServidor ?? "No se pudo guardar porque existe un conflicto con los datos actuales.",
            500 => "Ocurrió un error interno del servidor. Inténtalo más tarde.",
            >= 500 => "El servidor tuvo un problema. Inténtalo más tarde.",
            _ => mensajeServidor ?? mensajePredeterminado
        };
    }

    private static string? ExtraerMensajeServidor(string cuerpo)
    {
        if (string.IsNullOrWhiteSpace(cuerpo))
            return null;

        try
        {
            using var documento = System.Text.Json.JsonDocument.Parse(cuerpo);
            if (documento.RootElement.ValueKind == System.Text.Json.JsonValueKind.String)
                return documento.RootElement.GetString();

            if (documento.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var propiedad in new[] { "mensaje", "message", "detail", "title" })
                {
                    if (documento.RootElement.TryGetProperty(propiedad, out var valor) &&
                        valor.ValueKind == System.Text.Json.JsonValueKind.String)
                        return valor.GetString();
                }
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // Algunos errores del servidor pueden devolver texto plano.
            return cuerpo.Length <= 300 ? cuerpo : null;
        }

        return null;
    }

    private void AbrirModal(string nombreModal)
    {
        modal = nombreModal;
        errorModal = null;
        pwActual = pwNueva = pwConfirma = confirmacion = "";
    }

    private void CerrarModal()
    {
        modal = null;
        errorModal = null;
    }

    private async Task CambiarPassword()
    {
        if (cambiandoPassword)
            return;

        if (string.IsNullOrWhiteSpace(pwActual))
        {
            errorModal = "Escribe tu contraseña actual.";
            return;
        }

        if (pwNueva.Length < 8)
        {
            errorModal = "La nueva contraseña debe tener al menos 8 caracteres.";
            return;
        }

        if (pwNueva != pwConfirma)
        {
            errorModal = "Las contraseñas no coinciden.";
            return;
        }

        cambiandoPassword = true;
        errorModal = null;

        try
        {
            using var respuesta = await Http.PutAsJsonAsync(
                "api/Auth/password",
                new AutosPALibrary.DTOs.CambiarPasswordDTO
                {
                    PasswordActual = pwActual,
                    PasswordNueva = pwNueva
                });

            if (!respuesta.IsSuccessStatusCode)
            {
                errorModal = await ObtenerMensajeErrorAsync(
                    respuesta,
                    "No se pudo cambiar la contraseña.");
                return;
            }

            modal = null;
            pwActual = pwNueva = pwConfirma = "";
            await LimpiarSesionAsync();
            toast = "La contraseña se actualizó correctamente. Inicia sesión de nuevo.";
            StateHasChanged();
            await Task.Delay(1500);
            Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (TaskCanceledException)
        {
            errorModal = "La solicitud tardó demasiado. Inicia sesión para comprobar el estado antes de volver a intentarlo.";
        }
        catch (HttpRequestException)
        {
            errorModal = "No se pudo conectar con el servidor.";
        }
        catch (Exception)
        {
            errorModal = "Ocurrió un problema al cambiar la contraseña.";
        }
        finally
        {
            cambiandoPassword = false;
        }
    }

    private async Task GuardarFacturacion()
    {
        modal = null;
        await Aviso("Los datos de facturación aún no están conectados a la base de datos.");
    }

    private async Task CerrarSesion()
    {
        try
        {
            await LimpiarSesionAsync();

            modal = null;

            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorModal = $"No se pudo cerrar la sesión: {ex.Message}";
        }
    }

    private async Task LimpiarSesionAsync()
    {
        foreach (var key in new[] { "flexicar_token", "flexicar_usuario", "flexicar_rol" })
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", key);
            await JS.InvokeVoidAsync("sessionStorage.removeItem", key);
        }
    }

    private async Task EliminarCuenta()
    {
        modal = null;
        await Aviso("La eliminación de cuenta todavía no está habilitada.");
    }

    private async Task Aviso(string mensaje)
    {
        var id = ++toastId;
        toast = mensaje;
        StateHasChanged();

        await Task.Delay(2500);

        if (id == toastId)
            toast = null;
    }
}
