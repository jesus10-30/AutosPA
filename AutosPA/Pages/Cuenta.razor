@page "/cuenta"
@layout AuthLayout
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using AutosPALibrary.Dtos

@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS
@inject AutosPA.Services.SessionAuthenticationStateProvider SesionAuth

<PageTitle>FlexiCar — Cuenta</PageTitle>

<style>
    .ac-page {
        max-width: 1040px;
        margin: 0 auto;
        padding: 40px 28px 0;
    }

    .ac-head {
        margin-bottom: 22px;
    }

    .ac-eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #1f8a5b;
        margin-bottom: 8px;
    }

    .ac-head h1 {
        margin: 0 0 6px;
        font-size: clamp(30px, 4vw, 40px);
        font-weight: 700;
        color: #0f2a4a;
    }

    .ac-head p {
        margin: 0;
        font-size: 15px;
        color: #6b7a90;
    }

    .ac-card {
        margin-bottom: 20px;
        padding: 28px;
        background: #ffffff;
        border: 1px solid #e6ebf2;
        border-radius: 20px;
        box-shadow: 0 2px 10px rgba(15, 42, 74, .05);
    }

    .ac-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
    }

        .ac-card-head h3 {
            margin: 0 0 4px;
            font-size: 19px;
            font-weight: 700;
            color: #0f2a4a;
        }

        .ac-card-head small {
            font-size: 13px;
            color: #6b7a90;
        }

    /* Perfil */
    .ac-profile {
        display: flex;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
        margin-bottom: 20px;
        padding: 30px 32px;
        border-radius: 20px;
        color: #ffffff;
        background: linear-gradient(135deg, #0f2a4a, #14406f 65%, #1f8a5b);
        box-shadow: 0 8px 24px rgba(15, 42, 74, .18);
    }

    .ac-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 88px;
        height: 88px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #ffffff;
        color: #14406f;
        font-size: 30px;
        font-weight: 800;
        box-shadow: 0 0 0 5px rgba(255, 255, 255, .2);
    }

    .ac-who {
        flex: 1;
        min-width: 220px;
    }

        .ac-who h2 {
            margin: 0 0 6px;
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
        }

        .ac-who p {
            margin: 0 0 10px;
            font-size: 15px;
            color: rgba(255, 255, 255, .85);
        }

    .ac-badge {
        display: inline-block;
        padding: 4px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .18);
        border: 1px solid rgba(255, 255, 255, .35);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .04em;
        color: #ffffff;
    }

    .ac-btn {
        display: inline-block;
        padding: 11px 22px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

        .ac-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, .15);
        }

        .ac-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .ac-btn-ghost {
        background: rgba(255, 255, 255, .12);
        border-color: rgba(255, 255, 255, .6);
        color: #ffffff;
    }

    .ac-btn-solid {
        background: #14406f;
        color: #ffffff;
    }

    .ac-btn-outline {
        background: #ffffff;
        border-color: #c4d2e4;
        color: #14406f;
    }

    .ac-btn-danger {
        background: #b42318;
        color: #ffffff;
    }

    .ac-btn-danger-outline {
        background: #ffffff;
        border-color: #e3a59d;
        color: #b42318;
    }

    /* Datos del cliente */
    .ac-fields {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .ac-field {
        padding: 18px 20px;
        border: 1px solid #eef1f6;
        border-radius: 14px;
        background: #f7f9fc;
    }

        .ac-field label {
            display: block;
            margin-bottom: 8px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #8492a6;
        }

        .ac-field b {
            display: block;
            font-size: 18px;
            font-weight: 600;
            line-height: 1.3;
            color: #0f2a4a;
            word-break: break-word;
        }

            .ac-field b.muted {
                font-weight: 500;
                color: #9aa7ba;
            }

        .ac-field .ac-input {
            font-size: 16px;
        }

    .ac-field-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ac-link {
        padding: 0;
        border: 0;
        background: none;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        color: #1a56a0;
        cursor: pointer;
    }

        .ac-link:hover {
            text-decoration: underline;
        }

    .ac-edit-bar {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #eef1f6;
    }

    /* Actividad */
    .ac-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .ac-stat {
        padding: 22px 12px;
        border-radius: 16px;
        background: linear-gradient(180deg, #eef4fb, #e6effa);
        text-align: center;
    }

        .ac-stat b {
            display: block;
            font-size: 34px;
            line-height: 1.1;
            color: #14406f;
        }

        .ac-stat small {
            font-size: 13px;
            color: #6b7a90;
        }

    /* Preferencias */
    .ac-pref {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        padding: 16px 6px;
        border: 0;
        border-bottom: 1px solid #eef1f6;
        border-radius: 10px;
        background: none;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
    }

        .ac-pref:last-child {
            border-bottom: 0;
        }

        .ac-pref:hover {
            background: #f7f9fc;
        }

    .ac-ico {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #e6effa;
    }

        .ac-ico svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: #14406f;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .ac-pref-text {
        flex: 1;
    }

        .ac-pref-text b {
            display: block;
            font-size: 15px;
            color: #0f2a4a;
        }

        .ac-pref-text small {
            font-size: 13px;
            color: #6b7a90;
        }

    .ac-chev {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: #9aa7ba;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Zona de peligro */
    .ac-danger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 22px 28px;
        border-radius: 18px;
        background: #fdf4f2;
        border: 1px solid #f3d0ca;
    }

        .ac-danger b {
            display: block;
            font-size: 15px;
            color: #b42318;
        }

        .ac-danger small {
            font-size: 13px;
            color: #6b7a90;
        }

    /* Ventanas */
    .ac-modal-bg {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(10, 30, 60, .55);
    }

    .ac-modal {
        width: 100%;
        max-width: 440px;
        padding: 30px;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
    }

        .ac-modal h3 {
            margin: 0 0 6px;
            font-size: 20px;
            color: #0f2a4a;
        }

        .ac-modal > p {
            margin: 0 0 16px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b7a90;
        }

    .ac-label {
        display: block;
        margin: 12px 0 6px;
        font-size: 12px;
        font-weight: 600;
        color: #4a5a70;
    }

    .ac-input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #dbe3ee;
        border-radius: 10px;
        background: #ffffff;
        font-family: inherit;
        font-size: 14px;
        color: #0f172a;
    }

        .ac-input:focus {
            outline: 2px solid #1f5fa8;
        }

    .ac-modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 22px;
    }

    .ac-error {
        margin-top: 12px;
        font-size: 12px;
        color: #b42318;
    }

    .ac-toast {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 300;
        padding: 14px 20px;
        border-radius: 12px;
        background: #14406f;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
    }

    @@media (max-width: 800px) {
        .ac-page {
            padding: 28px 14px 0;
        }

        .ac-card {
            padding: 22px;
        }

        .ac-profile {
            padding: 24px;
        }

        .ac-fields {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 520px) {
        .ac-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ac-page">

    <header class="ac-head">
        <div class="ac-eyebrow">Tu perfil</div>
        <h1>Cuenta</h1>
        <p>Administra tus datos y la seguridad de tu cuenta.</p>
    </header>

    <!-- Perfil -->
    <section class="ac-profile">
        <div class="ac-avatar">@Iniciales</div>

        <div class="ac-who">
            <h2>@nombre</h2>
            <p>@correo</p>
            <span class="ac-badge">@rol</span>
        </div>

        @if (!editando)
        {
            <button type="button" class="ac-btn ac-btn-ghost" @onclick="Editar">Editar perfil</button>
        }
    </section>

    <!-- Datos del cliente -->
    <section class="ac-card">
        <div class="ac-card-head">
            <div>
                <h3>Datos del cliente</h3>
                <small>Esta información se usa para tus citas y tus facturas.</small>
            </div>
        </div>

        <div class="ac-fields">
            <div class="ac-field">
                <label>Nombres</label>
                @if (!editando)
                {
                    <b>@nombres</b>
                }
                else
                {
                    <input class="ac-input" @bind="eNombres" />
                }
            </div>

            <div class="ac-field">
                <label>Apellidos</label>
                @if (!editando)
                {
                    <b>@apellidos</b>
                }
                else
                {
                    <input class="ac-input" @bind="eApellidos" />
                }
            </div>

            <div class="ac-field">
                <label>Correo electrónico</label>
                @if (!editando)
                {
                    <b>@correo</b>
                }
                else
                {
                    <input class="ac-input" value="@correo" readonly />
                }
            </div>

            <div class="ac-field">
                <label>Teléfono</label>
                @if (!editando)
                {
                    <b>@telefono</b>
                }
                else
                {
                    <input class="ac-input" @bind="eTelefono" placeholder="+502 0000 0000" />
                }
            </div>

            <div class="ac-field">
                <label>Contraseña</label>
                <div class="ac-field-row">
                    <b>••••••••••</b>
                    <button type="button" class="ac-link" @onclick="@(() => AbrirModal("password"))">Cambiar</button>
                </div>
            </div>

            <div class="ac-field">
                <label>Miembro desde</label>
                <b>@(fechaRegistro?.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-GT")) ?? "No disponible")</b>
            </div>

            <div class="ac-field">
                <label>Tipo de cuenta</label>
                <b>Cliente</b>
            </div>
        </div>
               

        @if (editando)
        {
            <div class="ac-edit-bar">
                <button type="button"
                        class="ac-btn ac-btn-outline"
                        @onclick="CancelarEdicion">
                    Cancelar
                </button>

                <button type="button"
                        class="ac-btn ac-btn-solid"
                        @onclick="GuardarPerfil">
                    Guardar cambios
                </button>
            </div>
        }
    </section>
        

    <!-- Actividad -->
    <section class="ac-card">
        <div class="ac-card-head">
            <div>
                <h3>Tu actividad</h3>
                <small>Resumen de tu historial en FlexiCar.</small>
            </div>
        </div>

        <div class="ac-stats">
            <div class="ac-stat">
                <b>@(cargandoEstadisticas ? "..." : vehiculosRegistrados.ToString())</b>
                <small>Vehículos registrados</small>
            </div>

            <div class="ac-stat">
                <b>@(cargandoEstadisticas ? "..." : citasProximas.ToString())</b>
                <small>Citas próximas</small>
            </div>

            <div class="ac-stat">
                <b>@(cargandoEstadisticas ? "..." : serviciosCompletados.ToString())</b>
                <small>Servicios completados</small>
            </div>
        </div>


    </section>

    <!-- Preferencias -->
    <section class="ac-card">
        <div class="ac-card-head">
            <div>
                <h3>Preferencias</h3>
            </div>
        </div>

        <button type="button" class="ac-pref" @onclick="@(() => AbrirModal("logout"))">
            <span class="ac-ico">
                <svg viewBox="0 0 24 24"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4" /><path d="M16 8l4 4-4 4M20 12H9" /></svg>
            </span>
            <span class="ac-pref-text"><b>Cerrar sesión</b><small>Salir de tu cuenta en este dispositivo</small></span>
            <svg class="ac-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg>
        </button>
    </section>

</div>

@if (modal is not null)
{
    <div class="ac-modal-bg" @onclick="CerrarModal">
        <div class="ac-modal" @onclick:stopPropagation="true">

            @if (modal == "password")
            {
                <h3>Cambiar contraseña</h3>
                <p>Usa al menos 8 caracteres.</p>
                <label class="ac-label">Contraseña actual</label>
                <input type="password" class="ac-input" @bind="pwActual" />
                <label class="ac-label">Nueva contraseña</label>
                <input type="password" class="ac-input" @bind="pwNueva" />
                <label class="ac-label">Confirmar nueva contraseña</label>
                <input type="password" class="ac-input" @bind="pwConfirma" />
                @if (errorModal is not null)
                {
                    <div class="ac-error">@errorModal</div>
                }
                <div class="ac-modal-actions">
                    <button type="button" class="ac-btn ac-btn-outline" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="ac-btn ac-btn-solid" @onclick="CambiarPassword">Guardar</button>
                </div>
            }
            
            else if (modal == "logout")
            {
                <h3>¿Cerrar sesión?</h3>
                <p>Tendrás que iniciar sesión de nuevo para agendar citas y ver tus vehículos.</p>
                <div class="ac-modal-actions">
                    <button type="button" class="ac-btn ac-btn-outline" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="ac-btn ac-btn-solid" @onclick="CerrarSesion">Cerrar sesión</button>
                </div>
            }
           

        </div>
    </div>
}

@if (toast is not null)
{
    <div class="ac-toast">@toast</div>
}

@code {

    private string nombres = "";
    private string apellidos = "";
    private string eNombres = "";
    private string eApellidos = "";
    private string eTelefono = "";
    private long idUsuario;
    private bool cargandoPerfil;
    private DateTime? fechaRegistro;
    private string rol = "";
    private int vehiculosRegistrados;
    private int citasProximas;
    private int serviciosCompletados;
    private bool cargandoEstadisticas;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cargandoPerfil = true;

            var idGuardado = await JS.InvokeAsync<string?>(
                "sessionStorage.getItem",
                "flexicar_id_usuario"
            );

            if (!long.TryParse(idGuardado, out idUsuario) || idUsuario <= 0)
            {
                Nav.NavigateTo("/login");
                return;
            }

            var perfil = await Http.GetFromJsonAsync<PerfilUsuarioDto>(
                $"api/auth/perfil/{idUsuario}"
            );

            if (perfil is null)
                return;

            nombres = perfil.Nombres;
            apellidos = perfil.Apellidos;

            nombre = $"{nombres} {apellidos}".Trim();
            correo = perfil.Email;
            telefono = perfil.Telefono ?? "";

            fechaRegistro = perfil.FechaRegistro;
            rol = perfil.Rol;

            await CargarEstadisticasAsync();
        }
        catch (HttpRequestException)
        {
            // Aquí puedes mostrar un mensaje si falla la conexión con la API.
        }
        catch (JSException)
        {
            Nav.NavigateTo("/login");
        }
        finally
        {
            cargandoPerfil = false;

        }
    }
    // TODO: reemplazar por los datos del usuario logueado (AutosPAService)
    private string nombre = "";
    private string correo = "";
    private string telefono = "";

    private bool editando;
    private string eNombre = "", eCorreo = "";


    private string? modal;
    private string? errorModal;
    private string pwActual = "", pwNueva = "", pwConfirma = "";
    private string? toast;
    private int toastId;

    private string Iniciales =>
        string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));

    

    private void Editar()
    {
        eNombres = nombres;
        eApellidos = apellidos;
        eTelefono = telefono;

        editando = true;
    }

    
    private async Task GuardarPerfil()
    {
        if (string.IsNullOrWhiteSpace(eNombres) ||
            string.IsNullOrWhiteSpace(eApellidos))
        {
            await Aviso("Los nombres y apellidos son obligatorios.");
            return;
        }

        try
        {
            var request = new ActualizarPerfilRequest
            {
                Nombres = eNombres.Trim(),
                Apellidos = eApellidos.Trim(),
                Telefono = string.IsNullOrWhiteSpace(eTelefono)
                    ? null
                    : eTelefono.Trim()
            };

            var respuesta = await Http.PutAsJsonAsync(
                $"api/auth/perfil/{idUsuario}",
                request);

            if (!respuesta.IsSuccessStatusCode)
            {
                var error = await respuesta.Content.ReadAsStringAsync();

                await Aviso(
                    $"No se pudo actualizar el perfil. {error}");

                return;
            }

            nombres = request.Nombres;
            apellidos = request.Apellidos;
            telefono = request.Telefono ?? "";

            nombre = $"{nombres} {apellidos}".Trim();

            editando = false;

            await Aviso("Perfil actualizado correctamente.");
        }
        catch (HttpRequestException)
        {
            await Aviso("No fue posible conectar con el servidor.");
        }
    }

    private void CancelarEdicion()
    {
        eNombres = nombres;
        eApellidos = apellidos;
        eTelefono = telefono;

        editando = false;
    }
    private void AbrirModal(string nombreModal)
    {
        modal = nombreModal;
        errorModal = null;
       
    }

    private void CerrarModal() => modal = null;

    
    private async Task CambiarPassword()
    {
        errorModal = null;

        if (string.IsNullOrWhiteSpace(pwActual))
        {
            errorModal = "Escribe tu contraseña actual.";
            return;
        }

        if (string.IsNullOrWhiteSpace(pwNueva) || pwNueva.Length < 8)
        {
            errorModal = "La nueva contraseña debe tener al menos 8 caracteres.";
            return;
        }

        if (pwNueva != pwConfirma)
        {
            errorModal = "Las contraseñas no coinciden.";
            return;
        }

        try
        {
            var idGuardado = await JS.InvokeAsync<string?>(
                "sessionStorage.getItem",
                "flexicar_id_usuario");

            if (!long.TryParse(idGuardado, out var idUsuario) ||
                idUsuario <= 0)
            {
                errorModal = "Tu sesión no es válida. Inicia sesión nuevamente.";
                return;
            }

            var request = new CambiarPasswordRequest
            {
                IdUsuario = idUsuario,
                PasswordActual = pwActual,
                PasswordNueva = pwNueva
            };

            var response = await Http.PutAsJsonAsync(
                "api/auth/cambiar-password",
                request);

            if (!response.IsSuccessStatusCode)
            {
                var contenido = await response.Content.ReadAsStringAsync();

                try
                {
                    using var documento =
                        System.Text.Json.JsonDocument.Parse(contenido);

                    if (documento.RootElement.TryGetProperty(
                        "mensaje", out var mensaje))
                    {
                        errorModal = mensaje.GetString()
                            ?? "No se pudo cambiar la contraseña.";
                        return;
                    }
                }
                catch (System.Text.Json.JsonException)
                {
                    // La respuesta no contenía JSON válido.
                }

                errorModal = "No se pudo cambiar la contraseña.";
                return;
            }

            pwActual = string.Empty;
            pwNueva = string.Empty;
            pwConfirma = string.Empty;

            CerrarModal();

            await Aviso("Contraseña actualizada.");
        }
        catch (HttpRequestException)
        {
            errorModal = "No se pudo conectar con el servidor.";
        }
    }



    private async Task CerrarSesion()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "flexicar_access_token");

            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "flexicar_refresh_token");

            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "flexicar_id_usuario");

            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "flexicar_nombres");

            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "flexicar_apellidos");

            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "flexicar_rol");

            await SesionAuth.ActualizarEstadoAsync();

            modal = null;

            Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Error al cerrar sesión: {ex.Message}");
        }
    }

    

    private async Task Aviso(string mensaje)
    {
        var id = ++toastId;
        toast = mensaje;
        StateHasChanged();
        await Task.Delay(2500);
        if (id == toastId) toast = null;
    }

    private async Task CargarEstadisticasAsync()
    {
        try
        {
            cargandoEstadisticas = true;

            var estadisticas =
                await Http.GetFromJsonAsync<EstadisticasCuentaDto>(
                    $"api/auth/estadisticas/{idUsuario}");

            if (estadisticas is null)
            {
                vehiculosRegistrados = 0;
                citasProximas = 0;
                serviciosCompletados = 0;
                return;
            }

            vehiculosRegistrados = estadisticas.VehiculosRegistrados;
            citasProximas = estadisticas.CitasProximas;
            serviciosCompletados = estadisticas.ServiciosCompletados;
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(
                $"Error al cargar las estadísticas: {ex.Message}");
        }
        catch (System.Text.Json.JsonException ex)
        {
            Console.WriteLine(
                $"Error al interpretar las estadísticas: {ex.Message}");
        }
        finally
        {
            cargandoEstadisticas = false;
        }
    }

}
