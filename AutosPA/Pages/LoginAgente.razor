```razor
@page "/loginAgente"
@inject NavigationManager Navigation
@inject Supabase.Client Supabase
@inject IJSRuntime JS

<PageTitle>Iniciar sesión</PageTitle>

<div class="container mt-5" style="max-width: 420px;">
    <h2 class="text-center mb-4">AutosPA</h2>
    <h4 class="text-center mb-4">Iniciar sesión</h4>

    <div class="mb-3">
        <label class="form-label">Correo electrónico</label>
        <input class="form-control" type="email" @bind="correo" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input class="form-control" type="password" @bind="contrasena" />
    </div>

    <button class="btn btn-primary w-100"
            @onclick="IniciarSesion"
            disabled="@cargando">
        @(cargando ? "Ingresando..." : "Entrar")
    </button>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <p class="mt-3">@mensaje</p>
    }
</div>

@code {
    private string correo = "";
    private string contrasena = "";
    private string mensaje = "";
    private bool cargando = false;

    private async Task IniciarSesion()
    {
        cargando = true;
        mensaje = "";

        try
        {
            await Supabase.Auth.SignIn(correo, contrasena);

            var token = Supabase.Auth.CurrentSession?.AccessToken;

            if (string.IsNullOrWhiteSpace(token))
            {
                mensaje = "No se pudo obtener el token de sesión.";
                return;
            }

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                "flexicar_token",
                token);

            mensaje = "Inicio de sesión correcto.";
            Navigation.NavigateTo("/panel-agente");
        }
        catch (Exception ex)
        {
            mensaje = "Error al iniciar sesión: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
```