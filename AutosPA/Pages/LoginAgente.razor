@page "/loginAgente"
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using AutosPALibrary.Dtos
@inject NavigationManager Navigation
@inject Supabase.Client Supabase
@inject HttpClient Http
@inject IJSRuntime JS
@inject AutosPA.Services.SessionAuthenticationStateProvider SesionAuth

<PageTitle>Iniciar sesión</PageTitle>

<div class="container mt-5" style="max-width: 420px;">
    <h2 class="text-center mb-4">AutosPA</h2>
    <h4 class="text-center mb-4">Iniciar sesión</h4>

    <div class="mb-3">
        <label class="form-label">Correo electrónico</label>
        <input class="form-control" type="email" @bind="correo" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input class="form-control" type="password" @bind="contrasena" />
    </div>

    <button class="btn btn-primary w-100"
            @onclick="IniciarSesion"
            disabled="@cargando">
        @(cargando ? "Ingresando..." : "Entrar")
    </button>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <p class="mt-3" role="alert">@mensaje</p>
    }
</div>

@code {
    private string correo = "";
    private string contrasena = "";
    private string mensaje = "";
    private bool cargando;

    private async Task IniciarSesion()
    {
        cargando = true;
        mensaje = "";

        try
        {
            using var respuesta = await Http.PostAsJsonAsync(
                "api/auth/login",
                new LoginRequest
                {
                    Email = correo.Trim(),
                    Password = contrasena
                });

            if (!respuesta.IsSuccessStatusCode)
            {
                mensaje = respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "Correo o contraseña incorrectos, o cuenta no habilitada."
                    : "No se pudo iniciar sesión. Intenta nuevamente.";
                return;
            }

            var resultado = await respuesta.Content.ReadFromJsonAsync<LoginResponse>();
            if (resultado is null || string.IsNullOrWhiteSpace(resultado.AccessToken))
            {
                mensaje = "El servidor no devolvió una sesión válida.";
                return;
            }

            if (!string.Equals(resultado.Rol?.Trim(), "AGENTE", StringComparison.OrdinalIgnoreCase))
            {
                mensaje = "Esta cuenta no tiene acceso al panel de agente.";
                return;
            }

            await Supabase.Auth.SignIn(correo.Trim(), contrasena);

            await JS.InvokeVoidAsync("sessionStorage.setItem", "flexicar_access_token", resultado.AccessToken);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "flexicar_refresh_token", resultado.RefreshToken ?? "");
            await JS.InvokeVoidAsync("sessionStorage.setItem", "flexicar_id_usuario", resultado.IdUsuario.ToString());
            await JS.InvokeVoidAsync("sessionStorage.setItem", "flexicar_nombres", resultado.Nombres ?? "");
            await JS.InvokeVoidAsync("sessionStorage.setItem", "flexicar_apellidos", resultado.Apellidos ?? "");
            await JS.InvokeVoidAsync("sessionStorage.setItem", "flexicar_email", resultado.Email ?? "");
            await JS.InvokeVoidAsync("sessionStorage.setItem", "flexicar_rol", resultado.Rol);
            await JS.InvokeVoidAsync("localStorage.removeItem", "flexicar_token");
            await JS.InvokeVoidAsync("localStorage.removeItem", "flexicar_usuario");
            await JS.InvokeVoidAsync("localStorage.removeItem", "flexicar_id_usuario");
            await JS.InvokeVoidAsync("sessionStorage.removeItem", "flexicar_usuario");
            await JS.InvokeVoidAsync("localStorage.removeItem", "flexicar_rol");

            await SesionAuth.ActualizarEstadoAsync();
            Navigation.NavigateTo("/panel-agente");
        }
        catch (HttpRequestException)
        {
            mensaje = "No se pudo conectar con el servidor.";
        }
        catch (JSException)
        {
            mensaje = "No se pudo guardar la sesión en el navegador.";
        }
        catch (System.Text.Json.JsonException)
        {
            mensaje = "El servidor devolvió una respuesta que no se pudo interpretar.";
        }
        finally
        {
            cargando = false;
        }
    }
}
