@page "/agente/perfil"
@using Radzen
@using Radzen.Blazor
@using AutosPALibrary.DTOs
@using System.Net.Http.Json
@using System.Net
@using System.Text.Json
@inject HttpClient Http

<PageTitle>FlexiCar — Mi perfil</PageTitle>

<style>
    .ag-header {
        text-align: center;
        margin: 1rem 0 2rem;
    }

    .ag-header h1 {
        font-size: 2rem;
        font-weight: 700;
        margin: 0 0 0.4rem;
    }

    .ag-header p {
        color: #667085;
        margin: 0;
    }

    .perfil-wrap {
        max-width: 600px;
        margin: 0 auto;
    }

    .perfil-top {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        margin-bottom: 1.5rem;
    }

    .perfil-avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #eeedfe;
        color: #3c3489;
        font-weight: 700;
        font-size: 1.4rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .campo {
        margin-bottom: 1.1rem;
    }

    .campo label {
        display: block;
        font-size: 0.82rem;
        color: #475467;
        margin-bottom: 0.35rem;
        font-weight: 500;
    }

    .campo input {
        width: 100%;
        border: 1px solid #e4e7ec;
        border-radius: 10px;
        padding: 0.6rem 0.8rem;
        font-size: 0.9rem;
        color: #101828;
    }

    .acciones {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
        margin-top: 1.5rem;
    }
</style>

<div class="ag-header">
    <h1>Mi perfil</h1>
    <p>Mantén tus datos personales actualizados.</p>
</div>

@if (cargando)
{
    <p style="text-align:center;">Cargando perfil...</p>
}
else
{
    <div class="perfil-wrap">
        <div class="perfil-top">
            <div class="perfil-avatar">@Iniciales</div>
            <div>
                <strong>@NombreCompleto</strong>
                <p style="margin:0; color:#667085; font-size:0.85rem;">
                    Agente de FlexiCar
                </p>
            </div>
        </div>

        <div class="campo">
            <label>Nombres</label>
            <input @bind="Nombres" />
        </div>

        <div class="campo">
            <label>Apellidos</label>
            <input @bind="Apellidos" />
        </div>

        <div class="campo">
            <label>Especialidad</label>
            <input value="No disponible en el registro" disabled />
        </div>

        <div class="campo">
            <label>Teléfono</label>
            <input @bind="Telefono" />
        </div>

        <div class="campo">
            <label>Correo</label>
            <input type="email" @bind="Correo" readonly />
            <small>El cambio del correo de acceso estará disponible cuando se pueda sincronizar con Supabase Auth.</small>
        </div>

        <div class="acciones">
            <RadzenButton Text="Guardar cambios"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@Guardar"
                          Disabled="@guardando" />
        </div>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <p style="color:@(error ? "#b42318" : "#085041"); margin-top:1rem; text-align:center;">
                @mensaje
            </p>
        }
    </div>
}

@code {
    private string Nombres = "";
    private string Apellidos = "";
    private string Telefono = "";
    private string Correo = "";

    private bool cargando = true;
    private bool guardando = false;
    private bool error = false;
    private string mensaje = "";

    private string NombreCompleto => $"{Nombres} {Apellidos}".Trim();

    private string Iniciales =>
        string.Join("", NombreCompleto
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p[0]))
        .ToUpper();

    protected override async Task OnInitializedAsync()
    {
        await CargarPerfil();
    }

    private async Task<bool> CargarPerfil(bool mostrarIndicadorCarga = true)
    {
        if (mostrarIndicadorCarga)
            cargando = true;
        error = false;

        try
        {
            using var respuesta = await Http.GetAsync("api/Agente/perfil");

            if (!respuesta.IsSuccessStatusCode)
            {
                error = true;
                mensaje = await MensajeErrorRespuestaAsync(
                    respuesta,
                    "No fue posible cargar los datos del perfil.");
                return false;
            }

            var perfil = await respuesta.Content.ReadFromJsonAsync<PerfilAgenteDTO>();
            if (perfil is null)
            {
                error = true;
                mensaje = "El servidor no devolvió los datos del perfil.";
                return false;
            }

            Nombres = perfil.Nombres;
            Apellidos = perfil.Apellidos;
            Correo = perfil.Email;
            Telefono = perfil.Telefono ?? "";
            mensaje = "";
            return true;
        }
        catch (HttpRequestException)
        {
            error = true;
            mensaje = "No se pudo conectar con el servidor para cargar el perfil.";
        }
        catch (JsonException)
        {
            error = true;
            mensaje = "La respuesta del servidor no tiene un formato válido.";
        }
        catch (TaskCanceledException)
        {
            error = true;
            mensaje = "La carga del perfil tardó demasiado. Intenta nuevamente.";
        }
        finally
        {
            if (mostrarIndicadorCarga)
                cargando = false;
        }

        return false;
    }

    private async Task Guardar()
    {
        if (guardando)
            return;

        mensaje = "";

        if (string.IsNullOrWhiteSpace(Nombres) ||
            string.IsNullOrWhiteSpace(Apellidos) ||
            string.IsNullOrWhiteSpace(Correo))
        {
            error = true;
            mensaje = "Completa los nombres, apellidos y correo.";
            return;
        }

        guardando = true;

        try
        {
            var datos = new ActualizarPerfilAgenteDTO
            {
                Nombres = Nombres,
                Apellidos = Apellidos,
                Email = Correo,
                Telefono = Telefono
            };

            using var respuesta = await Http.PutAsJsonAsync(
                "api/Agente/perfil", datos);

            if (respuesta.IsSuccessStatusCode)
            {
                var recargado = await CargarPerfil(mostrarIndicadorCarga: false);
                if (recargado)
                {
                    error = false;
                    mensaje = "Perfil actualizado correctamente.";
                }
                else
                {
                    error = true;
                    mensaje = $"Los cambios se guardaron, pero no se pudo volver a cargar el perfil. {mensaje}";
                }
            }
            else
            {
                error = true;
                mensaje = await MensajeErrorRespuestaAsync(
                    respuesta,
                    "No se pudieron guardar los cambios.");
            }
        }
        catch (HttpRequestException)
        {
            error = true;
            mensaje = "No se pudo conectar con el servidor para guardar el perfil.";
        }
        catch (JsonException)
        {
            error = true;
            mensaje = "El servidor devolvió una respuesta con formato no válido.";
        }
        catch (TaskCanceledException)
        {
            error = true;
            mensaje = "El guardado tardó demasiado. Verifica el perfil antes de volver a intentarlo.";
        }
        finally
        {
            guardando = false;
        }
    }

    private static async Task<string> MensajeErrorRespuestaAsync(
        HttpResponseMessage respuesta,
        string mensajePredeterminado)
    {
        var cuerpo = await respuesta.Content.ReadAsStringAsync();

        if (respuesta.StatusCode == HttpStatusCode.BadRequest)
        {
            var detalle = ExtraerDetalleError(cuerpo);
            return string.IsNullOrWhiteSpace(detalle)
                ? "Revisa los nombres, apellidos y correo. " + mensajePredeterminado
                : detalle;
        }

        if ((int)respuesta.StatusCode >= 500)
            return "Ocurrió un error en el servidor. Intenta nuevamente más tarde.";

        if (respuesta.StatusCode == HttpStatusCode.Conflict)
            return ExtraerDetalleError(cuerpo) ??
                   "No se pudo guardar debido a un conflicto con los datos actuales.";

        return respuesta.StatusCode switch
        {
            HttpStatusCode.Unauthorized => "Tu sesión no es válida o expiró. Inicia sesión nuevamente.",
            HttpStatusCode.Forbidden => "Tu cuenta no tiene permisos para editar este perfil.",
            HttpStatusCode.NotFound => "No se encontró el perfil del agente.",
            _ => mensajePredeterminado
        };
    }

    private static string? ExtraerDetalleError(string cuerpo)
    {
        if (string.IsNullOrWhiteSpace(cuerpo))
            return null;

        try
        {
            using var documento = JsonDocument.Parse(cuerpo);
            var raiz = documento.RootElement;

            if (raiz.ValueKind == JsonValueKind.String)
                return raiz.GetString();

            foreach (var propiedad in new[] { "mensaje", "detail", "message", "title" })
            {
                if (raiz.TryGetProperty(propiedad, out var valor) &&
                    valor.ValueKind == JsonValueKind.String)
                    return valor.GetString();
            }

            if (raiz.TryGetProperty("errors", out var errores) &&
                errores.ValueKind == JsonValueKind.Object)
            {
                var mensajes = errores.EnumerateObject()
                    .SelectMany(error => error.Value.ValueKind == JsonValueKind.Array
                        ? error.Value.EnumerateArray()
                            .Where(item => item.ValueKind == JsonValueKind.String)
                            .Select(item => item.GetString())
                        : Enumerable.Empty<string?>())
                    .Where(item => !string.IsNullOrWhiteSpace(item));

                return string.Join(" ", mensajes);
            }
        }
        catch (JsonException)
        {
            return cuerpo.TrimStart().StartsWith('<') ? null : cuerpo;
        }

        return null;
    }
}
