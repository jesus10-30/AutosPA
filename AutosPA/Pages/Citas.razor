
@page "/citas"
@page "/citas/nueva"
@using System.Globalization
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>FlexiCar — Citas</PageTitle>

<style>
    .ct-page {
        max-width: 1150px;
        margin: 0 auto;
        padding: 40px 28px 0;
    }

    .ct-head { margin-bottom: 26px; }
    .ct-eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #1f8a5b;
        margin-bottom: 8px;
    }
    .ct-head h1 {
        margin: 0 0 8px;
        font-size: clamp(32px, 4vw, 44px);
        font-weight: 700;
        color: #0f2a4a;
    }
    .ct-head p {
        margin: 0;
        max-width: 620px;
        font-size: 15px;
        line-height: 1.6;
        color: #6b7a90;
    }

    .ct-gate {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
        padding: 16px 20px;
        border-radius: 14px;
        background: #fff7e6;
        border: 1px solid #f3dca8;
        color: #7a5200;
        font-size: 14px;
    }
    .ct-gate a {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        background: #14406f;
        color: #ffffff;
        margin-left: 8px;
    }

    .ct-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
        gap: 28px;
        align-items: start;
    }
    .ct-card {
        background: #ffffff;
        border: 1px solid #e6ebf2;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 4px 16px rgba(15, 42, 74, .06);
    }
    .ct-card-title {
        margin: 0 0 6px;
        font-size: 20px;
        font-weight: 700;
        color: #0f2a4a;
    }
    .ct-step {
        padding: 22px 0 6px;
        border-top: 1px solid #eef1f6;
        margin-top: 18px;
    }
    .ct-step-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }
    .ct-step-head h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        color: #0f2a4a;
    }
    .ct-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: #14406f;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
    }
    .ct-label {
        display: block;
        margin: 12px 0 6px;
        font-size: 12px;
        font-weight: 600;
        color: #4a5a70;
    }
    .ct-input {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid #dbe3ee;
        border-radius: 10px;
        background: #f7f9fc;
        font-family: inherit;
        font-size: 14px;
        color: #0f172a;
    }
    .ct-input:focus {
        outline: 2px solid #1f5fa8;
        outline-offset: 0;
        background: #ffffff;
    }
    .ct-hint {
        margin-top: 8px;
        font-size: 12px;
        color: #6b7a90;
    }
    .ct-hint.warn { color: #9a6200; }
    .ct-lock {
        padding: 16px;
        border-radius: 12px;
        background: #f2f6fb;
        border: 1px dashed #c4d2e4;
        font-size: 13px;
        color: #4a5a70;
    }
    .ct-link {
        margin-top: 10px;
        padding: 0;
        border: 0;
        background: none;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #1a56a0;
        cursor: pointer;
    }
    .ct-link:hover { text-decoration: underline; }
    .ct-newveh {
        margin-top: 12px;
        padding: 16px;
        border-radius: 14px;
        background: #f2f6fb;
        border: 1px solid #e1e9f3;
    }
    .ct-grid2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    .ct-newveh .ct-label { margin-top: 0; }
    .ct-btn-sm {
        margin-top: 14px;
        padding: 9px 18px;
        border: 0;
        border-radius: 9px;
        background: #14406f;
        color: #ffffff;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .ct-drop {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 18px;
        border: 1.5px dashed #b7c7dc;
        border-radius: 14px;
        background: #fbfcfe;
        text-align: center;
        font-size: 13px;
        color: #4a5a70;
        cursor: pointer;
        transition: background .2s, border-color .2s;
    }
    .ct-drop:hover {
        background: #f2f6fb;
        border-color: #1f5fa8;
    }
    .ct-drop svg {
        width: 26px;
        height: 26px;
        fill: none;
        stroke: #1a56a0;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .ct-drop b { color: #14406f; }
    .ct-drop small { color: #8492a6; font-size: 11px; }
    .ct-file { display: none; }
    .ct-files {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .ct-file-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 10px;
        background: #f2f6fb;
        font-size: 12px;
        color: #334155;
    }
    .ct-file-row small { color: #8492a6; margin-left: 8px; }
    .ct-file-row button {
        border: 0;
        background: none;
        color: #b42318;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

    .ct-services {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }
    .ct-service {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 12px 14px;
        border: 1.5px solid #e1e9f3;
        border-radius: 12px;
        background: #ffffff;
        text-align: left;
        font-family: inherit;
        cursor: pointer;
        transition: border-color .15s, background .15s;
    }
    .ct-service:hover { border-color: #9db8d9; }
    .ct-service.sel {
        border-color: #14406f;
        background: #eef4fb;
    }
    .ct-service-name {
        font-size: 13px;
        font-weight: 600;
        color: #0f2a4a;
    }
    .ct-service-meta { font-size: 11px; color: #6b7a90; }

    .ct-agents {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 4px;
    }
    .ct-agent {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1.5px solid #e1e9f3;
        border-radius: 12px;
        background: #ffffff;
        text-align: left;
        font-family: inherit;
        cursor: pointer;
        transition: border-color .15s, background .15s;
    }
    .ct-agent:hover:not(:disabled) { border-color: #9db8d9; }
    .ct-agent.sel {
        border-color: #14406f;
        background: #eef4fb;
    }
    .ct-agent:disabled { opacity: .5; cursor: not-allowed; }
    .ct-avatar {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #14406f, #1f8a5b);
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
    }
    .ct-ag-name {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #0f2a4a;
    }
    .ct-ag-role { display: block; font-size: 11px; color: #6b7a90; }
    .ct-ag-free {
        display: block;
        margin-top: 2px;
        font-size: 11px;
        font-weight: 600;
        color: #146c43;
    }
    .ct-ag-free.none { color: #b42318; }
    .ct-tag-esp {
        display: inline-block;
        margin-left: 6px;
        padding: 1px 8px;
        border-radius: 999px;
        background: #e3f5ec;
        color: #146c43;
        font-size: 10px;
        font-weight: 700;
    }

    .ct-slots {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
    }
    .ct-slot {
        padding: 9px 14px;
        border: 1.5px solid #dbe3ee;
        border-radius: 10px;
        background: #ffffff;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #0f2a4a;
        cursor: pointer;
        transition: border-color .15s, background .15s;
    }
    .ct-slot:hover:not(:disabled) { border-color: #14406f; }
    .ct-slot.sel {
        background: #14406f;
        border-color: #14406f;
        color: #ffffff;
    }
    .ct-slot:disabled {
        background: #f2f4f8;
        color: #aab4c3;
        text-decoration: line-through;
        cursor: not-allowed;
    }

    .ct-est {
        margin-top: 24px;
        padding: 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, #eef4fb, #f1f9f5);
        border: 1px solid #dbe7f3;
    }
    .ct-est-title {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #1a56a0;
        margin-bottom: 12px;
    }
    .ct-est-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }
    .ct-est-grid small {
        display: block;
        font-size: 12px;
        color: #6b7a90;
    }
    .ct-est-grid b { font-size: 22px; color: #0f2a4a; }
    .ct-est-note {
        margin-top: 10px;
        font-size: 12px;
        line-height: 1.5;
        color: #4a5a70;
    }
    .ct-error {
        margin-top: 16px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #fdecea;
        color: #b42318;
        font-size: 13px;
    }
    .ct-confirm {
        width: 100%;
        margin-top: 18px;
        padding: 15px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(90deg, #14406f, #1f5fa8);
        color: #ffffff;
        font-family: inherit;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }
    .ct-confirm:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(20, 64, 111, .3);
    }
    .ct-confirm:disabled { opacity: .5; cursor: not-allowed; }

    .ct-side { position: sticky; top: 92px; }
    .ct-tabs { display: flex; gap: 8px; margin-bottom: 14px; }
    .ct-tab {
        padding: 8px 16px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #6b7a90;
        cursor: pointer;
    }
    .ct-tab.active { background: #14406f; color: #ffffff; }
    .ct-tab span { margin-left: 6px; opacity: .8; }
    .ct-cita {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 12px;
        padding: 16px;
        background: #ffffff;
        border: 1px solid #e6ebf2;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(15, 42, 74, .05);
    }
    .ct-date {
        flex-shrink: 0;
        width: 52px;
        padding: 8px 0;
        border-radius: 12px;
        background: #eef4fb;
        text-align: center;
    }
    .ct-date b {
        display: block;
        font-size: 20px;
        line-height: 1.1;
        color: #14406f;
    }
    .ct-date span {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #6b7a90;
    }
    .ct-info { flex: 1; min-width: 0; }
    .ct-info h4 {
        margin: 0 0 4px;
        font-size: 14px;
        font-weight: 600;
        color: #0f172a;
    }
    .ct-sub { font-size: 12px; line-height: 1.5; color: #6b7a90; }
    .ct-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
    }
    .ct-status {
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }
    .ct-status.aprobada { background: #e3f5ec; color: #146c43; }
    .ct-status.espera { background: #fdf1dc; color: #9a6200; }
    .ct-status.finalizada { background: #eceff4; color: #5b6778; }
    .ct-status.cancelada { background: #fdecea; color: #b42318; }
    .ct-cancel {
        border: 0;
        background: none;
        font-family: inherit;
        font-size: 12px;
        font-weight: 600;
        color: #b42318;
        cursor: pointer;
    }
    .ct-cancel:hover { text-decoration: underline; }
    .ct-empty {
        padding: 28px;
        border: 1px dashed #c4d2e4;
        border-radius: 16px;
        text-align: center;
        font-size: 13px;
        color: #6b7a90;
    }
    .ct-note {
        margin-top: 16px;
        padding: 14px 16px;
        border-radius: 14px;
        background: #f2f6fb;
        font-size: 12px;
        line-height: 1.6;
        color: #4a5a70;
    }

    .ct-modal-bg {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(10, 30, 60, .55);
    }
    .ct-modal {
        width: 100%;
        max-width: 440px;
        padding: 32px 30px 28px;
        border-radius: 22px;
        background: #ffffff;
        text-align: center;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
    }
    .ct-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        margin-bottom: 14px;
        border-radius: 50%;
        background: #e3f5ec;
    }
    .ct-check svg {
        width: 30px;
        height: 30px;
        fill: none;
        stroke: #146c43;
        stroke-width: 2.4;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .ct-modal h3 { margin: 0 0 6px; font-size: 21px; color: #0f2a4a; }
    .ct-modal > p {
        margin: 0 0 18px;
        font-size: 13px;
        line-height: 1.6;
        color: #6b7a90;
    }
    .ct-resumen {
        margin-bottom: 20px;
        padding: 14px 16px;
        border-radius: 14px;
        background: #f2f6fb;
        text-align: left;
    }
    .ct-resumen div {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 4px 0;
        font-size: 13px;
        color: #334155;
    }
    .ct-resumen span { color: #6b7a90; }
    .ct-resumen b { text-align: right; color: #0f2a4a; }

    @@media (max-width: 1000px) {
        .ct-layout { grid-template-columns: 1fr; }
        .ct-side { position: static; }
    }
    @@media (max-width: 600px) {
        .ct-page { padding: 28px 14px 0; }
        .ct-card { padding: 20px; }
        .ct-services, .ct-agents, .ct-grid2 { grid-template-columns: 1fr; }
    }
</style>

<div class="ct-page">
    <header class="ct-head">
        <div class="ct-eyebrow">Agenda tu mantenimiento</div>
        <h1>Citas</h1>
        <p>Elige tu vehículo, el servicio, el agente y el horario. Calculamos el costo y el tiempo estimado en tiempo real.</p>
    </header>

    @if (!sesionIniciada)
    {
        <div class="ct-gate">
            <span>Para agendar una cita debes iniciar sesión: así puedes registrar tu vehículo y ver más detalles.</span>
            <span>
                <a href="/login">Iniciar sesión</a>
                <a href="/registro">Regístrate</a>
            </span>
        </div>

        <div class="ct-lock">
            Inicia sesión para consultar tus vehículos, registrar citas y revisar tu historial.
        </div>
    }
    else
    {
        <div class="ct-layout">
            <section class="ct-card">
                <h2 class="ct-card-title">Nueva cita</h2>

                <div class="ct-step" style="border-top:0; margin-top:10px;">
                    <div class="ct-step-head">
                        <span class="ct-num">1</span>
                        <h3>Vehículo y conductor</h3>
                    </div>

                    @if (vehiculos.Any())
                    {
                        <label class="ct-label">Vehículo</label>
                        <select class="ct-input" @bind="vehiculoId">
                            @foreach (var v in vehiculos)
                            {
                                <option value="@v.Id">@v.Etiqueta</option>
                            }
                        </select>

                        @if (VehiculoActual is not null)
                        {
                            <div class="ct-hint">
                                Conductor: @VehiculoActual.Conductor · Licencia: @VehiculoActual.Licencia
                            </div>
                        }
                    }
                    else
                    {
                        <div class="ct-lock">
                            No tienes vehículos registrados. Registra uno desde Mis vehículos antes de agendar.
                        </div>
                    }

                    <button type="button" class="ct-link" @onclick="() => mostrarNuevoVehiculo = !mostrarNuevoVehiculo">
                        @(mostrarNuevoVehiculo ? "Cancelar registro" : "+ Registrar otro vehículo")
                    </button>

                    @if (mostrarNuevoVehiculo)
                    {
                        <div class="ct-newveh">
                            <div class="ct-grid2">
                                <div>
                                    <label class="ct-label">Marca</label>
                                    <input class="ct-input" @bind="nvMarca" placeholder="Toyota" />
                                </div>
                                <div>
                                    <label class="ct-label">Modelo</label>
                                    <input class="ct-input" @bind="nvModelo" placeholder="Corolla" />
                                </div>
                                <div>
                                    <label class="ct-label">Año</label>
                                    <input class="ct-input" @bind="nvAnio" placeholder="2020" />
                                </div>
                                <div>
                                    <label class="ct-label">Placa</label>
                                    <input class="ct-input" @bind="nvPlaca" placeholder="P 000 ABC" />
                                </div>
                                <div>
                                    <label class="ct-label">Conductor</label>
                                    <input class="ct-input" @bind="nvConductor" placeholder="Nombre completo" />
                                </div>
                                <div>
                                    <label class="ct-label">Licencia</label>
                                    <input class="ct-input" @bind="nvLicencia" placeholder="No. de licencia" />
                                </div>
                            </div>

                            @if (errorVehiculo is not null)
                            {
                                <div class="ct-hint warn">@errorVehiculo</div>
                            }

                            <button type="button" class="ct-btn-sm" @onclick="GuardarVehiculo">
                                Guardar vehículo
                            </button>
                        </div>
                    }

                    <label class="ct-label">Documentos del vehículo</label>
                    <label class="ct-drop">
                        <InputFile OnChange="OnArchivos" multiple accept=".pdf,.jpg,.jpeg,.png" class="ct-file" />
                        <svg viewBox="0 0 24 24">
                            <path d="M12 16V4M7 9l5-5 5 5" />
                            <path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" />
                        </svg>
                        <span><b>Cargar documentos</b> — seguro, inspección o tarjeta de circulación</span>
                        <small>PDF, JPG o PNG · máx. 5 MB por archivo</small>
                    </label>

                    @if (errorArchivo is not null)
                    {
                        <div class="ct-hint warn">@errorArchivo</div>
                    }

                    @if (archivos.Any())
                    {
                        <div class="ct-files">
                            @foreach (var a in archivos)
                            {
                                <div class="ct-file-row">
                                    <span>@a.Nombre<small>@a.Tamano</small></span>
                                    <button type="button" @onclick="() => archivos.Remove(a)">Quitar</button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="ct-step">
                    <div class="ct-step-head">
                        <span class="ct-num">2</span>
                        <h3>Tipo de mantenimiento</h3>
                    </div>

                    <div class="ct-services">
                        @foreach (var s in servicios)
                        {
                            <button type="button"
                                    class="ct-service @(s.Id == servicioId ? "sel" : "")"
                                    @onclick="() => servicioId = s.Id">
                                <span class="ct-service-name">@s.Nombre</span>
                                <span class="ct-service-meta">
                                    @TextoCosto(s.CostoMin, s.CostoMax, 1.0) · @TextoTiempo(s.TiempoMin, s.TiempoMax, 1.0)
                                </span>
                            </button>
                        }
                    </div>
                </div>

                <div class="ct-step">
                    <div class="ct-step-head">
                        <span class="ct-num">3</span>
                        <h3>Fecha, agente y hora</h3>
                    </div>

                    <label class="ct-label" style="margin-top:0;">Fecha</label>
                    <input type="date" class="ct-input" min="@HoyIso" value="@FechaIso" @onchange="OnFecha" />

                    <label class="ct-label">Agente (según disponibilidad ese día)</label>
                    <div class="ct-agents">
                        <button type="button"
                                class="ct-agent @(agenteSel is null ? "sel" : "")"
                                @onclick="() => SeleccionarAgente(null)">
                            <span class="ct-avatar">★</span>
                            <span>
                                <span class="ct-ag-name">Cualquiera disponible</span>
                                <span class="ct-ag-role">Asignamos al mejor agente libre</span>
                            </span>
                        </button>

                        @foreach (var a in agentes)
                        {
                            var libres = HorariosLibres(a);

                            <button type="button"
                                    class="ct-agent @(agenteSel == a ? "sel" : "")"
                                    disabled="@(libres == 0)"
                                    @onclick="() => SeleccionarAgente(a)">
                                <span class="ct-avatar">@a.Iniciales</span>
                                <span>
                                    <span class="ct-ag-name">
                                        @a.Nombre
                                        @if (EsEspecialista(a))
                                        {
                                            <span class="ct-tag-esp">Especialista</span>
                                        }
                                    </span>
                                    <span class="ct-ag-role">@a.Especialidad</span>
                                    <span class="ct-ag-free @(libres == 0 ? "none" : "")">
                                        @(libres == 0 ? "Sin horarios ese día" : $"{libres} horarios libres")
                                    </span>
                                </span>
                            </button>
                        }
                    </div>

                    <label class="ct-label">Hora</label>
                    @if (fecha.DayOfWeek == DayOfWeek.Sunday)
                    {
                        <div class="ct-hint warn">El taller no atiende los domingos. Elige otra fecha.</div>
                    }
                    else
                    {
                        <div class="ct-slots">
                            @foreach (var h in HorasTaller(fecha))
                            {
                                var libre = HoraDisponible(h);

                                <button type="button"
                                        class="ct-slot @(hora == h ? "sel" : "")"
                                        disabled="@(!libre)"
                                        @onclick="() => hora = h">
                                    @FormatoHora(h)
                                </button>
                            }
                        </div>
                        <div class="ct-hint">
                            Los horarios tachados ya están ocupados o el agente no atiende en ese momento.
                        </div>
                    }
                </div>

                @{
                    var est = Estimacion;
                }

                <div class="ct-est">
                    <div class="ct-est-title">Estimación en tiempo real</div>
                    <div class="ct-est-grid">
                        <div><small>Tiempo estimado</small><b>@est.Tiempo</b></div>
                        <div><small>Costo estimado</small><b>@est.Costo</b></div>
                    </div>
                    <div class="ct-est-note">@est.Recomendacion</div>
                    <div class="ct-est-note">@NotaAgente()</div>
                </div>

                @if (error is not null)
                {
                    <div class="ct-error">@error</div>
                }

                @if (errorCarga is not null)
                {
                    <div class="ct-error">@errorCarga</div>
                }

                <button type="button"
                        class="ct-confirm"
                        disabled="@(!sesionIniciada || vehiculos.Count == 0)"
                        @onclick="ConfirmarCita">
                    Confirmar cita
                </button>
            </section>

            <aside class="ct-side">
                <div class="ct-tabs">
                    <button type="button"
                            class="ct-tab @(mostrarProximas ? "active" : "")"
                            @onclick="() => mostrarProximas = true">
                        Próximas<span>@Proximas.Count()</span>
                    </button>
                    <button type="button"
                            class="ct-tab @(!mostrarProximas ? "active" : "")"
                            @onclick="() => mostrarProximas = false">
                        Historial<span>@Historial.Count()</span>
                    </button>
                </div>

                @foreach (var c in CitasVisibles)
                {
                    <div class="ct-cita">
                        <div class="ct-date">
                            <b>@c.Fecha.Day</b>
                            <span>@Mes(c.Fecha)</span>
                        </div>
                        <div class="ct-info">
                            <h4>@c.Servicio</h4>
                            <div class="ct-sub">@c.Vehiculo</div>
                            <div class="ct-sub">@FormatoHora(c.Hora) · Agente: @c.Agente</div>
                            <div class="ct-sub">@c.Costo · @c.Tiempo</div>
                        </div>
                        <div class="ct-right">
                            <span class="ct-status @ClaseEstado(c.Estado)">@c.Estado</span>
                            @if (c.Estado == "En espera")
                            {
                                <button type="button" class="ct-cancel" @onclick="() => Cancelar(c)">
                                    Cancelar
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (!CitasVisibles.Any())
                {
                    <div class="ct-empty">
                        No tienes citas @(mostrarProximas ? "próximas" : "en el historial") todavía.
                    </div>
                }

                <div class="ct-note">
                    <b>¿Cómo funciona?</b><br />
                    Al confirmar, la cita queda <b>En espera</b>. El taller revisará tu solicitud y, cuando la apruebe, pasará a <b>Aprobada</b>. Te avisaremos cuando haya una actualización.
                </div>
            </aside>
        </div>
    }
</div>

@if (confirmada is not null)
{
    <div class="ct-modal-bg" @onclick="() => confirmada = null">
        <div class="ct-modal" @onclick:stopPropagation="true">
            <div class="ct-check">
                <svg viewBox="0 0 24 24">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
            </div>
            <h3>¡Cita registrada!</h3>
            <p>
                Tu solicitud de cita fue registrada correctamente y aparece en tu lista como
                <strong>En espera</strong>. El taller revisará tu solicitud y asignará un agente.
            </p>

            <div class="ct-resumen">
                <div><span>Servicio</span><b>@confirmada.Servicio</b></div>
                <div><span>Vehículo</span><b>@confirmada.Vehiculo</b></div>
                <div><span>Fecha</span><b>@FechaLarga(confirmada.Fecha)</b></div>
                <div><span>Hora</span><b>@FormatoHora(confirmada.Hora)</b></div>
                <div><span>Agente</span><b>@confirmada.Agente</b></div>
                <div><span>Costo aprox.</span><b>@confirmada.Costo</b></div>
                <div><span>Tiempo aprox.</span><b>@confirmada.Tiempo</b></div>
            </div>

            <button type="button"
                    class="ct-confirm"
                    style="margin-top:0;"
                    @onclick="() => confirmada = null">
                Entendido
            </button>
        </div>
    </div>
}

@code {
    private bool sesionIniciada;
    private bool cargando = true;
    private long idUsuario;

    [SupplyParameterFromQuery(Name = "servicio")]
    public int? ServicioQuery { get; set; }

    private record Servicio(long Id, string Nombre, string Categoria, int CostoMin, int? CostoMax, int? TiempoMin, int? TiempoMax);
    private record Agente(string Nombre, string Iniciales, string Especialidad, string[] Categorias, double Tarifa, DayOfWeek[] DiasLibres, int[] HorasBloqueadas);
    private record Estim(string Costo, string Tiempo, string Recomendacion);
    private record ArchivoDto(string Nombre, string Tamano);

    private class ApiVehiculo
    {
        public long IdVehiculo { get; set; }
        public string Marca { get; set; } = "";
        public string Modelo { get; set; } = "";
        public int Anio { get; set; }
        public string Placa { get; set; } = "";
    }

    private class VehiculoDto
    {
        public long Id { get; set; }
        public string Marca { get; set; } = "";
        public string Modelo { get; set; } = "";
        public string Anio { get; set; } = "";
        public string Placa { get; set; } = "";
        public string Conductor { get; set; } = "—";
        public string Licencia { get; set; } = "—";
        public string Etiqueta => $"{Marca} {Modelo} — {Placa}";
    }

    private class ApiServicio
    {
        public long Id { get; set; }
        public string Nombre { get; set; } = "";
        public string? Descripcion { get; set; }
        public decimal CostoBase { get; set; }
        public int TiempoEstimadoMinutos { get; set; }
    }

    private class ApiCita
    {
        public long IdCita { get; set; }
        public long IdVehiculo { get; set; }
        public string Placa { get; set; } = "";
        public string ModeloVehiculo { get; set; } = "";
        public string Servicio { get; set; } = "";
        public string Estado { get; set; } = "";
        public DateOnly FechaCita { get; set; }
        public TimeOnly HoraInicio { get; set; }
        public decimal Costo { get; set; }
        public int TiempoEstimadoMinutos { get; set; }
    }

    private class CitaDto
    {
        public long IdCita { get; set; }
        public DateTime Fecha { get; set; }
        public TimeOnly Hora { get; set; }
        public string Vehiculo { get; set; } = "";
        public string Servicio { get; set; } = "";
        public string Agente { get; set; } = "Por asignar";
        public string Estado { get; set; } = "";
        public string Costo { get; set; } = "";
        public string Tiempo { get; set; } = "";
    }

    private List<Servicio> servicios = new();
    private List<Agente> agentes = new();
    private List<VehiculoDto> vehiculos = new();
    private List<CitaDto> citas = new();

    private long vehiculoId;
    private long servicioId;
    private DateTime fecha = DateTime.Today.AddDays(1);
    private Agente? agenteSel;
    private TimeOnly? hora;
    private string? error;
    private string? errorCarga;
    private CitaDto? confirmada;
    private bool mostrarProximas = true;

    private bool mostrarNuevoVehiculo;
    private string nvMarca = "", nvModelo = "", nvAnio = "", nvPlaca = "", nvConductor = "", nvLicencia = "";
    private string? errorVehiculo;

    private List<ArchivoDto> archivos = new();
    private string? errorArchivo;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Buscar el token en localStorage.
            var token = await JS.InvokeAsync<string?>(
                "localStorage.getItem", "flexicar_token");

            // Si no está en localStorage, buscarlo en sessionStorage.
            if (string.IsNullOrWhiteSpace(token))
            {
                token = await JS.InvokeAsync<string?>(
                    "sessionStorage.getItem", "flexicar_token");
            }

            // Buscar el identificador del usuario en localStorage.
            var usuarioGuardado = await JS.InvokeAsync<string?>(
                "localStorage.getItem", "flexicar_usuario");

            // Si no está en localStorage, buscarlo en sessionStorage.
            if (string.IsNullOrWhiteSpace(usuarioGuardado))
            {
                usuarioGuardado = await JS.InvokeAsync<string?>(
                    "sessionStorage.getItem", "flexicar_usuario");
            }

            // La sesión requiere tanto token como identificador de usuario.
            if (string.IsNullOrWhiteSpace(token) ||
                !long.TryParse(usuarioGuardado, out idUsuario))
            {
                sesionIniciada = false;
                idUsuario = 0;
                return;
            }

            sesionIniciada = true;

            await CargarVehiculos();
            await CargarServicios();
            await CargarCitas();

            if (vehiculos.Any())
                vehiculoId = vehiculos.First().Id;

            if (servicios.Any())
                servicioId = servicios.First().Id;

            if (ServicioQuery is int id && servicios.Any(s => s.Id == id))
                servicioId = id;

            if (fecha.DayOfWeek == DayOfWeek.Sunday)
                fecha = fecha.AddDays(1);
        }
        catch (HttpRequestException)
        {
            errorCarga = "No se pudo conectar con el servidor.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorCarga = "El servidor devolvió información que no se pudo interpretar.";
        }
        catch (Microsoft.JSInterop.JSException)
        {
            errorCarga = "No se pudo leer la sesión. Inicia sesión nuevamente.";
            sesionIniciada = false;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarVehiculos()
    {
        var datos = await Http.GetFromJsonAsync<List<ApiVehiculo>>(
            $"api/Vehiculos/usuario/{idUsuario}") ?? new();

        vehiculos = datos.Select(v => new VehiculoDto
        {
            Id = v.IdVehiculo,
            Marca = v.Marca,
            Modelo = v.Modelo,
            Anio = v.Anio.ToString(),
            Placa = v.Placa
        }).ToList();
    }

    private async Task CargarServicios()
    {
        var datos = await Http.GetFromJsonAsync<List<ApiServicio>>(
            "api/Servicios") ?? new();

        servicios = datos.Select(s => new Servicio(
            s.Id,
            s.Nombre,
            ObtenerCategoria(s.Nombre),
            (int)Math.Round(s.CostoBase),
            null,
            s.TiempoEstimadoMinutos,
            s.TiempoEstimadoMinutos
        )).ToList();
    }

    private async Task CargarCitas()
    {
        var datos = await Http.GetFromJsonAsync<List<ApiCita>>(
            $"api/Citas/cliente/{idUsuario}") ?? new();

        citas = datos.Select(c => new CitaDto
        {
            IdCita = c.IdCita,
            Fecha = c.FechaCita.ToDateTime(TimeOnly.MinValue),
            Hora = c.HoraInicio,
            Vehiculo = $"{c.ModeloVehiculo} — {c.Placa}",
            Servicio = c.Servicio,
            Agente = "Por asignar",
            Estado = NormalizarEstado(c.Estado),
            Costo = $"Q{c.Costo:N2}",
            Tiempo = $"{c.TiempoEstimadoMinutos} min"
        }).ToList();
    }

    private static string ObtenerCategoria(string nombre)
    {
        if (nombre.Contains("diagnóstico", StringComparison.OrdinalIgnoreCase))
            return "Diagnóstico";

        if (nombre.Contains("reparación", StringComparison.OrdinalIgnoreCase) ||
            nombre.Contains("frenos", StringComparison.OrdinalIgnoreCase))
            return "Reparación";

        if (nombre.Contains("componente", StringComparison.OrdinalIgnoreCase))
            return "Componentes";

        return "Mantenimiento";
    }

    private static string NormalizarEstado(string estado)
    {
        if (estado.Equals("PENDIENTE", StringComparison.OrdinalIgnoreCase))
            return "En espera";

        if (estado.Equals("CONFIRMADA", StringComparison.OrdinalIgnoreCase))
            return "Aprobada";

        if (estado.Equals("FINALIZADA", StringComparison.OrdinalIgnoreCase))
            return "Finalizada";

        if (estado.Equals("CANCELADA", StringComparison.OrdinalIgnoreCase))
            return "Cancelada";

        return estado;
    }

    private VehiculoDto? VehiculoActual =>
        vehiculos.FirstOrDefault(v => v.Id == vehiculoId);

    private Servicio ServicioActual =>
        servicios.FirstOrDefault(s => s.Id == servicioId)
        ?? new Servicio(0, "Selecciona un servicio", "", 0, 0, 0, 0);

    private string HoyIso => DateTime.Today.ToString("yyyy-MM-dd");
    private string FechaIso => fecha.ToString("yyyy-MM-dd");

    private Estim Estimacion => Calcular(ServicioActual, agenteSel);

    private IEnumerable<CitaDto> Proximas =>
        citas.Where(c => c.Estado == "Aprobada" || c.Estado == "En espera")
            .OrderBy(c => c.Fecha).ThenBy(c => c.Hora);

    private IEnumerable<CitaDto> Historial =>
        citas.Where(c => c.Estado == "Finalizada" || c.Estado == "Cancelada")
            .OrderByDescending(c => c.Fecha);

    private IEnumerable<CitaDto> CitasVisibles =>
        mostrarProximas ? Proximas : Historial;

    private static readonly int[] HorasBase = { 8, 9, 10, 11, 14, 15, 16, 17 };

    private IEnumerable<TimeOnly> HorasTaller(DateTime f)
    {
        if (f.DayOfWeek == DayOfWeek.Sunday)
            return Enumerable.Empty<TimeOnly>();

        var horas = f.DayOfWeek == DayOfWeek.Saturday
            ? HorasBase.Where(h => h < 13)
            : HorasBase;

        return horas.Select(h => new TimeOnly(h, 0));
    }

    private bool HoraDisponible(TimeOnly h) =>
        !citas.Any(c =>
            c.Fecha.Date == fecha.Date &&
            c.Hora == h &&
            (c.Estado == "Aprobada" || c.Estado == "En espera"));

    private int HorariosLibres(Agente a) =>
        HorasTaller(fecha).Count(HoraDisponible);

    private bool AgenteLibreEn(Agente a, DateTime f, TimeOnly h) =>
        HoraDisponible(h);

    private bool EsEspecialista(Agente a) =>
        a.Categorias.Contains(ServicioActual.Categoria);

    private void OnFecha(ChangeEventArgs e)
    {
        if (DateTime.TryParse(
            e.Value?.ToString(),
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out var d))
        {
            fecha = d.Date;

            if (hora is not null && !HoraDisponible(hora.Value))
                hora = null;
        }
    }

    private void SeleccionarAgente(Agente? a)
    {
        agenteSel = a;

        if (hora is not null && !HoraDisponible(hora.Value))
            hora = null;
    }

    private void GuardarVehiculo()
    {
        errorVehiculo = "Registra tu vehículo desde la sección Mis vehículos. Esta pantalla todavía no guarda vehículos en el servidor.";
    }

    private void OnArchivos(InputFileChangeEventArgs e)
    {
        errorArchivo = null;

        foreach (var f in e.GetMultipleFiles(10))
        {
            if (f.Size > 5 * 1024 * 1024)
            {
                errorArchivo = $"\"{f.Name}\" supera los 5 MB.";
                continue;
            }

            archivos.Add(new ArchivoDto(f.Name, FormatoTamano(f.Size)));
        }
    }

    private async Task ConfirmarCita()
    {
        error = null;

        if (!sesionIniciada)
        {
            error = "Inicia sesión para agendar tu cita.";
            return;
        }

        if (VehiculoActual is null)
        {
            error = "Selecciona un vehículo registrado.";
            return;
        }

        if (ServicioActual.Id == 0)
        {
            error = "Selecciona un servicio.";
            return;
        }

        if (fecha.Date < DateTime.Today)
        {
            error = "La fecha de la cita no puede estar en el pasado.";
            return;
        }

        if (fecha.DayOfWeek == DayOfWeek.Sunday)
        {
            error = "El taller no atiende los domingos.";
            return;
        }

        if (hora is null)
        {
            error = "Elige un horario.";
            return;
        }

        if (!HoraDisponible(hora.Value))
        {
            error = "Ese horario ya aparece ocupado. Elige otro.";
            hora = null;
            return;
        }

        try
        {
            var respuesta = await Http.PostAsJsonAsync(
                $"api/Citas/cliente/{idUsuario}",
                new
                {
                    idVehiculo = vehiculoId,
                    idTipoServicio = servicioId,
                    fechaCita = DateOnly.FromDateTime(fecha),
                    horaInicio = hora.Value,
                    observaciones = (string?)null
                });

            if (!respuesta.IsSuccessStatusCode)
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                error = $"No se pudo registrar la cita. {detalle}";
                return;
            }

            var guardada = await respuesta.Content.ReadFromJsonAsync<ApiCita>();

            if (guardada is null)
            {
                error = "El servidor guardó la cita, pero no devolvió sus datos.";
                return;
            }

            confirmada = new CitaDto
            {
                IdCita = guardada.IdCita,
                Fecha = guardada.FechaCita.ToDateTime(TimeOnly.MinValue),
                Hora = guardada.HoraInicio,
                Vehiculo = $"{guardada.ModeloVehiculo} — {guardada.Placa}",
                Servicio = guardada.Servicio,
                Agente = "Por asignar",
                Estado = NormalizarEstado(guardada.Estado),
                Costo = $"Q{guardada.Costo:N2}",
                Tiempo = $"{guardada.TiempoEstimadoMinutos} min"
            };

            await CargarCitas();

            mostrarProximas = true;
            hora = null;
            archivos.Clear();
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
        catch (System.Text.Json.JsonException)
        {
            error = "No se pudo interpretar la respuesta del servidor.";
        }
    }

    private async Task Cancelar(CitaDto c)
    {
        error = null;

        try
        {
            var respuesta = await Http.DeleteAsync(
                $"api/Citas/cliente/{idUsuario}/{c.IdCita}");

            if (!respuesta.IsSuccessStatusCode)
            {
                error = "No se pudo cancelar la cita. Verifica que todavía pueda cancelarse.";
                return;
            }

            await CargarCitas();
            error = "La cita se canceló correctamente.";
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
    }

    private Estim Calcular(Servicio s, Agente? a)
    {
        var costo = $"Q{s.CostoMin:N2}";
        var tiempo = s.TiempoMin is null
            ? "Por determinar"
            : FormatoMin(s.TiempoMin.Value);

        return new Estim(
            costo,
            tiempo,
            "El costo y el tiempo definitivos se calculan y guardan al registrar la cita.");
    }

    private string NotaAgente() =>
        "El agente será asignado por el taller después de registrar la cita.";

    private static int Redondear5(double x) =>
        (int)(Math.Round(x / 5.0, MidpointRounding.AwayFromZero) * 5);

    private static string TextoCosto(int min, int? max, double factor)
    {
        var a = Redondear5(min * factor);

        if (max is null)
            return $"Desde Q{a}";

        var b = Redondear5(max.Value * factor);
        return a == b ? $"Q{a}" : $"Q{a}–Q{b}";
    }

    private static string FormatoMin(int m)
    {
        if (m < 60)
            return $"{m} min";

        return m % 60 == 0
            ? $"{m / 60} h"
            : $"{m / 60} h {m % 60} min";
    }

    private static string TextoTiempo(int? min, int? max, double factor)
    {
        if (min is null || max is null)
            return "Según la pieza";

        var a = Redondear5(min.Value * factor);
        var b = Redondear5(max.Value * factor);

        if (a == b)
            return FormatoMin(a);

        if (b < 60)
            return $"{a}–{b} min";

        return $"{FormatoMin(a)} – {FormatoMin(b)}";
    }

    private static readonly string[] MesesCortos =
        { "ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic" };

    private static readonly string[] MesesLargos =
        { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre" };

    private static readonly string[] DiasSemana =
        { "domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado" };

    private static string Mes(DateTime f) => MesesCortos[f.Month - 1];

    private static string FechaLarga(DateTime f) =>
        $"{DiasSemana[(int)f.DayOfWeek]} {f.Day} de {MesesLargos[f.Month - 1]}";

    private static string FormatoHora(TimeOnly h)
    {
        var h12 = h.Hour % 12 == 0 ? 12 : h.Hour % 12;
        return $"{h12}:{h.Minute:00} {(h.Hour < 12 ? "a. m." : "p. m.")}";
    }

    private static string FormatoTamano(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024.0 / 1024.0:0.0} MB"
            : $"{Math.Max(1, bytes / 1024)} KB";

    private static string ClaseEstado(string estado) => estado switch
    {
        "Aprobada" => "aprobada",
        "En espera" => "espera",
        "Cancelada" => "cancelada",
        _ => "finalizada"
    };
}
