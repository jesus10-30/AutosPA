@page "/citas"
@page "/citas/nueva"

@using System.Globalization
@using System.Net.Http.Json
@using AutosPALibrary.Dtos
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>FlexiCar — Citas</PageTitle>

<style>
    .ct-page {
        max-width: 1150px;
        margin: 0 auto;
        padding: 40px 28px 0;
    }

    .ct-head {
        margin-bottom: 26px;
    }

    .ct-eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #1f8a5b;
        margin-bottom: 8px;
    }

    .ct-head h1 {
        margin: 0 0 8px;
        font-size: clamp(32px,4vw,44px);
        font-weight: 700;
        color: #0f2a4a;
    }

    .ct-head p {
        margin: 0;
        max-width: 620px;
        font-size: 15px;
        line-height: 1.6;
        color: #6b7a90;
    }

    .ct-gate {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
        padding: 16px 20px;
        border-radius: 14px;
        background: #fff7e6;
        border: 1px solid #f3dca8;
        color: #7a5200;
        font-size: 14px;
    }

        .ct-gate a {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            background: #14406f;
            color: #fff;
            margin-left: 8px;
        }

    .ct-layout {
        display: grid;
        grid-template-columns: minmax(0,1.3fr) minmax(0,1fr);
        gap: 28px;
        align-items: start;
    }

    .ct-card {
        background: #fff;
        border: 1px solid #e6ebf2;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 4px 16px rgba(15,42,74,.06);
    }

    .ct-card-title {
        margin: 0 0 6px;
        font-size: 20px;
        font-weight: 700;
        color: #0f2a4a;
    }

    .ct-step {
        padding: 22px 0 6px;
        border-top: 1px solid #eef1f6;
        margin-top: 18px;
    }

    .ct-step-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

        .ct-step-head h3 {
            margin: 0;
            font-size: 15px;
            font-weight: 600;
            color: #0f2a4a;
        }

    .ct-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: #14406f;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
    }

    .ct-label {
        display: block;
        margin: 12px 0 6px;
        font-size: 12px;
        font-weight: 600;
        color: #4a5a70;
    }

    .ct-input {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid #dbe3ee;
        border-radius: 10px;
        background: #f7f9fc;
        font-family: inherit;
        font-size: 14px;
        color: #0f172a;
    }

        .ct-input:focus {
            outline: 2px solid #1f5fa8;
            background: #fff;
        }

    .ct-hint {
        margin-top: 8px;
        font-size: 12px;
        color: #6b7a90;
    }

        .ct-hint.warn {
            color: #9a6200;
        }

    .ct-lock {
        padding: 16px;
        border-radius: 12px;
        background: #f2f6fb;
        border: 1px dashed #c4d2e4;
        font-size: 13px;
        color: #4a5a70;
    }

    .ct-link {
        margin-top: 10px;
        padding: 0;
        border: 0;
        background: none;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #1a56a0;
        cursor: pointer;
    }

        .ct-link:hover {
            text-decoration: underline;
        }

    .ct-newveh {
        margin-top: 12px;
        padding: 16px;
        border-radius: 14px;
        background: #f2f6fb;
        border: 1px solid #e1e9f3;
    }

    .ct-grid2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .ct-newveh .ct-label {
        margin-top: 0;
    }

    .ct-btn-sm {
        margin-top: 14px;
        padding: 9px 18px;
        border: 0;
        border-radius: 9px;
        background: #14406f;
        color: #fff;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .ct-drop {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 18px;
        border: 1.5px dashed #b7c7dc;
        border-radius: 14px;
        background: #fbfcfe;
        text-align: center;
        font-size: 13px;
        color: #4a5a70;
        cursor: pointer;
    }

        .ct-drop:hover {
            background: #f2f6fb;
            border-color: #1f5fa8;
        }

        .ct-drop svg {
            width: 26px;
            height: 26px;
            fill: none;
            stroke: #1a56a0;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .ct-drop b {
            color: #14406f;
        }

        .ct-drop small {
            color: #8492a6;
            font-size: 11px;
        }

    .ct-file {
        display: none;
    }

    .ct-files {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .ct-file-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 10px;
        background: #f2f6fb;
        font-size: 12px;
        color: #334155;
    }

        .ct-file-row small {
            color: #8492a6;
            margin-left: 8px;
        }

        .ct-file-row button {
            border: 0;
            background: none;
            color: #b42318;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }

    .ct-services {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .ct-service {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 12px 14px;
        border: 1.5px solid #e1e9f3;
        border-radius: 12px;
        background: #fff;
        text-align: left;
        font-family: inherit;
        cursor: pointer;
    }

        .ct-service:hover {
            border-color: #9db8d9;
        }

        .ct-service.sel {
            border-color: #14406f;
            background: #eef4fb;
        }

    .ct-service-name {
        font-size: 13px;
        font-weight: 600;
        color: #0f2a4a;
    }

    .ct-service-meta {
        font-size: 11px;
        color: #6b7a90;
    }

    .ct-agents {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 4px;
    }

    .ct-agent {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1.5px solid #e1e9f3;
        border-radius: 12px;
        background: #fff;
        text-align: left;
        font-family: inherit;
        cursor: pointer;
    }

        .ct-agent:hover:not(:disabled) {
            border-color: #9db8d9;
        }

        .ct-agent.sel {
            border-color: #14406f;
            background: #eef4fb;
        }

        .ct-agent:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .ct-avatar {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg,#14406f,#1f8a5b);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
    }

    .ct-ag-name {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #0f2a4a;
    }

    .ct-ag-role {
        display: block;
        font-size: 11px;
        color: #6b7a90;
    }

    .ct-ag-free {
        display: block;
        margin-top: 2px;
        font-size: 11px;
        font-weight: 600;
        color: #146c43;
    }

        .ct-ag-free.none {
            color: #b42318;
        }

    .ct-tag-esp {
        display: inline-block;
        margin-left: 6px;
        padding: 1px 8px;
        border-radius: 999px;
        background: #e3f5ec;
        color: #146c43;
        font-size: 10px;
        font-weight: 700;
    }

    .ct-slots {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
    }

    .ct-slot {
        padding: 9px 14px;
        border: 1.5px solid #dbe3ee;
        border-radius: 10px;
        background: #fff;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #0f2a4a;
        cursor: pointer;
    }

        .ct-slot:hover:not(:disabled) {
            border-color: #14406f;
        }

        .ct-slot.sel {
            background: #14406f;
            border-color: #14406f;
            color: #fff;
        }

        .ct-slot:disabled {
            background: #f2f4f8;
            color: #aab4c3;
            text-decoration: line-through;
            cursor: not-allowed;
        }

    .ct-est {
        margin-top: 24px;
        padding: 20px;
        border-radius: 16px;
        background: linear-gradient(135deg,#eef4fb,#f1f9f5);
        border: 1px solid #dbe7f3;
    }

    .ct-est-title {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #1a56a0;
        margin-bottom: 12px;
    }

    .ct-est-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

        .ct-est-grid small {
            display: block;
            font-size: 12px;
            color: #6b7a90;
        }

        .ct-est-grid b {
            font-size: 22px;
            color: #0f2a4a;
        }

    .ct-est-note {
        margin-top: 10px;
        font-size: 12px;
        line-height: 1.5;
        color: #4a5a70;
    }

    .ct-error {
        margin-top: 16px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #fdecea;
        color: #b42318;
        font-size: 13px;
    }

    .ct-confirm {
        width: 100%;
        margin-top: 18px;
        padding: 15px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(90deg,#14406f,#1f5fa8);
        color: #fff;
        font-family: inherit;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
    }

        .ct-confirm:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(20,64,111,.3);
        }

        .ct-confirm:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .ct-side {
        position: sticky;
        top: 92px;
    }

    .ct-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 14px;
    }

    .ct-tab {
        padding: 8px 16px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: #6b7a90;
        cursor: pointer;
    }

        .ct-tab.active {
            background: #14406f;
            color: #fff;
        }

        .ct-tab span {
            margin-left: 6px;
            opacity: .8;
        }

    .ct-cita {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 12px;
        padding: 16px;
        background: #fff;
        border: 1px solid #e6ebf2;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(15,42,74,.05);
    }

    .ct-date {
        flex-shrink: 0;
        width: 52px;
        padding: 8px 0;
        border-radius: 12px;
        background: #eef4fb;
        text-align: center;
    }

        .ct-date b {
            display: block;
            font-size: 20px;
            line-height: 1.1;
            color: #14406f;
        }

        .ct-date span {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #6b7a90;
        }

    .ct-info {
        flex: 1;
        min-width: 0;
    }

        .ct-info h4 {
            margin: 0 0 4px;
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
        }

    .ct-sub {
        font-size: 12px;
        line-height: 1.5;
        color: #6b7a90;
        overflow-wrap: anywhere;
    }

    .ct-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
    }

    .ct-status {
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

        .ct-status.aprobada {
            background: #e3f5ec;
            color: #146c43;
        }

        .ct-status.espera {
            background: #fdf1dc;
            color: #9a6200;
        }

        .ct-status.finalizada {
            background: #eceff4;
            color: #5b6778;
        }

        .ct-status.cancelada {
            background: #fdecea;
            color: #b42318;
        }

    .ct-cancel {
        border: 0;
        background: none;
        font-family: inherit;
        font-size: 12px;
        font-weight: 600;
        color: #b42318;
        cursor: pointer;
    }

        .ct-cancel:hover {
            text-decoration: underline;
        }

    .ct-empty {
        padding: 28px;
        border: 1px dashed #c4d2e4;
        border-radius: 16px;
        text-align: center;
        font-size: 13px;
        color: #6b7a90;
    }

    .ct-note {
        margin-top: 16px;
        padding: 14px 16px;
        border-radius: 14px;
        background: #f2f6fb;
        font-size: 12px;
        line-height: 1.6;
        color: #4a5a70;
    }

    .ct-modal-bg {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(10,30,60,.55);
    }

    .ct-modal {
        width: 100%;
        max-width: 440px;
        padding: 32px 30px 28px;
        border-radius: 22px;
        background: #fff;
        text-align: center;
        box-shadow: 0 24px 60px rgba(0,0,0,.35);
    }

    .ct-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        margin-bottom: 14px;
        border-radius: 50%;
        background: #e3f5ec;
    }

        .ct-check svg {
            width: 30px;
            height: 30px;
            fill: none;
            stroke: #146c43;
            stroke-width: 2.4;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .ct-modal h3 {
        margin: 0 0 6px;
        font-size: 21px;
        color: #0f2a4a;
    }

    .ct-modal > p {
        margin: 0 0 18px;
        font-size: 13px;
        line-height: 1.6;
        color: #6b7a90;
    }

    .ct-resumen {
        margin-bottom: 20px;
        padding: 14px 16px;
        border-radius: 14px;
        background: #f2f6fb;
        text-align: left;
    }

        .ct-resumen div {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 4px 0;
            font-size: 13px;
            color: #334155;
        }

        .ct-resumen span {
            color: #6b7a90;
        }

        .ct-resumen b {
            text-align: right;
            color: #0f2a4a;
            overflow-wrap: anywhere;
        }

    @@media (max-width:1000px) {
        .ct-layout {
            grid-template-columns: 1fr;
        }

        .ct-side {
            position: static;
        }
    }

    @@media (max-width:600px) {
        .ct-page {
            padding: 28px 14px 0;
        }

        .ct-card {
            padding: 20px;
        }

        .ct-services, .ct-agents, .ct-grid2 {
            grid-template-columns: 1fr;
        }

        .ct-cita {
            flex-wrap: wrap;
        }

        .ct-right {
            margin-left: auto;
        }
    }
</style>

<div class="ct-page">
    <header class="ct-head">
        <div class="ct-eyebrow">Agenda tu mantenimiento</div>
        <h1>Citas</h1>
        <p>Elige tu vehículo, el servicio, el agente y el horario. Calculamos el costo y el tiempo estimado en tiempo real.</p>
    </header>

    @if (!sesionIniciada)
    {
        <div class="ct-gate">
            <span>Para agendar una cita debes iniciar sesión: así puedes registrar tu vehículo y ver más detalles.</span>
            <span>
                <a href="login">Iniciar sesión</a>
                <a href="registro">Regístrate</a>
            </span>
        </div>
    }

    <div class="ct-layout">
        <section class="ct-card">
            <h2 class="ct-card-title">Nueva cita</h2>

            <div class="ct-step" style="border-top:0; margin-top:10px;">
                <div class="ct-step-head">
                    <span class="ct-num">1</span>
                    <h3>Vehículo</h3>
                </div>

                @if (!sesionIniciada)
                {
                    <div class="ct-lock">Inicia sesión para registrar tu vehículo, cargar sus documentos y ver más detalles.</div>
                }
                else
                {
                    <label class="ct-label">Vehículo</label>

                    @if (cargandoVehiculos)
                    {
                        <div class="ct-lock">Cargando tus vehículos...</div>
                    }
                    else if (errorCargaVehiculos is not null)
                    {
                        <div class="ct-error">
                            @errorCargaVehiculos
                            <button type="button" class="ct-link" @onclick="CargarVehiculosAsync">Reintentar</button>
                        </div>
                    }
                    else if (!vehiculos.Any())
                    {
                        <div class="ct-lock">No tienes vehículos registrados todavía.</div>
                    }
                    else
                    {
                        <select class="ct-input" @bind="vehiculoId">
                            @foreach (var v in vehiculos)
                            {
                                <option value="@v.IdVehiculo">@($"{v.Marca} {v.Modelo} ({v.Anio}) — {v.Placa}")</option>
                            }
                        </select>

                        @if (VehiculoActual is not null)
                        {
                            <div class="ct-hint">
                                Marca: @VehiculoActual.Marca · Modelo: @VehiculoActual.Modelo · Año: @VehiculoActual.Anio · Placa: @VehiculoActual.Placa
                            </div>
                        }
                    }

                    <button type="button" class="ct-link" @onclick="() => mostrarNuevoVehiculo = !mostrarNuevoVehiculo">
                        @(mostrarNuevoVehiculo ? "Cancelar registro" : "+ Registrar otro vehículo")
                    </button>

                    @if (mostrarNuevoVehiculo)
                    {
                        <div class="ct-newveh">
                            <div class="ct-grid2">
                                <div>
                                    <label class="ct-label">Marca</label>
                                    <select class="ct-input" @bind="nvIdMarca" disabled="@cargandoCatalogos">
                                        <option value="0">Selecciona una marca</option>
                                        @foreach (var marca in marcasVehiculo)
                                        {
                                            <option value="@marca.Id">@marca.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="ct-label">Tipo de vehículo</label>
                                    <select class="ct-input" @bind="nvIdTipoVehiculo" disabled="@cargandoCatalogos">
                                        <option value="0">Selecciona un tipo</option>
                                        @foreach (var tipo in tiposVehiculo)
                                        {
                                            <option value="@tipo.Id">@tipo.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="ct-label">Modelo</label>
                                    <input class="ct-input" @bind="nvModelo" maxlength="100" placeholder="Corolla" />
                                </div>
                                <div>
                                    <label class="ct-label">Año</label>
                                    <input class="ct-input" type="number" @bind="nvAnio" placeholder="2020" />
                                </div>
                                <div>
                                    <label class="ct-label">Placa</label>
                                    <input class="ct-input" @bind="nvPlaca" maxlength="20" placeholder="P 000 ABC" />
                                </div>
                                <div>
                                    <label class="ct-label">Color (opcional)</label>
                                    <input class="ct-input" @bind="nvColor" maxlength="50" placeholder="Blanco" />
                                </div>
                                <div>
                                    <label class="ct-label">Kilometraje</label>
                                    <input class="ct-input" type="number" min="0" @bind="nvKilometraje" />
                                </div>
                            </div>

                            @if (errorVehiculo is not null)
                            {
                                <div class="ct-hint warn">@errorVehiculo</div>
                            }
                            @if (cargandoCatalogos)
                            {
                                <div class="ct-hint">Cargando marcas y tipos de vehículo...</div>
                            }

                            <button type="button" class="ct-btn-sm" disabled="@guardandoVehiculo" @onclick="GuardarVehiculoAsync">
                                @(guardandoVehiculo ? "Guardando..." : "Guardar vehículo")
                            </button>
                        </div>
                    }

                    <label class="ct-label">Documentos del vehículo</label>
                    <label class="ct-drop">
                        <InputFile OnChange="OnArchivos" multiple accept=".pdf,.jpg,.jpeg,.png" class="ct-file" />
                        <svg viewBox="0 0 24 24">
                            <path d="M12 16V4M7 9l5-5 5 5" />
                            <path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" />
                        </svg>
                        <span><b>Cargar documentos</b> — seguro, inspección o tarjeta de circulación</span>
                        <small>PDF, JPG o PNG · máx. 5 MB por archivo</small>
                    </label>

                    @if (errorArchivo is not null)
                    {
                        <div class="ct-hint warn">@errorArchivo</div>
                    }

                    @if (archivos.Any())
                    {
                        <div class="ct-files">
                            @foreach (var a in archivos)
                            {
                                <div class="ct-file-row">
                                    <span>@a.Nombre <small>@a.Tamano</small></span>
                                    <button type="button" @onclick="() => archivos.Remove(a)">Quitar</button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <div class="ct-step">
                <div class="ct-step-head">
                    <span class="ct-num">2</span>
                    <h3>Tipo de mantenimiento</h3>
                </div>

                @if (cargandoServicios)
                {
                    <div class="ct-lock">Cargando tipos de servicio...</div>
                }
                else if (errorServicios is not null)
                {
                    <div class="ct-error">
                        @errorServicios
                        <button type="button"
                                class="ct-link"
                                @onclick="CargarServiciosAsync">
                            Reintentar
                        </button>
                    </div>
                }
                else
                {
                    <div class="ct-services">
                        @foreach (var s in servicios)
                        {
                            <button type="button"
                                    class="ct-service @(s.IdTipoServicio == servicioId ? "sel" : "")"
                                    @onclick="() => CambiarServicioAsync(s.IdTipoServicio)">

                                <span class="ct-service-name">@s.Nombre</span>

                                <span class="ct-service-meta">
                                    @($"Q{s.CostoBase.ToString("N2", CultureInfo.GetCultureInfo("es-GT"))}")
                                    · @FormatoMin(s.TiempoEstimadoMinutos)
                                </span>

                                @if (!string.IsNullOrWhiteSpace(s.Descripcion))
                                {
                                    <span class="ct-service-meta">@s.Descripcion</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="ct-step">
                <div class="ct-step-head">
                    <span class="ct-num">3</span>
                    <h3>Fecha, agente y hora</h3>
                </div>

                <label class="ct-label" style="margin-top:0;">Fecha</label>
                <input type="date" class="ct-input" min="@HoyIso" value="@FechaIso" @onchange="OnFecha" />

                <label class="ct-label">Agente (según disponibilidad ese día)</label>
                @if (cargandoAgentes)
                {
                    <div class="ct-lock">Consultando agentes y horarios disponibles...</div>
                }
                else if (errorAgentes is not null)
                {
                    <div class="ct-error">
                        @errorAgentes
                        <button type="button" class="ct-link" @onclick="CargarDisponibilidadAsync">Reintentar</button>
                    </div>
                }
                else
                {
                    <div class="ct-agents">
                        <button type="button"
                                class="ct-agent @(agenteSelId is null ? "sel" : "")"
                                disabled="@(disponibilidadPorHora.Values.All(ids => ids.Count == 0))"
                                @onclick="() => SeleccionarAgente(null)">
                            <span class="ct-avatar">★</span>
                            <span>
                                <span class="ct-ag-name">Cualquiera disponible</span>
                                <span class="ct-ag-role">Asignación automática entre agentes libres</span>
                            </span>
                        </button>

                        @foreach (var a in agentes)
                        {
                            var libres = HorariosLibres(a);
                            <button type="button"
                                    class="ct-agent @(agenteSelId == a.IdAgente ? "sel" : "")"
                                    disabled="@(libres == 0)"
                                    @onclick="() => SeleccionarAgente(a.IdAgente)">
                                <span class="ct-avatar">@a.Iniciales</span>
                                <span>
                                    <span class="ct-ag-name">@a.Nombre</span>
                                    <span class="ct-ag-free @(libres == 0 ? "none" : "")">
                                        @(libres == 0 ? "Sin horarios ese día" : $"{libres} horarios libres")
                                    </span>
                                </span>
                            </button>
                        }
                    </div>
                }

                <label class="ct-label">Hora</label>

                @if (fecha.DayOfWeek == DayOfWeek.Sunday)
                {
                    <div class="ct-hint warn">El taller no atiende los domingos. Elige otra fecha.</div>
                }
                else
                {
                    <div class="ct-slots">
                        @foreach (var h in HorasTaller(fecha))
                        {
                            var libre = HoraDisponible(h);

                            <button type="button"
                                    class="ct-slot @(hora == h ? "sel" : "")"
                                    disabled="@(!libre || cargandoAgentes)"
                                    @onclick="() => SeleccionarHora(h)">
                                @FormatoHora(h)
                            </button>
                        }
                    </div>
                    <div class="ct-hint">Los horarios tachados no tienen agentes disponibles para el tiempo estimado del servicio.</div>
                }
            </div>

            @{
                var est = Estimacion;
            }

            <div class="ct-est">
                <div class="ct-est-title">Estimación en tiempo real</div>
                <div class="ct-est-grid">
                    <div><small>Tiempo estimado</small><b>@est.Tiempo</b></div>
                    <div><small>Costo estimado</small><b>@est.Costo</b></div>
                </div>
                <div class="ct-est-note">@est.Recomendacion</div>
                <div class="ct-est-note">@NotaAgente()</div>
            </div>

            @if (error is not null)
            {
                <div class="ct-error">@error</div>
            }

            <button type="button"
                    class="ct-confirm"
                    disabled="@(!sesionIniciada || guardandoCita)"
                    @onclick="ConfirmarCita">
                @(guardandoCita ? "Registrando cita..." : "Confirmar cita")
            </button>
        </section>

        <aside class="ct-side">
            @if (cargandoCitas)
            {
                <div class="ct-empty">Cargando tus citas...</div>
            }
            else if (errorCarga is not null)
            {
                <div class="ct-error">
                    @errorCarga
                    <button type="button" class="ct-link" @onclick="CargarCitasAsync">Reintentar</button>
                </div>
            }
            else if (!sesionIniciada)
            {
                <div class="ct-empty">Inicia sesión para consultar tus citas.</div>
            }
            else
            {
                <div class="ct-tabs">
                    <button type="button"
                            class="ct-tab @(mostrarProximas ? "active" : "")"
                            @onclick="() => mostrarProximas = true">
                        Próximas<span>@Proximas.Count()</span>
                    </button>
                    <button type="button"
                            class="ct-tab @(!mostrarProximas ? "active" : "")"
                            @onclick="() => mostrarProximas = false">
                        Historial<span>@Historial.Count()</span>
                    </button>
                </div>

                @foreach (var c in CitasVisibles)
                {
                    <div class="ct-cita">
                        <div class="ct-date">
                            <b>@c.FechaCita.Day</b>
                            <span>@Mes(c.FechaCita.ToDateTime(TimeOnly.MinValue))</span>
                        </div>

                        <div class="ct-info">
                            <h4>@c.Servicio</h4>
                            <div class="ct-sub">@c.Marca @c.Modelo — @c.Placa</div>
                            <div class="ct-sub">@FormatoHora(c.HoraInicio) </div>
                            <div class="ct-sub">
                                @($"Q{c.Costo.ToString("N2", CultureInfo.GetCultureInfo("es-GT"))}") · @FormatoMin(c.TiempoEstimadoMinutos)
                            </div>
                        </div>

                        <div class="ct-right">
                            <span class="ct-status @ClaseEstado(c.Estado)">@c.Estado</span>

                            @if (c.Estado == "En espera")
                            {
                                <button type="button" class="ct-cancel" @onclick="() => Cancelar(c)">
                                    Cancelar
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (!CitasVisibles.Any())
                {
                    <div class="ct-empty">
                        No tienes citas @(mostrarProximas ? "próximas" : "en el historial") todavía.
                    </div>
                }
            }

            <div class="ct-note">
                <b>¿Cómo funciona?</b><br />
                Al confirmar, la cita queda <b>En espera</b> y notificamos al agente.
                Cuando la apruebe pasará a <b>Aprobada</b>, y te avisaremos de nuevo al finalizar el trabajo.
            </div>
        </aside>
    </div>
</div>

@if (confirmada is not null)
{
    <div class="ct-modal-bg" @onclick="CerrarConfirmacion">
        <div class="ct-modal" @onclick:stopPropagation="true">
            <div class="ct-check">
                <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            </div>

            <h3>¡Cita registrada!</h3>
            <p>
                Tu solicitud se registró correctamente y aparece en tus citas.
                El agente seleccionado es <b>@(agenteConfirmadoNombre ?? "Por asignar")</b>.
            </p>

            <div class="ct-resumen">
                <div><span>Servicio</span><b>@confirmada.Servicio</b></div>
                <div>
                    <span>Vehículo</span>
                    <b>@confirmada.Marca @confirmada.Modelo — @confirmada.Placa</b>
                </div>
                <div>
                    <span>Fecha</span>
                    <b>@FechaLarga(confirmada.FechaCita.ToDateTime(TimeOnly.MinValue))</b>
                </div>
                <div><span>Hora</span><b>@FormatoHora(confirmada.HoraInicio)</b></div>
                <div><span>Agente</span><b>@(agenteConfirmadoNombre ?? "Por asignar")</b></div>
                <div>
                    <span>Costo aprox.</span>
                    <b>@($"Q{confirmada.Costo.ToString("N2", CultureInfo.GetCultureInfo("es-GT"))}")</b>
                </div>
                <div><span>Tiempo aprox.</span><b>@FormatoMin(confirmada.TiempoEstimadoMinutos)</b></div>
            </div>

            <button type="button" class="ct-confirm" style="margin-top:0;" @onclick="CerrarConfirmacion">
                Entendido
            </button>
        </div>
    </div>
}

@code {
    private bool sesionIniciada;
    private long idCliente;
    private bool cargandoCitas;
    private string? errorCarga;

    [SupplyParameterFromQuery(Name = "servicio")]
    public long? ServicioQuery { get; set; }

    // Modelos auxiliares del formulario
    private record Servicio(
    long IdTipoServicio,
    string Nombre,
    string? Descripcion,
    decimal CostoBase,
    int TiempoEstimadoMinutos);

    private record Estim(string Costo, string Tiempo, string Recomendacion);
    private record ArchivoDto(string Nombre, string Tamano);


    private List<Servicio> servicios = new();

    private bool cargandoServicios;
    private string? errorServicios;

    private List<AgenteDisponibleDto> agentes = new();
    private long? agenteSelId;
    private bool cargandoAgentes;
    private string? errorAgentes;
    private Dictionary<TimeOnly, HashSet<long>> disponibilidadPorHora = new();

    private List<VehiculoClienteDto> vehiculos = new();
    private bool cargandoVehiculos;
    private string? errorCargaVehiculos;

    // Se utiliza directamente el DTO compartido, sin una clase CitaDto adicional.
    private List<CitaClienteDto> citas = new();

    // Estado del formulario
    private long vehiculoId;
    private long servicioId = 1;
    private DateTime fecha = DateTime.Today.AddDays(1);
    private TimeOnly? hora;
    private string? error;
    private CitaClienteDto? confirmada;
    private string? agenteConfirmadoNombre;
    private bool mostrarProximas = true;

    private bool mostrarNuevoVehiculo;
    private List<OpcionCatalogoDto> marcasVehiculo = new();
    private List<OpcionCatalogoDto> tiposVehiculo = new();
    private bool cargandoCatalogos;
    private bool guardandoVehiculo;
    private long nvIdMarca;
    private long nvIdTipoVehiculo;
    private string nvModelo = "";
    private string nvAnio = "";
    private string nvPlaca = "";
    private string nvColor = "";
    private string nvKilometraje = "0";
    private string? errorVehiculo;

    private List<ArchivoDto> archivos = new();
    private string? errorArchivo;

    protected override void OnInitialized()
    {
        if (fecha.DayOfWeek == DayOfWeek.Sunday)
            fecha = fecha.AddDays(1);
    }

    protected override void OnParametersSet()
    {
        if (ServicioQuery is long id &&
            servicios.Any(s => s.IdTipoServicio == id))
        {
            servicioId = id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var idGuardado = await JS.InvokeAsync<string?>(
                "sessionStorage.getItem",
                "flexicar_id_usuario");

            if (long.TryParse(idGuardado, out var id) && id > 0)
            {
                idCliente = id;
                sesionIniciada = true;
                await CargarCatalogosVehiculoAsync();
                await CargarVehiculosAsync();
                await CargarCitasAsync();
                await CargarServiciosAsync();
                await CargarAgentesAsync();
                await CargarDisponibilidadAsync();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                sesionIniciada = false;
                citas.Clear();
            }
        }
        catch (Exception ex)
        {
            sesionIniciada = false;
            errorCarga = "No fue posible verificar la sesión.";
            Console.Error.WriteLine($"Error al leer la sesión: {ex.Message}");
        }

        await CargarAgentesAsync();
        await CargarDisponibilidadAsync();
        await InvokeAsync(StateHasChanged);
    }
    private async Task CargarServiciosAsync()
    {
        cargandoServicios = true;
        errorServicios = null;

        try
        {
            var resultado =
                await Http.GetFromJsonAsync<List<TipoServicioDto>>(
                    "api/Citas/tipos-servicio");

            servicios = (resultado ?? new List<TipoServicioDto>())
                .Select(s => new Servicio(
                    s.IdTipoServicio,
                    s.Nombre,
                    s.Descripcion,
                    s.CostoBase,
                    s.TiempoEstimadoMinutos))
                .ToList();

            if (servicios.Count == 0)
            {
                servicioId = 0;
                errorServicios = "No hay tipos de servicio activos registrados.";
                return;
            }

            if (!servicios.Any(s => s.IdTipoServicio == servicioId))
            {
                servicioId = servicios[0].IdTipoServicio;
            }
        }
        catch (Exception ex)
        {
            servicios.Clear();
            servicioId = 0;
            errorServicios = "No fue posible cargar los servicios desde la API.";

            Console.Error.WriteLine(
                $"Error al cargar los tipos de servicio: {ex}");
        }
        finally
        {
            cargandoServicios = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    // Carga el DTO específico de vehículos directamente desde la API.
    private async Task CargarVehiculosAsync()
    {
        if (idCliente <= 0)
        {
            vehiculos.Clear();
            vehiculoId = 0;
            return;
        }

        cargandoVehiculos = true;
        errorCargaVehiculos = null;

        try
        {
            var resultado = await Http.GetFromJsonAsync<List<VehiculoClienteDto>>(
                $"api/Citas/cliente/{idCliente}/vehiculos");

            vehiculos = resultado ?? new List<VehiculoClienteDto>();

            if (!vehiculos.Any(v => v.IdVehiculo == vehiculoId))
                vehiculoId = vehiculos.FirstOrDefault()?.IdVehiculo ?? 0;
        }
        catch (Exception ex)
        {
            vehiculos.Clear();
            vehiculoId = 0;
            errorCargaVehiculos = "No fue posible cargar tus vehículos. Verifica la conexión con la API.";
            Console.Error.WriteLine($"Error al cargar vehículos: {ex.Message}");
        }
        finally
        {
            cargandoVehiculos = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Carga directamente CitaClienteDto desde la API.
    private async Task CargarCitasAsync()
    {
        if (idCliente <= 0)
        {
            citas.Clear();
            return;
        }

        try
        {
            cargandoCitas = true;
            errorCarga = null;

            await InvokeAsync(StateHasChanged);

            var resultado = await Http.GetFromJsonAsync<List<CitaClienteDto>>(
                $"api/Citas/cliente/{idCliente}");

            citas = resultado ?? new List<CitaClienteDto>();
        }
        catch (Exception ex)
        {
            errorCarga = "No fue posible cargar tus citas. Verifica la conexión con el backend.";
            Console.Error.WriteLine($"Error al cargar citas: {ex.Message}");
        }
        finally
        {
            cargandoCitas = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Propiedades calculadas
    private VehiculoClienteDto? VehiculoActual =>
        vehiculos.FirstOrDefault(v => v.IdVehiculo == vehiculoId);

    private Servicio? ServicioActual =>
    servicios.FirstOrDefault(s => s.IdTipoServicio == servicioId);

    private Estim Estimacion =>
        ServicioActual is { } s
            ? Calcular(s)
            : new Estim("—", "—", "Selecciona un servicio disponible.");

    private string HoyIso => DateTime.Today.ToString("yyyy-MM-dd");
    private string FechaIso => fecha.ToString("yyyy-MM-dd");

    private static bool EstadoEs(string? estado, params string[] estados) =>
    estados.Any(e =>
        string.Equals(
            estado?.Trim(),
            e,
            StringComparison.OrdinalIgnoreCase));

    
    private IEnumerable<CitaClienteDto> Proximas =>
        citas.Where(c => EstadoEs(
                c.Estado,
                "PENDIENTE",
                "APROBADA",
                "EN ESPERA",
                "Aprobada",
                "En espera"))
             .OrderBy(c => c.FechaCita)
             .ThenBy(c => c.HoraInicio);

    private IEnumerable<CitaClienteDto> Historial =>
        citas.Where(c => EstadoEs(
                c.Estado,
                "FINALIZADA",
                "CANCELADA",
                "Finalizada",
                "Cancelada"))
             .OrderByDescending(c => c.FechaCita)
             .ThenByDescending(c => c.HoraInicio);


    private IEnumerable<CitaClienteDto> CitasVisibles =>
        mostrarProximas ? Proximas : Historial;

    // Horarios permitidos por el taller; la disponibilidad de agentes viene de la API.
    private static readonly int[] HorasBase = { 8, 9, 10, 11, 14, 15, 16, 17 };

    private IEnumerable<TimeOnly> HorasTaller(DateTime f)
    {
        if (f.DayOfWeek == DayOfWeek.Sunday)
            return Enumerable.Empty<TimeOnly>();

        var horas = f.DayOfWeek == DayOfWeek.Saturday
            ? HorasBase.Where(h => h < 13)
            : HorasBase;

        return horas.Select(h => new TimeOnly(h, 0));
    }

    private int HorariosLibres(AgenteDisponibleDto agente) =>
        disponibilidadPorHora.Values.Count(ids => ids.Contains(agente.IdAgente));

    private bool HoraDisponible(TimeOnly h)
    {
        if (!disponibilidadPorHora.TryGetValue(h, out var ids))
            return false;

        return agenteSelId.HasValue
            ? ids.Contains(agenteSelId.Value)
            : ids.Count > 0;
    }

    private void SeleccionarAgente(long? idAgente)
    {
        agenteSelId = idAgente;
        if (hora.HasValue && !HoraDisponible(hora.Value))
            hora = null;
    }

    private void SeleccionarHora(TimeOnly h)
    {
        if (HoraDisponible(h))
            hora = h;
    }

    private async Task OnFecha(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var d))
        {
            fecha = d.Date;
            hora = null;
            agenteSelId = null;
            await CargarDisponibilidadAsync();
        }
    }

    private async Task CambiarServicioAsync(long idServicio)
    {
        if (servicioId == idServicio)
            return;

        servicioId = idServicio;
        hora = null;
        agenteSelId = null;

        await CargarDisponibilidadAsync();
    }

    private async Task CargarAgentesAsync()
    {
        try
        {
            errorAgentes = null;
            agentes = await Http.GetFromJsonAsync<List<AgenteDisponibleDto>>("api/Citas/agentes")
                ?? new List<AgenteDisponibleDto>();
        }
        catch (Exception ex)
        {
            errorAgentes = "No fue posible cargar los agentes activos.";
            Console.Error.WriteLine($"Error al cargar agentes: {ex.Message}");
        }
    }

    private async Task CargarDisponibilidadAsync()
    {
        disponibilidadPorHora.Clear();
        hora = null;
        errorAgentes = null;

        if (fecha.Date < DateTime.Today || fecha.DayOfWeek == DayOfWeek.Sunday || servicioId <= 0)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        cargandoAgentes = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (agentes.Count == 0)
                await CargarAgentesAsync();

            foreach (var h in HorasTaller(fecha))
            {
                var fechaQuery = fecha.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                var horaQuery = h.ToString("HH:mm:ss", CultureInfo.InvariantCulture);
                var url = $"api/Citas/agentes/disponibles?fecha={fechaQuery}&horaInicio={horaQuery}&idTipoServicio={servicioId}";
                var disponibles = await Http.GetFromJsonAsync<List<AgenteDisponibleDto>>(url)
                    ?? new List<AgenteDisponibleDto>();
                disponibilidadPorHora[h] = disponibles.Select(a => a.IdAgente).ToHashSet();
            }

            if (agenteSelId.HasValue && !disponibilidadPorHora.Values.Any(ids => ids.Contains(agenteSelId.Value)))
                agenteSelId = null;
        }
        catch (Exception ex)
        {
            errorAgentes = "No fue posible consultar la disponibilidad. Verifica la conexión con la API.";
            Console.Error.WriteLine($"Error al consultar disponibilidad: {ex.Message}");
        }
        finally
        {
            cargandoAgentes = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CargarCatalogosVehiculoAsync()
    {
        cargandoCatalogos = true;
        errorVehiculo = null;

        try
        {
            var marcasTask = Http.GetFromJsonAsync<List<OpcionCatalogoDto>>("api/Citas/marcas");
            var tiposTask = Http.GetFromJsonAsync<List<OpcionCatalogoDto>>("api/Citas/tipos-vehiculo");
            await Task.WhenAll(marcasTask, tiposTask);

            marcasVehiculo = await marcasTask ?? new List<OpcionCatalogoDto>();
            tiposVehiculo = await tiposTask ?? new List<OpcionCatalogoDto>();
        }
        catch (Exception ex)
        {
            errorVehiculo = "No fue posible cargar las marcas y tipos de vehículo. Verifica la conexión con la API.";
            Console.Error.WriteLine($"Error al cargar catálogos de vehículos: {ex.Message}");
        }
        finally
        {
            cargandoCatalogos = false;
        }
    }

    private async Task GuardarVehiculoAsync()
    {
        errorVehiculo = null;

        if (!sesionIniciada || idCliente <= 0)
        {
            errorVehiculo = "Inicia sesión nuevamente para registrar un vehículo.";
            return;
        }

        if (nvIdMarca <= 0 || nvIdTipoVehiculo <= 0)
        {
            errorVehiculo = "Selecciona una marca y un tipo de vehículo.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nvModelo) || nvModelo.Trim().Length > 100)
        {
            errorVehiculo = "Ingresa un modelo válido de hasta 100 caracteres.";
            return;
        }

        if (!int.TryParse(nvAnio, out var anio) || anio < 1886 || anio > DateTime.UtcNow.Year + 1)
        {
            errorVehiculo = $"Ingresa un año válido entre 1886 y {DateTime.UtcNow.Year + 1}.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nvPlaca) || nvPlaca.Trim().Length > 20)
        {
            errorVehiculo = "Ingresa una placa válida de hasta 20 caracteres.";
            return;
        }

        if (!int.TryParse(nvKilometraje, out var kilometraje) || kilometraje < 0)
        {
            errorVehiculo = "El kilometraje no puede ser negativo y debe ser un número válido.";
            return;
        }

        guardandoVehiculo = true;
        try
        {
            var dto = new RegistrarVehiculoDto
            {
                IdCliente = idCliente,
                IdMarca = nvIdMarca,
                IdTipoVehiculo = nvIdTipoVehiculo,
                Modelo = nvModelo.Trim(),
                Anio = anio,
                Placa = nvPlaca.Trim(),
                Color = string.IsNullOrWhiteSpace(nvColor) ? null : nvColor.Trim(),
                Kilometraje = kilometraje
            };

            using var response = await Http.PostAsJsonAsync("api/Citas/vehiculos", dto);
            if (!response.IsSuccessStatusCode)
            {
                var cuerpo = await response.Content.ReadAsStringAsync();
                var mensaje = "No fue posible registrar el vehículo.";
                try
                {
                    using var json = System.Text.Json.JsonDocument.Parse(cuerpo);
                    if (json.RootElement.TryGetProperty("mensaje", out var mensajeJson))
                        mensaje = mensajeJson.GetString() ?? mensaje;
                    else if (json.RootElement.TryGetProperty("title", out var titleJson))
                        mensaje = titleJson.GetString() ?? mensaje;
                }
                catch (System.Text.Json.JsonException)
                {
                    if (!string.IsNullOrWhiteSpace(cuerpo))
                        mensaje = cuerpo;
                }

                errorVehiculo = mensaje;
                return;
            }

            var vehiculoCreado = await response.Content.ReadFromJsonAsync<VehiculoClienteDto>();
            await CargarVehiculosAsync();

            if (vehiculoCreado is not null && vehiculoCreado.IdVehiculo > 0 &&
                vehiculos.Any(v => v.IdVehiculo == vehiculoCreado.IdVehiculo))
            {
                vehiculoId = (int)vehiculoCreado.IdVehiculo;
            }
            else
            {
                var porPlaca = vehiculos.FirstOrDefault(v =>
                    string.Equals(v.Placa, nvPlaca.Trim(), StringComparison.OrdinalIgnoreCase));
                if (porPlaca is not null)
                    vehiculoId = (int)porPlaca.IdVehiculo;
            }

            nvIdMarca = 0;
            nvIdTipoVehiculo = 0;
            nvModelo = string.Empty;
            nvAnio = string.Empty;
            nvPlaca = string.Empty;
            nvColor = string.Empty;
            nvKilometraje = "0";
            mostrarNuevoVehiculo = false;
            errorVehiculo = null;
        }
        catch (Exception ex)
        {
            errorVehiculo = "Ocurrió un error al registrar el vehículo. Verifica la conexión con la API e inténtalo de nuevo.";
            Console.Error.WriteLine($"Error al registrar vehículo: {ex.Message}");
        }
        finally
        {
            guardandoVehiculo = false;
        }
    }

    private void OnArchivos(InputFileChangeEventArgs e)
    {
        errorArchivo = null;

        foreach (var f in e.GetMultipleFiles(10))
        {
            if (f.Size > 5 * 1024 * 1024)
            {
                errorArchivo = $"\"{f.Name}\" supera los 5 MB.";
                continue;
            }

            // Pendiente: enviar el archivo al endpoint de documentos.
            archivos.Add(new ArchivoDto(f.Name, FormatoTamano(f.Size)));
        }
    }

    private bool guardandoCita;

    private async Task ConfirmarCita()
    {
        error = null;

        if (!sesionIniciada || idCliente <= 0)
        {
            error = "Inicia sesión para agendar tu cita.";
            return;
        }

        var vehiculo = VehiculoActual;

        if (vehiculo is null)
        {
            error = "Selecciona o registra un vehículo.";
            return;
        }

        if (fecha.Date < DateTime.Today)
        {
            error = "La fecha de la cita no puede ser anterior a hoy.";
            return;
        }

        if (fecha.DayOfWeek == DayOfWeek.Sunday)
        {
            error = "El taller no atiende los domingos.";
            return;
        }

        if (hora is null)
        {
            error = "Elige un horario disponible.";
            return;
        }

        if (servicioId <= 0)
        {
            error = "Selecciona un servicio válido.";
            return;
        }

        var h = hora.Value;

        if (!HoraDisponible(h))
        {
            error = "Ese horario ya no está disponible. Elige otro.";
            hora = null;
            await CargarDisponibilidadAsync();
            return;
        }

        var agente = agenteSelId.HasValue
            ? agentes.FirstOrDefault(a =>
                a.IdAgente == agenteSelId.Value)
            : agentes.FirstOrDefault(a =>
                disponibilidadPorHora.TryGetValue(h, out var ids)
                && ids.Contains(a.IdAgente));

        if (agente is null || !HoraDisponible(h))
        {
            error = "No hay un agente disponible para ese horario.";
            return;
        }

        if (guardandoCita)
            return;

        guardandoCita = true;

        try
        {
            var dto = new RegistrarCitaDto
            {
                IdCliente = idCliente,
                IdVehiculo = vehiculo.IdVehiculo,
                IdTipoServicio = servicioId,
                IdAgenteSeleccionado = agente.IdAgente,
                FechaCita = DateOnly.FromDateTime(fecha),
                HoraInicio = h,
                Observaciones = null
            };

            using var response =
                await Http.PostAsJsonAsync("api/Citas", dto);

            if (!response.IsSuccessStatusCode)
            {
                var cuerpo = await response.Content.ReadAsStringAsync();
                var mensaje = "No fue posible registrar la cita.";

                try
                {
                    using var json =
                        System.Text.Json.JsonDocument.Parse(cuerpo);

                    if (json.RootElement.TryGetProperty(
                        "mensaje", out var mensajeJson))
                    {
                        mensaje = mensajeJson.GetString() ?? mensaje;
                    }
                    else if (json.RootElement.TryGetProperty(
                        "title", out var titleJson))
                    {
                        mensaje = titleJson.GetString() ?? mensaje;
                    }
                }
                catch (System.Text.Json.JsonException)
                {
                    if (!string.IsNullOrWhiteSpace(cuerpo))
                        mensaje = cuerpo;
                }

                error = mensaje;

                // Actualiza los horarios por si alguien reservó
                // el espacio mientras el usuario completaba el formulario.
                await CargarDisponibilidadAsync();
                return;
            }

            var citaCreada =
                await response.Content.ReadFromJsonAsync<CitaClienteDto>();

            if (citaCreada is null)
            {
                error = "La API aceptó la solicitud, pero no devolvió los datos de la cita.";
                await CargarCitasAsync();
                return;
            }

            // La cita ya se registró en el backend.
            agenteConfirmadoNombre = agente.Nombre;
            confirmada = citaCreada;
            mostrarProximas = true;

            await CargarCitasAsync();
            await CargarDisponibilidadAsync();

            hora = null;
            agenteSelId = null;
            archivos.Clear();
        }
        catch (Exception ex)
        {
            error = "Ocurrió un error al registrar la cita. Verifica la conexión con la API.";
            Console.Error.WriteLine(
                $"Error al registrar cita: {ex}");
        }
        finally
        {
            guardandoCita = false;
        }
    }

    private void CerrarConfirmacion()
    {
        confirmada = null;
        agenteConfirmadoNombre = null;
    }

    // Esta cancelación solo modifica la lista en memoria.
    private void Cancelar(CitaClienteDto c)
    {
        c.Estado = "Cancelada";
    }

    // Cálculo de costo y tiempo basado en el servicio seleccionado.
    private Estim Calcular(Servicio s)
    {
        var costo = $"Q{s.CostoBase.ToString("N2", CultureInfo.GetCultureInfo("es-GT"))}";
        var tiempo = FormatoMin(s.TiempoEstimadoMinutos);

        var recomendacion = s.TiempoEstimadoMinutos <= 60
            ? "Es un trabajo corto: puedes esperar tu vehículo en el taller."
            : "Te recomendamos dejar tu vehículo y recogerlo después.";

        return new Estim(costo, tiempo, recomendacion);
    }

    private string NotaAgente()
    {
        if (agenteSelId is null)
            return "Se asignará uno de los agentes disponibles para el horario elegido.";

        var agente = agentes.FirstOrDefault(a => a.IdAgente == agenteSelId.Value);
        return agente is null ? "Selecciona un agente disponible." : $"Agente seleccionado: {agente.Nombre}.";
    }

    private static int Redondear5(double x) =>
        (int)(Math.Round(x / 5.0, MidpointRounding.AwayFromZero) * 5);

    private static string TextoCosto(int min, int? max, double factor)
    {
        var a = Redondear5(min * factor);

        if (max is null)
            return $"Desde Q{a}";

        var b = Redondear5(max.Value * factor);

        return a == b ? $"Q{a}" : $"Q{a}–Q{b}";
    }

    private static string FormatoMin(int m)
    {
        if (m < 60)
            return $"{m} min";

        return m % 60 == 0
            ? $"{m / 60} h"
            : $"{m / 60} h {m % 60} min";
    }

    private static string TextoTiempo(int? min, int? max, double factor)
    {
        if (min is null || max is null)
            return "Según la pieza";

        var a = Redondear5(min.Value * factor);
        var b = Redondear5(max.Value * factor);

        if (a == b)
            return FormatoMin(a);

        if (b < 60)
            return $"{a}–{b} min";

        return $"{FormatoMin(a)} – {FormatoMin(b)}";
    }

    // Formatos de fecha, hora y archivos
    private static readonly string[] MesesCortos =
        { "ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic" };

    private static readonly string[] MesesLargos =
        { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre" };

    private static readonly string[] DiasSemana =
        { "domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado" };

    private static string Mes(DateTime f) => MesesCortos[f.Month - 1];

    private static string FechaLarga(DateTime f) =>
        $"{DiasSemana[(int)f.DayOfWeek]} {f.Day} de {MesesLargos[f.Month - 1]}";

    private static string FormatoHora(TimeOnly h)
    {
        var h12 = h.Hour % 12 == 0 ? 12 : h.Hour % 12;
        return $"{h12}:{h.Minute:00} {(h.Hour < 12 ? "a. m." : "p. m.")}";
    }

    private static string FormatoTamano(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024.0 / 1024.0:0.0} MB"
            : $"{Math.Max(1, bytes / 1024)} KB";

    private static string ClaseEstado(string estado) => estado switch
    {
        "Aprobada" => "aprobada",
        "En espera" => "espera",
        "Cancelada" => "cancelada",
        _ => "finalizada"
    };
}
